# Maintainer: BigCommunity <contato@biglinux.com.br>

pkgname=biglace
pkgdesc="Mesh VPN client with a graphical interface for Headscale/Tailscale"
depends=(
    'tailscale'
    'gtk4'
    'libadwaita'
    'gettext'
)
makedepends=(
    'rust'
    'cargo'
)
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('x86_64' 'aarch64')
license=('MIT')
url="https://github.com/big-comm/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')

# Automatically detect and use the correct install file
if [ -e "${pkgname}.install" ]; then
    install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
    install=pkgbuild.install
fi

prepare() {
    cd "${srcdir}/${pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked 2>/dev/null || cargo fetch
}

build() {
    cd "${srcdir}/${pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    cargo build --release --locked 2>/dev/null || cargo build --release
}

package() {
    cd "${srcdir}/${pkgname}"

    # Determine the correct source directory
    if [ -d "${pkgname}" ]; then
        srcdir="${srcdir}/${pkgname}/${pkgname}"
    else
        srcdir="${srcdir}/${pkgname}"
    fi

    # Install files (mirrors of /usr, /etc, /opt living in the repo)
    local dirs=("usr" "etc" "opt")
    for dir in "${dirs[@]}"; do
        if [ -d "${srcdir}/${dir}" ]; then
            cp -a "${srcdir}/${dir}" "${pkgdir}/"
        fi
    done

    # Rust binary
    install -Dm755 "${srcdir}/target/release/${pkgname}" \
        "${pkgdir}/usr/bin/${pkgname}"

    # Install license file if present
    if [ -f "${srcdir}/LICENSE" ]; then
        install -Dm644 "${srcdir}/LICENSE" \
            "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi

    # Install documentation if present
    if [ -f "${srcdir}/README.md" ]; then
        install -Dm644 "${srcdir}/README.md" \
            "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    fi
}
