# Maintainer: BigCommunity <contato@biglinux.com.br>

pkgname=biglace
pkgdesc="Mesh VPN client with a graphical interface for Headscale/Tailscale"
depends=(
    'tailscale'
    'openssh'
    'gtk4'
    'libadwaita'
    'gettext'
    'openssl'
    'hicolor-icon-theme'
)
makedepends=(
    'git'
    'rust'
    'cargo'
    'pkgconf'
)
pkgver=1.0.0
pkgrel=1
arch=('x86_64' 'aarch64')
license=('MIT')
url="https://github.com/big-comm/${pkgname}"
source=("git+${url}.git")
sha256sums=('SKIP')
install=pkgbuild.install

prepare() {
    cd "${srcdir}/${pkgname}" || return
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked
}

build() {
    cd "${srcdir}/${pkgname}" || return
    export RUSTUP_TOOLCHAIN=stable
    # --no-default-features disables the bundled jemalloc allocator.
    # Arch's hardened LLD link (with -Wl,--gc-sections -nodefaultlibs -pie)
    # fails to resolve tikv-jemalloc-sys's prefixed `_rjem_*` symbols, so we
    # fall back to glibc's malloc here. The non-allocator optimizations
    # (status cache, diff-based UI refresh, ureq agent reuse) carry most of
    # the RSS savings — jemalloc just smooths long-idle drift.
    cargo build --release --locked --no-default-features
}

package() {
    cd "${srcdir}/${pkgname}" || return
    local source_root="${srcdir}/${pkgname}"

    # Install files (mirrors of /usr, /etc, /opt living in the repo)
    local dirs=("usr" "etc" "opt")
    for dir in "${dirs[@]}"; do
        if [ -d "${source_root}/${dir}" ]; then
            cp -a "${source_root}/${dir}" "${pkgdir}/"
        fi
    done

    # Rust binary
    install -Dm755 "${source_root}/target/release/${pkgname}" \
        "${pkgdir}/usr/bin/${pkgname}"

    # Install license file if present
    if [ -f "${source_root}/LICENSE" ]; then
        install -Dm644 "${source_root}/LICENSE" \
            "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi

    # Install documentation if present
    if [ -f "${source_root}/README.md" ]; then
        install -Dm644 "${source_root}/README.md" \
            "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    fi
}
