    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- links: center → 3 outer nodes -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:pathData="M12,12 L19,12 M12,12 L7,6 M12,12 L7,18" />
    <!-- outer nodes -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M19,12 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0" />
    <path android:fillColor="#FFFFFF"
        android:pathData="M7,6 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0" />
    <path android:fillColor="#FFFFFF"
        android:pathData="M7,18 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0" />
    <!-- center node -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M12,12 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
</vector>
