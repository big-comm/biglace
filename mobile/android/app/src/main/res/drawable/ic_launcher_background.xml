<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the same top-to-bottom blue gradient as the
     official desktop SVG (#3584e4 → #1a5fb4). The rounded-square shape comes
     from the launcher mask, matching the Adwaita look. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="128"
    android:viewportHeight="128">
    <path android:pathData="M0,0h128v128h-128z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="64" android:startY="0"
                android:endX="64" android:endY="128"
                android:startColor="#3584e4"
                android:endColor="#1a5fb4" />
        </aapt:attr>
    </path>
</vector>
