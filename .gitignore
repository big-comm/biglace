# Rust / Cargo
/target/
**/*.rs.bk
*.pdb

# Editor / OS junk
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local logs
*.log

# ── Android / mobile companion app ───────────────────────────────────
# Gradle & build output (regenerated by ./gradlew)
mobile/android/**/build/
mobile/android/.gradle/
mobile/android/.kotlin/
mobile/android/**/.cxx/
mobile/android/captures/
# Machine-specific SDK path — must never be committed
mobile/android/local.properties
# Built APKs are large binaries; publish them via GitHub Releases, not git.
# (dist/README.md stays as the build log; app/libs/tsbridge.aar stays committed
#  so the app builds without the Go/gomobile/NDK toolchain.)
mobile/dist/*.apk
mobile/dist/*.apk.sha256

# ── makepkg output (local package builds) ────────────────────────────
pkgbuild/src/
pkgbuild/pkg/
pkgbuild/*.pkg.tar.*
pkgbuild/*.tar.gz
