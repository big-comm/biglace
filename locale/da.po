msgid "Invalid device address."
msgstr "Ugyldig enhedsadresse."

msgid ""
"No file manager could open the SFTP location. Install one (Dolphin, "
"Nautilus, Nemo, Thunar…) and try again."
msgstr ""
"Ingen filhåndtering kunne åbne SFTP-placeringen. Installer en (Dolphin, "
"Nautilus, Nemo, Thunar…) og prøv igen."

msgid ""
"No file manager could open the SFTP location. Install WinSCP and try again."
msgstr ""
"Ingen filhåndtering kunne åbne SFTP-placeringen. Installer WinSCP og prøv "
"igen."

msgid ""
"No terminal emulator found. Install one (Konsole, GNOME Terminal, xterm…) "
"and try again."
msgstr ""
"Ingen terminalemulator fundet. Installer en (Konsole, GNOME Terminal, "
"xterm…) og prøv igen."

msgid "Failed to run tailscale"
msgstr "Kunne ikke køre tailscale"

msgid "Failed to connect — check the server URL and key."
msgstr "Kunne ikke oprette forbindelse – kontrollér server-URL'en og nøglen."

msgid "Failed to run pkexec tailscale"
msgstr "Kunne ikke køre pkexec tailscale"

msgid "Enter the server URL before connecting."
msgstr "Indtast server-URL'en, før du opretter forbindelse."

msgid ""
"The pre-auth key was rejected by the server. Generate a new key in the "
"BigScale panel and try again."
msgstr ""
"Forhåndsgodkendelsesnøglen blev afvist af serveren. Generér en ny nøgle i "
"BigScale-panelet, og prøv igen."

msgid "Sign in or paste a pre-auth key first."
msgstr "Log ind eller indsæt først en forhåndsgodkendt nøgle."

#, rust-format
msgid "Login rejected by server: {detail}"
msgstr "Login afvist af serveren: {detail}"

msgid "Could not determine the current user."
msgstr "Kunne ikke bestemme den aktuelle bruger."

msgid "Failed to run pkexec tailscale set"
msgstr "Kunne ikke køre pkexec tailscale set"

msgid "Failed to set tailscale operator."
msgstr "Kunne ikke indstille tailscale-operatør."

msgid "Invite someone"
msgstr "Inviter nogen"

msgid "Open admin panel"
msgstr "Åbn administrationspanel"

msgid "Devices"
msgstr "Enheder"

msgid "Chat"
msgstr "Chat"

msgid "Invites"
msgstr "Invitationer"

msgid "Groups"
msgstr "Grupper"

msgid "Rooms"
msgstr "Rum"

msgid "Pictures"
msgstr "Billeder"

msgid "Choose your photo"
msgstr "Vælg dit foto"

msgid "Photo updated. Everyone you're connected to will see it."
msgstr "Foto opdateret. Alle, du er forbundet med, vil se det."

#, rust-format
msgid "Could not change the photo: {error}"
msgstr "Kunne ikke ændre fotoet: {error}"

msgid "Sign in with an access key"
msgstr "Log ind med en adgangsnøgle"

msgid ""
"Paste the key the administrator gave you. It's used once, to register this "
"device."
msgstr ""
"Indsæt nøglen, som administratoren gav dig. Den bruges én gang til at "
"registrere denne enhed."

msgid "Server URL"
msgstr "Server-URL"

msgid "Access key"
msgstr "Adgangsnøgle"

msgid "Device name on the network"
msgstr "Enhedsnavn på netværket"

msgid "Cancel"
msgstr "Annuller"

msgid "Connect"
msgstr "Opret forbindelse"

msgid ""
"The key to this account is no longer on this computer. Join with a new "
"invite."
msgstr ""
"Nøglen til denne konto findes ikke længere på denne computer. Tilslut med en "
"ny invitation."

#, rust-format
msgid "Welcome back, {name}! Connecting…"
msgstr "Velkommen tilbage, {name}! Opretter forbindelse…"

#, rust-format
msgid "Error: {error}"
msgstr "Fejl: {error}"

#, rust-format
msgid ""
"The account {user} no longer exists on this network. Join with a new invite."
msgstr ""
"Kontoen {user} findes ikke længere på dette netværk. Tilslut med en ny "
"invitation."

msgid "Preferences"
msgstr "Indstillinger"

msgid "General"
msgstr "Generelt"

msgid "Behaviour"
msgstr "Opførsel"

msgid "System"
msgstr "System"

msgid "Make this user the tailscale operator"
msgstr "Gør denne bruger til tailscale-operatør"

msgid ""
"Lets BigLace manage the connection without asking for a password each time"
msgstr ""
"Lader BigLace styre forbindelsen uden at spørge om adgangskode hver gang"

msgid "Account"
msgstr "Konto"

msgid ""
"Signing out removes this device's identity from BigLace. You will need a new "
"invite or key to join again."
msgstr ""
"Når du logger ud, fjernes denne enheds identitet fra BigLace. Du skal bruge "
"en ny invitation eller nøgle for at tilslutte dig igen."

msgid "Sign out"
msgstr "Log ud"

msgid "Connect a phone"
msgstr "Forbind en telefon"

msgid "Invites you sent"
msgstr "Invitationer, du har sendt"

msgid "Change profile photo…"
msgstr "Skift profilfoto…"

msgid "Join with an invite"
msgstr "Tilslut med en invitation"

msgid "Sign in with panel account"
msgstr "Log ind med panelkonto"

msgid "Leave the network…"
msgstr "Forlad netværket…"

msgid "View tailscaled logs"
msgstr "Se tailscaled-logfiler"

msgid "About BigLace"
msgstr "Om BigLace"

msgid "Connect to the network first, then open the invite link again."
msgstr ""
"Opret forbindelse til netværket først, og åbn så invitationslinket igen."

#, rust-format
msgid "This invite is for another network ({host}). Sign out first to join it."
msgstr ""
"Denne invitation er til et andet netværk ({host}). Log ud først for at "
"tilslutte dig det."

msgid ""
"This device is already signed in. Sign out first to join with an invite."
msgstr ""
"Denne enhed er allerede logget ind. Log ud først for at tilslutte dig med en "
"invitation."

msgid "Photo removed."
msgstr "Foto fjernet."

#, rust-format
msgid "Could not remove the photo: {error}"
msgstr "Kunne ikke fjerne fotoet: {error}"

#, rust-format
msgid "Could not open the browser: {error}"
msgstr "Kunne ikke åbne browseren: {error}"

msgid ""
"You can't open the admin panel: you're not an administrator of this network, "
"or the panel can't be reached."
msgstr ""
"Du kan ikke åbne administrationspanelet: du er ikke administrator på dette "
"netværk, eller panelet kan ikke nås."

msgid "Enter the server URL before saving."
msgstr "Indtast server-URL'en, før du gemmer."

msgid "Enter the pre-auth key before saving."
msgstr "Indtast den forhåndsgodkendte nøgle, før du gemmer."

msgid "Setup saved"
msgstr "Opsætning gemt"

msgid "Could not start the Tailscale service."
msgstr "Kunne ikke starte Tailscale-tjenesten."

msgid "IP address copied"
msgstr "IP-adresse kopieret"

#, rust-format
msgid ""
"Saved, but the pre-auth key could not be stored in the system keyring "
"({error}). This device can still reconnect; the key is only needed again to "
"register it anew."
msgstr ""
"Gemt, men pre-auth-nøglen kunne ikke gemmes i systemets nøglering ({error}). "
"Denne enhed kan stadig genoprette forbindelsen; nøglen skal kun bruges igen "
"for at registrere den på ny."

msgid "Connected"
msgstr "Forbundet"

msgid "Service stopped"
msgstr "Tjeneste stoppet"

msgid "Not signed in"
msgstr "Ikke logget ind"

msgid "Disconnected"
msgstr "Afbrudt"

msgid "Connecting…"
msgstr "Forbinder…"

msgid "Server unreachable"
msgstr "Server utilgængelig"

msgid "Tailscale can't set DNS"
msgstr "Tailscale kan ikke indstille DNS"

#, rust-format
msgid "Update available: v{version}"
msgstr "Opdatering tilgængelig: v{version}"

#, rust-format
msgid "Sign in again as {user}"
msgstr "Log ind igen som {user}"

msgid "(no device name)"
msgstr "(intet enhedsnavn)"

msgid "Sign in or paste a pre-auth key"
msgstr "Log ind eller indsæt en forhåndsgodkendt nøgle"

msgid "Server not set"
msgstr "Server ikke angivet"

msgid "Disconnect"
msgstr "Afbryd"

msgid "no other devices"
msgstr "ingen andre enheder"

#, rust-format
msgid "{online} online"
msgstr "{online} online"

#, rust-format
msgid "{online} online · {offline} offline"
msgstr "{online} online · {offline} offline"

msgid "is online"
msgstr "er online"

msgid "went offline"
msgstr "gik offline"

#, rust-format
msgid "{count} devices are online"
msgstr "{count} enheder er online"

#, rust-format
msgid "{count} devices went offline"
msgstr "{count} enheder gik offline"

#, rust-format
msgid "{on_count} online · {off_count} offline"
msgstr "{on_count} online · {off_count} offline"

msgid ""
"On the phone, open BigLace and tap “Scan QR code”, then point it at this "
"code. The phone joins as one of your devices."
msgstr ""
"Åbn BigLace på telefonen, tryk på “Scan QR-kode”, og ret den mod denne kode. "
"Telefonen tilsluttes som en af dine enheder."

msgid "Asking the panel for a code…"
msgstr "Beder panelet om en kode…"

msgid "New code"
msgstr "Ny kode"

msgid "This code is no longer valid."
msgstr "Denne kode er ikke længere gyldig."

#, rust-format
msgid "Valid for {time} · works once"
msgstr "Gyldig i {time} · virker én gang"

msgid ""
"This network's server doesn't pair phones yet. Ask your administrator to "
"update the panel, or invite the phone instead."
msgstr ""
"Dette netværks server kan endnu ikke parre telefoner. Bed din administrator "
"om at opdatere panelet, eller inviter telefonen i stedet."

msgid ""
"Invites from BigLace need a BigScale server that supports them. Ask your "
"administrator to update the server, or to create the invite in the panel."
msgstr ""
"Invitationer fra BigLace kræver en BigScale-server, der understøtter dem. "
"Bed din administrator om at opdatere serveren eller om at oprette "
"invitationen i panelet."

msgid "This device can't send invites (it isn't linked to a person's account)."
msgstr ""
"Denne enhed kan ikke sende invitationer (den er ikke knyttet til en persons "
"konto)."

msgid ""
"The panel knows this device by a different key (BigLace was reinstalled?). "
"Leave the network and join again to fix it."
msgstr ""
"Panelet kender denne enhed under en anden nøgle (blev BigLace "
"geninstalleret?). Forlad netværket og tilslut dig igen for at rette det."

msgid ""
"The panel couldn't confirm this device. Make sure BigLace is up to date and "
"stays open while connected, then try again."
msgstr ""
"Panelet kunne ikke bekræfte denne enhed. Sørg for, at BigLace er opdateret "
"og forbliver åben, mens der er forbindelse, og prøv igen."

msgid "You are no longer in that group."
msgstr "Du er ikke længere i den gruppe."

msgid ""
"On this network everyone can reach everyone, so only the administrator can "
"invite people."
msgstr ""
"På dette netværk kan alle nå alle, så kun administratoren kan invitere "
"personer."

msgid "You have too many pending invites. Cancel some or try again tomorrow."
msgstr ""
"Du har for mange ventende invitationer. Annuller nogle, eller prøv igen i "
"morgen."

msgid ""
"On this network only administrators invite new people. You can still invite "
"people already on the network into your groups."
msgstr ""
"På dette netværk er det kun administratorer, der inviterer nye personer. Du "
"kan stadig invitere personer, der allerede er på netværket, ind i dine "
"grupper."

#, rust-format
msgid "Could not reach the panel: {error}"
msgstr "Kunne ikke nå panelet: {error}"

msgid "Waiting to be used"
msgstr "Venter på at blive brugt"

msgid "Used"
msgstr "Brugt"

msgid "Expired"
msgstr "Udløbet"

msgid "Cancelled"
msgstr "Annulleret"

msgid "Waiting for an administrator's approval"
msgstr "Venter på en administrators godkendelse"

msgid "Refresh"
msgstr "Opdater"

msgid "Main menu"
msgstr "Hovedmenu"

msgid "Bring someone to your network"
msgstr "Få nogen med på dit netværk"

msgid ""
"Create a link or QR code and send it to the person. When they join, you two "
"can reach each other's devices — no administrator needed. The link works "
"once and stays valid until it's used or you cancel it."
msgstr ""
"Opret et link eller en QR-kode, og send det til personen. Når de tilslutter "
"sig, kan I to nå hinandens enheder — ingen administrator nødvendig. Linket "
"virker én gang og er gyldigt, indtil det bruges, eller du annullerer det."

msgid "No invites yet"
msgstr "Ingen invitationer endnu"

msgid "Invites unavailable"
msgstr "Invitationer er ikke tilgængelige"

#, rust-format
msgid "{user} joined"
msgstr "{user} tilsluttede sig"

msgid "Invite"
msgstr "Inviter"

#, rust-format
msgid "group {group}"
msgstr "gruppen {group}"

msgid "Cancel this invite: the link stops working"
msgstr "Annuller denne invitation: linket holder op med at virke"

msgid "The person you invite will reach your devices, and you theirs."
msgstr "Personen, du inviterer, kan nå dine enheder, og du deres."

msgid "Who is it for? (optional)"
msgstr "Hvem er den til? (valgfrit)"

msgid "Access"
msgstr "Adgang"

msgid "Just the two of us"
msgstr "Kun os to"

msgid "You see each other's devices, nobody else"
msgstr "I ser hinandens enheder, ingen andre"

#, rust-format
msgid "Also the group {group}"
msgstr "Også gruppen {group}"

msgid "They join the group and see everyone in it"
msgstr "De tilslutter sig gruppen og ser alle i den"

msgid "A network of their own"
msgstr "Et helt eget netværk"

msgid ""
"No link to you: they see only their own devices and whoever they invite "
"(you're the administrator)"
msgstr ""
"Ingen forbindelse til dig: de ser kun deres egne enheder og dem, de "
"inviterer (du er administratoren)"

msgid "Create invite"
msgstr "Opret invitation"

msgid "QR code of the invite link"
msgstr "QR-kode til invitationslinket"

msgid ""
"Send the link or let the person scan the code with their phone. It works "
"once and stays valid until used or cancelled."
msgstr ""
"Send linket, eller lad personen scanne koden med sin telefon. Det virker én "
"gang og er gyldigt, indtil det bruges eller annulleres."

msgid "Copy link"
msgstr "Kopiér link"

msgid "Done"
msgstr "Færdig"

msgid "Copied!"
msgstr "Kopieret!"

msgid ""
"This network asks an administrator to approve each invite: the link starts "
"working once they do. Its status shows in Invites."
msgstr ""
"Dette netværk kræver, at en administrator godkender hver invitation: linket "
"begynder at virke, når de gør det. Status vises under Invitationer."

msgid "Show the full sidebar"
msgstr "Vis hele sidepanelet"

msgid "Show only icons in the sidebar"
msgstr "Kun ikoner i sidepanelet"

msgid "Sections"
msgstr "Sektioner"

msgid ""
"Your identity on this mesh — the device name shown to other peers and the "
"network you're connected to."
msgstr ""
"Din identitet i dette mesh — enhedsnavnet, som vises for andre peers, og "
"netværket du er tilsluttet."

msgid "Change photo…"
msgstr "Skift foto…"

msgid "Remove photo"
msgstr "Fjern foto"

msgid "Change your photo"
msgstr "Skift dit foto"

msgid "Rename this device on the network"
msgstr "Omdøb denne enhed på netværket"

msgid "Advanced: use a pre-auth key"
msgstr "Avanceret: brug en forudgodkendelsesnøgle"

msgid "Already have a key from your administrator? Paste it here."
msgstr "Har du allerede en nøgle fra din administrator? Indsæt den her."

msgid ""
"Manual setup — expand to paste a server URL and pre-auth key when you "
"already received them from your administrator. Most users should sign in "
"through the panel button above instead."
msgstr ""
"Manuel opsætning — udvid for at indsætte en server-URL og en forudgodkendt "
"nøgle, når du allerede har modtaget dem fra din administrator. De fleste "
"brugere bør i stedet logge ind via panelknappen ovenfor."

msgid ""
"Address of the coordination server (e.g. vpn.example.org). The https:// "
"scheme is added automatically if you omit it."
msgstr ""
"Adresse på koordinationsserveren (f.eks. vpn.example.org). Skemaet https:// "
"tilføjes automatisk, hvis du udelader det."

msgid "Pre-auth key"
msgstr "Forudgodkendelsesnøgle"

msgid ""
"One-time or reusable key created on the server (starts with 'hskey-auth-'). "
"Used to register this device automatically without opening a browser."
msgstr ""
"Engangs- eller genbrugelig nøgle oprettet på serveren (starter med 'hskey-"
"auth-'). Bruges til at registrere denne enhed automatisk uden at åbne en "
"browser."

msgid ""
"The name this device shows to other peers on the VPN — this is the Tailscale "
"hostname, NOT your computer's name and NOT your user. Lowercase letters, "
"digits and hyphens. Example: 'tales-laptop', 'francois', 'office-pc'."
msgstr ""
"Navnet som denne enhed viser for andre peers på VPN'et — dette er Tailscale-"
"værtsnavnet, IKKE din computers navn og IKKE din bruger. Små bogstaver, tal "
"og bindestreger. Eksempel: 'tales-laptop', 'francois', 'office-pc'."

msgid "Apply manual setup"
msgstr "Anvend manuel opsætning"

msgid "Save"
msgstr "Gem"

msgid ""
"Persist the server, key and device name above. Won't connect — press Connect "
"afterwards."
msgstr ""
"Gem server, nøgle og enhedsnavn ovenfor. Opretter ikke forbindelse — tryk på "
"Tilslut bagefter."

msgid "Connect automatically"
msgstr "Opret forbindelse automatisk"

msgid "Join the network when BigLace starts"
msgstr "Deltag i netværket, når BigLace starter"

msgid ""
"When on, BigLace runs 'tailscale up' as soon as it launches, so you join the "
"mesh without clicking Connect every time."
msgstr ""
"Når den er slået til, kører BigLace 'tailscale up' så snart den starter, så "
"du tilslutter dig mesh'et uden at klikke på Tilslut hver gang."

msgid "Toggle auto-connect on startup"
msgstr "Slå auto-tilslutning ved opstart til/fra"

msgid "Start BigLace with the session"
msgstr "Start BigLace med sessionen"

msgid "Open BigLace after you sign in to the desktop"
msgstr "Åbn BigLace, efter du er logget ind på skrivebordet"

msgid ""
"Turn this on to add BigLace to your desktop session startup. Turn it off to "
"remove it."
msgstr ""
"Slå dette til for at tilføje BigLace til din skrivebordssessions opstart. "
"Slå det fra for at fjerne det."

msgid "Toggle start with session"
msgstr "Skift start med session"

msgid "Reconnect on drop"
msgstr "Genforbind ved afbrydelse"

msgid "Retry with backoff when the connection is lost"
msgstr "Forsøg igen med backoff, når forbindelsen mistes"

msgid ""
"If the tunnel drops (network change, sleep, server hiccup), BigLace silently "
"retries with growing delays instead of leaving you offline until you notice."
msgstr ""
"Hvis tunnelen afbrydes (netværksændring, dvale, serverfejl), forsøger "
"BigLace stille og roligt igen med stigende forsinkelser i stedet for at "
"efterlade dig offline, indtil du opdager det."

msgid "Toggle auto-reconnect"
msgstr "Slå auto-genforbindelse til/fra"

msgid "Notify on peer changes"
msgstr "Giv besked ved peer-ændringer"

msgid "Show a desktop notification when peers go online/offline"
msgstr "Vis en skrivebordsmeddelelse, når peers går online/offline"

msgid ""
"Send a desktop toast when another device on your network goes online or "
"offline. Rapid bursts are coalesced into a single notification so you don't "
"get spammed during reconnects."
msgstr ""
"Send en desktop-notifikation, når en anden enhed på dit netværk går online "
"eller offline. Hurtige udbrud samles i en enkelt notifikation, så du ikke "
"bliver oversvømmet under genforbindelser."

msgid "Toggle peer-change notifications"
msgstr "Slå notifikationer ved peer-ændringer til/fra"

msgid ""
"Join or leave the mesh network. When connected, this device becomes "
"reachable by the other peers in your account."
msgstr ""
"Deltag eller forlad mesh-netværket. Når du er tilsluttet, bliver denne enhed "
"tilgængelig for de andre peers på din konto."

msgid "Your photo"
msgstr "Dit foto"

msgid "New chat"
msgstr "Ny chat"

msgid "Start a conversation with someone on the network"
msgstr "Start en samtale med nogen på netværket"

msgid "Chat theme"
msgstr "Chattema"

msgid "Conversations"
msgstr "Samtaler"

msgid "No conversations yet."
msgstr "Ingen samtaler endnu."

msgid "Search in this conversation (Ctrl+F)"
msgstr "Søg i denne samtale (Ctrl+F)"

msgid "Pinned message"
msgstr "Fastgjort besked"

msgid "Unpin"
msgstr "Frigør"

msgid "Search messages"
msgstr "Søg i beskeder"

msgid "Older"
msgstr "Ældre"

msgid "Newer"
msgstr "Nyere"

msgid "Emoji"
msgstr "Emoji"

msgid "Send files, pictures or videos"
msgstr "Send filer, billeder eller videoer"

msgid "Send (Enter) — Shift+Enter for a new line"
msgstr "Send (Enter) — Shift+Enter for ny linje"

msgid "Record a voice message"
msgstr "Optag en talebesked"

msgid "Discard"
msgstr "Kassér"

msgid "Send voice message"
msgstr "Send talebesked"

msgid "Copy text"
msgstr "Kopiér tekst"

msgid "Forward"
msgstr "Videresend"

msgid "Delete"
msgstr "Slet"

msgid "Talk with your network"
msgstr "Snak med dit netværk"

msgid ""
"Pick a conversation, or start one. Messages go straight between your "
"computers — the server never sees them."
msgstr ""
"Vælg en samtale, eller start en. Beskeder går direkte mellem jeres computere "
"— serveren ser dem aldrig."

msgid "People on the network"
msgstr "Personer på netværket"

msgid "Group"
msgstr "Gruppe"

msgid "Direct conversation"
msgstr "Direkte samtale"

msgid "That message is too long."
msgstr "Den besked er for lang."

#, rust-format
msgid "Could not send: {error}"
msgstr "Kunne ikke sende: {error}"

#, rust-format
msgid "Could not download: {error}"
msgstr "Kunne ikke hente: {error}"

#, rust-format
msgid "{user} in {group}"
msgstr "{user} i {group}"

msgid "Send files"
msgstr "Send filer"

msgid "Drop to send"
msgstr "Slip for at sende"

#, rust-format
msgid "Could not record: {error}"
msgstr "Kunne ikke optage: {error}"

msgid "Too short — record for at least a second."
msgstr "For kort — optag i mindst et sekund."

msgid "Search people and groups"
msgstr "Søg efter personer og grupper"

msgid "Loading…"
msgstr "Indlæser…"

msgid "Nobody you can reach yet."
msgstr "Ingen, du kan nå, endnu."

msgid "online"
msgstr "online"

msgid "offline"
msgstr "offline"

#, rust-format
msgid "You: {text}"
msgstr "Dig: {text}"

msgid "Group conversation"
msgstr "Gruppesamtale"

#, rust-format
msgid "Delivered to {people}"
msgstr "Leveret til {people}"

msgid "Waiting to be delivered"
msgstr "Venter på levering"

msgid "Today"
msgstr "I dag"

msgid "Yesterday"
msgstr "I går"

msgid "🗑 Message deleted"
msgstr "🗑 Besked slettet"

#, rust-format
msgid "Forwarded from {name}"
msgstr "Videresendt fra {name}"

msgid "edited"
msgstr "redigeret"

msgid "More reactions"
msgstr "Flere reaktioner"

msgid "Reply"
msgstr "Svar"

msgid "Edit"
msgstr "Rediger"

msgid "Pin"
msgstr "Fastgør"

msgid "Select"
msgstr "Vælg"

#, rust-format
msgid "Could not react: {error}"
msgstr "Kunne ikke reagere: {error}"

#, rust-format
msgid "Reply to {name}"
msgstr "Svar til {name}"

msgid "Editing message"
msgstr "Redigerer besked"

msgid "Copied."
msgstr "Kopieret."

msgid "Forward to…"
msgstr "Videresend til…"

msgid "Forwarded."
msgstr "Videresendt."

#, rust-format
msgid "Could not forward: {error}"
msgstr "Kunne ikke videresende: {error}"

msgid "Delete the message?"
msgstr "Slet beskeden?"

#, rust-format
msgid "Delete {count} messages?"
msgstr "Slet {count} beskeder?"

msgid "“For everyone” removes it from the other computers too."
msgstr "“For alle” fjerner den også fra de andre computere."

msgid "It's removed from this computer only."
msgstr "Den fjernes kun fra denne computer."

msgid "Delete for me"
msgstr "Slet for mig"

msgid "Delete for everyone"
msgstr "Slet for alle"

#, rust-format
msgid "Could not delete: {error}"
msgstr "Kunne ikke slette: {error}"

msgid "1 selected"
msgstr "1 valgt"

