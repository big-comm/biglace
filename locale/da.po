#: src/window.rs
msgid "Disconnect"
msgstr "Afbryd"

#: src/window.rs
msgid "Refresh list"
msgstr "Opdater liste"

#: src/window.rs
msgid "Main menu"
msgstr "Hovedmenu"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Log ind med panelkonto"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "Gør denne bruger til tailscale-operatør"

#: src/window.rs
msgid "About BigLace"
msgstr "Om BigLace"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Tailscale-operatør"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr ""
"Færdig. Du vil ikke længere have brug for en adgangskode for at oprette "
"forbindelse eller afbryde."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Mislykkedes: {error}"

#: src/window.rs
msgid "OK"
msgstr "OK"

#: src/window.rs
msgid "Error: {error}"
msgstr "Fejl: {error}"

#: src/window.rs
msgid "Files"
msgstr "Filer"

#: src/window.rs
msgid "Terminal"
msgstr "Terminal"

#: src/window.rs
msgid "Copied!"
msgstr "Kopieret!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Mesh VPN-klient til BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "Panel-legitimationsoplysninger"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Brug dit BigScale panel-brugernavn og din adgangskode til automatisk at "
"generere en nøgle."

#: src/window.rs
msgid "Panel URL"
msgstr "Panel-URL"

#: src/window.rs
msgid "Username"
msgstr "Brugernavn"

#: src/window.rs
msgid "Password"
msgstr "Adgangskode"

#: src/window.rs
msgid "Network user identifier"
msgstr "Netværksbruger-id"

#: src/window.rs
msgid "Cancel"
msgstr "Annuller"

#: src/window.rs
msgid "Sign in"
msgstr "Log ind"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Udfyld URL, brugernavn og adgangskode."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Nøgle genereret med succes."

#: src/window.rs
msgid "Service not found"
msgstr "Tjenesten blev ikke fundet"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"Tjenesten tailscaled kører ikke.\n"
"Klik nedenfor for at starte den."

#: src/window.rs
msgid "Start service"
msgstr "Start tjeneste"

#: src/window.rs
msgid "Server"
msgstr "Server"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "Adresse på din BigScale/Headscale-server."

#: src/window.rs
msgid "Server URL"
msgstr "Server-URL"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Din identitet på netværket"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Personlig nøgle genereret til dig i BigScale-panelet (\"Ny nøgle\" under "
"Brugere). Hver person bruger deres egen – dette er ikke serverens nøgle."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Forudgodkendelsesnøgle (din)"

#: src/window.rs
msgid "This device"
msgstr "Denne enhed"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Navn, der vises for andre enheder på netværket."

#: src/window.rs
msgid "Device name"
msgstr "Enhedsnavn"

#: src/window.rs
msgid "Options"
msgstr "Indstillinger"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Opret forbindelse automatisk ved opstart"

#: src/window.rs
msgid "Connect"
msgstr "Opret forbindelse"

#: src/window.rs
msgid "Please wait..."
msgstr "Vent venligst..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Forbundet til netværket"

#: src/window.rs
msgid "Your IP address"
msgstr "Din IP-adresse"

#: src/window.rs
msgid "Devices on the network"
msgstr "Enheder på netværket"

#: src/window.rs
msgid "No other devices found."
msgstr "Ingen andre enheder fundet."

#: src/window.rs
msgid "Copy"
msgstr "Kopier"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Kunne ikke køre tailscale"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Kunne ikke oprette forbindelse – kontrollér server-URL'en og nøglen."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Kunne ikke køre pkexec tailscale"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Kunne ikke bestemme den aktuelle bruger."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Kunne ikke køre pkexec tailscale set"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Kunne ikke indstille tailscale-operatør."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Forhåndsgodkendelsesnøglen blev afvist af serveren. Generér en ny nøgle i BigScale-panelet, og prøv igen."

msgid "Login rejected by server: {detail}"
msgstr "Login afvist af serveren: {detail}"
