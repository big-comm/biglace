#: src/window.rs
msgid "Disconnect"
msgstr "Eemaldu ühendusest"

#: src/window.rs
msgid "Refresh list"
msgstr "Värskenda loendit"

#: src/window.rs
msgid "Main menu"
msgstr "Peamenüü"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Logi sisse paneeli kontoga"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "Muuda see kasutaja tailscale operaatoriks"

#: src/window.rs
msgid "About BigLace"
msgstr "Teave BigLace kohta"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Tailscale operaator"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr ""
"Valmis. Sul pole enam vaja parooli ühenduse loomiseks või katkestamiseks."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Ebaõnnestus: {error}"

#: src/window.rs
msgid "OK"
msgstr "OK"

#: src/window.rs
msgid "Error: {error}"
msgstr "Viga: {error}"

#: src/window.rs
msgid "Files"
msgstr "Failid"

#: src/window.rs
msgid "Terminal"
msgstr "Terminal"

#: src/window.rs
msgid "Copied!"
msgstr "Kopeeritud!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Mesh VPN klient BigScale/Headscale jaoks."

#: src/window.rs
msgid "Panel credentials"
msgstr "Paneeli sisselogimisandmed"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Kasutage oma BigScale'i paneeli kasutajanime ja parooli, et automaatselt "
"võti genereerida."

#: src/window.rs
msgid "Panel URL"
msgstr "Paneeli URL"

#: src/window.rs
msgid "Username"
msgstr "Kasutajanimi"

#: src/window.rs
msgid "Password"
msgstr "Parool"

#: src/window.rs
msgid "Network user identifier"
msgstr "Võrgukasutaja identifikaator"

#: src/window.rs
msgid "Cancel"
msgstr "Tühista"

#: src/window.rs
msgid "Sign in"
msgstr "Logi sisse"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Sisestage URL, kasutajanimi ja parool."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Võti edukalt genereeritud."

#: src/window.rs
msgid "Service not found"
msgstr "Teenust ei leitud"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"Tailscaled teenus ei tööta.\n"
"Klõpsake allpool selle käivitamiseks."

#: src/window.rs
msgid "Start service"
msgstr "Käivita teenus"

#: src/window.rs
msgid "Server"
msgstr "Server"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "Teie BigScale'i/Headscale'i serveri aadress."

#: src/window.rs
msgid "Server URL"
msgstr "Serveri URL"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Sinu identiteet võrgus"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Isiklik võti, mis on loodud sinu jaoks BigScale'i paneelis (\"Uus võti\" "
"jaotises Kasutajad). Iga inimene kasutab oma võtit – see ei ole serveri "
"võti."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Eelautentimise võti (sinu oma)"

#: src/window.rs
msgid "This device"
msgstr "See seade"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Nimi, mida teised võrgus olevad seadmed näevad."

#: src/window.rs
msgid "Device name"
msgstr "Seadme nimi"

#: src/window.rs
msgid "Options"
msgstr "Valikud"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Ühenda automaatselt käivitamisel"

#: src/window.rs
msgid "Connect"
msgstr "Ühenda"

#: src/window.rs
msgid "Please wait..."
msgstr "Palun oodake..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Võrguga ühendatud"

#: src/window.rs
msgid "Your IP address"
msgstr "Sinu IP-aadress"

#: src/window.rs
msgid "Devices on the network"
msgstr "Seadmed võrgus"

#: src/window.rs
msgid "No other devices found."
msgstr "Muid seadmeid ei leitud."

#: src/window.rs
msgid "Copy"
msgstr "Kopeeri"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Tailscale'i käivitamine ebaõnnestus"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Ühenduse loomine ebaõnnestus – kontrolli serveri URL-i ja võtit."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "pkexec tailscale'i käivitamine ebaõnnestus"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Praegust kasutajat ei õnnestunud tuvastada."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "pkexec tailscale set käivitamine ebaõnnestus"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Tailscale'i operaatori määramine ebaõnnestus."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Server lükkas eelautentimise võtme tagasi. Looge uus võti BigScale'i paneelis ja proovige uuesti."

msgid "Login rejected by server: {detail}"
msgstr "Server lükkas sisselogimise tagasi: {detail}"
