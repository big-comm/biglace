msgid "Invalid device address."
msgstr "Neplatná adresa zariadenia."

msgid ""
"No file manager could open the SFTP location. Install one (Dolphin, "
"Nautilus, Nemo, Thunar…) and try again."
msgstr ""
"Žiadny správca súborov nedokázal otvoriť umiestnenie SFTP. Nainštalujte "
"niektorý (Dolphin, Nautilus, Nemo, Thunar…) a skúste to znova."

msgid ""
"No file manager could open the SFTP location. Install WinSCP and try again."
msgstr ""
"Žiadny správca súborov nedokázal otvoriť umiestnenie SFTP. Nainštalujte "
"WinSCP a skúste to znova."

msgid ""
"No terminal emulator found. Install one (Konsole, GNOME Terminal, xterm…) "
"and try again."
msgstr ""
"Nenašiel sa žiadny emulátor terminálu. Nainštalujte niektorý (Konsole, GNOME "
"Terminal, xterm…) a skúste to znova."

msgid "Failed to run tailscale"
msgstr "Nepodarilo sa spustiť tailscale"

msgid "Failed to connect — check the server URL and key."
msgstr "Nepodarilo sa pripojiť – skontrolujte URL servera a kľúč."

msgid "Failed to run pkexec tailscale"
msgstr "Nepodarilo sa spustiť pkexec tailscale"

msgid "Enter the server URL before connecting."
msgstr "Pred pripojením zadajte URL adresu servera."

msgid ""
"The pre-auth key was rejected by the server. Generate a new key in the "
"BigScale panel and try again."
msgstr ""
"Predautorizačný kľúč bol serverom zamietnutý. Vygenerujte nový kľúč v paneli "
"BigScale a skúste to znova."

msgid "Sign in or paste a pre-auth key first."
msgstr "Najprv sa prihláste alebo vložte pred-autentifikačný kľúč."

#, rust-format
msgid "Login rejected by server: {detail}"
msgstr "Prihlásenie zamietnuté serverom: {detail}"

msgid "Could not determine the current user."
msgstr "Nepodarilo sa určiť aktuálneho používateľa."

msgid "Failed to run pkexec tailscale set"
msgstr "Nepodarilo sa spustiť pkexec tailscale set"

msgid "Failed to set tailscale operator."
msgstr "Nepodarilo sa nastaviť operátora tailscale."

msgid "Invite someone"
msgstr "Pozvať niekoho"

msgid "Open admin panel"
msgstr "Otvoriť panel správcu"

msgid "Devices"
msgstr "Zariadenia"

msgid "Chat"
msgstr "Chat"

msgid "Invites"
msgstr "Pozvánky"

msgid "Groups"
msgstr "Skupiny"

msgid "Rooms"
msgstr "Miestnosti"

msgid "Pictures"
msgstr "Obrázky"

msgid "Choose your photo"
msgstr "Vyberte svoju fotku"

msgid "Photo updated. Everyone you're connected to will see it."
msgstr "Fotka aktualizovaná. Uvidia ju všetci, s ktorými ste prepojení."

#, rust-format
msgid "Could not change the photo: {error}"
msgstr "Fotku sa nepodarilo zmeniť: {error}"

msgid "Sign in with an access key"
msgstr "Prihlásiť sa prístupovým kľúčom"

msgid ""
"Paste the key the administrator gave you. It's used once, to register this "
"device."
msgstr ""
"Vložte kľúč, ktorý vám dal správca. Použije sa raz, na registráciu tohto "
"zariadenia."

msgid "Server URL"
msgstr "URL servera"

msgid "Access key"
msgstr "Prístupový kľúč"

msgid "Device name on the network"
msgstr "Názov zariadenia v sieti"

msgid "Cancel"
msgstr "Zrušiť"

msgid "Connect"
msgstr "Pripojiť"

msgid ""
"The key to this account is no longer on this computer. Join with a new "
"invite."
msgstr ""
"Kľúč k tomuto účtu už na tomto počítači nie je. Pripojte sa s novou "
"pozvánkou."

#, rust-format
msgid "Welcome back, {name}! Connecting…"
msgstr "Vitajte späť, {name}! Pripája sa…"

#, rust-format
msgid "Error: {error}"
msgstr "Chyba: {error}"

#, rust-format
msgid ""
"The account {user} no longer exists on this network. Join with a new invite."
msgstr ""
"Účet {user} už v tejto sieti neexistuje. Pripojte sa s novou pozvánkou."

msgid "Preferences"
msgstr "Predvoľby"

msgid "General"
msgstr "Všeobecné"

msgid "Behaviour"
msgstr "Správanie"

msgid "System"
msgstr "Systém"

msgid "Make this user the tailscale operator"
msgstr "Nastaviť tohto používateľa ako operátora Tailscale"

msgid ""
"Lets BigLace manage the connection without asking for a password each time"
msgstr "Umožní BigLace spravovať pripojenie bez zakaždým zadávaného hesla"

msgid "Account"
msgstr "Účet"

msgid ""
"Signing out removes this device's identity from BigLace. You will need a new "
"invite or key to join again."
msgstr ""
"Odhlásenie odstráni identitu tohto zariadenia z BigLace. Na opätovné "
"pripojenie budete potrebovať novú pozvánku alebo kľúč."

msgid "Sign out"
msgstr "Odhlásiť sa"

msgid "Connect a phone"
msgstr "Pripojiť telefón"

msgid "Invites you sent"
msgstr "Odoslané pozvánky"

msgid "Change profile photo…"
msgstr "Zmeniť profilovú fotku…"

msgid "Join with an invite"
msgstr "Pripojiť sa s pozvánkou"

msgid "Sign in with panel account"
msgstr "Prihlásiť sa pomocou účtu panelu"

msgid "Leave the network…"
msgstr "Opustiť sieť…"

msgid "View tailscaled logs"
msgstr "Zobraziť logy tailscaled"

msgid "About BigLace"
msgstr "O aplikácii BigLace"

msgid "Connect to the network first, then open the invite link again."
msgstr "Najprv sa pripojte k sieti a potom znova otvorte odkaz s pozvánkou."

#, rust-format
msgid "This invite is for another network ({host}). Sign out first to join it."
msgstr ""
"Táto pozvánka je pre inú sieť ({host}). Ak sa k nej chcete pripojiť, najprv "
"sa odhláste."

msgid ""
"This device is already signed in. Sign out first to join with an invite."
msgstr ""
"Toto zariadenie je už prihlásené. Ak sa chcete pripojiť s pozvánkou, najprv "
"sa odhláste."

msgid "Photo removed."
msgstr "Fotka odstránená."

#, rust-format
msgid "Could not remove the photo: {error}"
msgstr "Fotku sa nepodarilo odstrániť: {error}"

#, rust-format
msgid "Could not open the browser: {error}"
msgstr "Nepodarilo sa otvoriť prehliadač: {error}"

msgid ""
"You can't open the admin panel: you're not an administrator of this network, "
"or the panel can't be reached."
msgstr ""
"Panel správcu nemôžete otvoriť: nie ste správcom tejto siete alebo je panel "
"nedostupný."

msgid "Enter the server URL before saving."
msgstr "Pred uložením zadajte URL adresu servera."

msgid "Enter the pre-auth key before saving."
msgstr "Pred uložením zadajte predbežný autentifikačný kľúč."

msgid "Setup saved"
msgstr "Nastavenie uložené"

msgid "Could not start the Tailscale service."
msgstr "Nepodarilo sa spustiť službu Tailscale."

msgid "IP address copied"
msgstr "IP adresa skopírovaná"

#, rust-format
msgid ""
"Saved, but the pre-auth key could not be stored in the system keyring "
"({error}). This device can still reconnect; the key is only needed again to "
"register it anew."
msgstr ""
"Uložené, ale kľúč pre predbežné overenie sa nepodarilo uložiť do systémovej "
"kľúčenky ({error}). Toto zariadenie sa stále môže znova pripojiť; kľúč bude "
"potrebný len pri novej registrácii."

msgid "Connected"
msgstr "Pripojené"

msgid "Service stopped"
msgstr "Služba zastavená"

msgid "Not signed in"
msgstr "Nie ste prihlásený"

msgid "Disconnected"
msgstr "Odpojené"

msgid "Connecting…"
msgstr "Pripája sa…"

msgid "Server unreachable"
msgstr "Server nedostupný"

msgid "Tailscale can't set DNS"
msgstr "Tailscale nemôže nastaviť DNS"

#, rust-format
msgid "Update available: v{version}"
msgstr "K dispozícii aktualizácia: v{version}"

#, rust-format
msgid "Sign in again as {user}"
msgstr "Znova sa prihlásiť ako {user}"

msgid "(no device name)"
msgstr "(bez názvu zariadenia)"

msgid "Sign in or paste a pre-auth key"
msgstr "Prihlásiť sa alebo vložiť pred-autentifikačný kľúč"

msgid "Server not set"
msgstr "Server nie je nastavený"

msgid "Disconnect"
msgstr "Odpojiť"

msgid "no other devices"
msgstr "žiadne ďalšie zariadenia"

#, rust-format
msgid "{online} online"
msgstr "{online} online"

#, rust-format
msgid "{online} online · {offline} offline"
msgstr "{online} online · {offline} offline"

msgid "is online"
msgstr "je online"

msgid "went offline"
msgstr "prešiel do offline režimu"

#, rust-format
msgid "{count} devices are online"
msgstr "{count} zariadení je online"

#, rust-format
msgid "{count} devices went offline"
msgstr "{count} zariadení prešlo do offline režimu"

#, rust-format
msgid "{on_count} online · {off_count} offline"
msgstr "{on_count} online · {off_count} offline"

msgid ""
"On the phone, open BigLace and tap “Scan QR code”, then point it at this "
"code. The phone joins as one of your devices."
msgstr ""
"V telefóne otvorte BigLace a ťuknite na „Skenovať QR kód“, potom ho namierte "
"na tento kód. Telefón sa pripojí ako jedno z vašich zariadení."

msgid "Asking the panel for a code…"
msgstr "Žiadam panel o kód…"

msgid "New code"
msgstr "Nový kód"

msgid "This code is no longer valid."
msgstr "Tento kód už nie je platný."

#, rust-format
msgid "Valid for {time} · works once"
msgstr "Platí {time} · funguje raz"

msgid ""
"This network's server doesn't pair phones yet. Ask your administrator to "
"update the panel, or invite the phone instead."
msgstr ""
"Server tejto siete zatiaľ nevie párovať telefóny. Požiadajte správcu o "
"aktualizáciu panelu alebo telefón namiesto toho pozvite."

msgid ""
"Invites from BigLace need a BigScale server that supports them. Ask your "
"administrator to update the server, or to create the invite in the panel."
msgstr ""
"Pozvánky z BigLace vyžadujú server BigScale, ktorý ich podporuje. Požiadajte "
"správcu o aktualizáciu servera alebo o vytvorenie pozvánky v paneli."

msgid "This device can't send invites (it isn't linked to a person's account)."
msgstr ""
"Toto zariadenie nemôže posielať pozvánky (nie je prepojené s účtom osoby)."

msgid ""
"The panel knows this device by a different key (BigLace was reinstalled?). "
"Leave the network and join again to fix it."
msgstr ""
"Panel pozná toto zariadenie pod iným kľúčom (BigLace bol preinštalovaný?). "
"Opravíte to opustením siete a opätovným pripojením."

msgid ""
"The panel couldn't confirm this device. Make sure BigLace is up to date and "
"stays open while connected, then try again."
msgstr ""
"Panel nedokázal overiť toto zariadenie. Uistite sa, že BigLace je aktuálny a "
"počas pripojenia zostáva otvorený, a skúste to znova."

msgid "You are no longer in that group."
msgstr "Už nie ste v tejto skupine."

msgid ""
"On this network everyone can reach everyone, so only the administrator can "
"invite people."
msgstr ""
"V tejto sieti sa každý dostane ku každému, preto ľudí môže pozývať len "
"správca."

msgid "You have too many pending invites. Cancel some or try again tomorrow."
msgstr ""
"Máte príliš veľa čakajúcich pozvánok. Niektoré zrušte alebo to skúste zajtra."

msgid ""
"On this network only administrators invite new people. You can still invite "
"people already on the network into your groups."
msgstr ""
"V tejto sieti pozývajú nových ľudí len správcovia. Ľudí, ktorí už v sieti "
"sú, však môžete pozvať do svojich skupín."

#, rust-format
msgid "Could not reach the panel: {error}"
msgstr "Panel je nedostupný: {error}"

msgid "Waiting to be used"
msgstr "Čaká na použitie"

msgid "Used"
msgstr "Použitá"

msgid "Expired"
msgstr "Vypršaná"

msgid "Cancelled"
msgstr "Zrušená"

msgid "Waiting for an administrator's approval"
msgstr "Čaká na schválenie správcom"

msgid "Refresh"
msgstr "Obnoviť"

msgid "Main menu"
msgstr "Hlavné menu"

msgid "Bring someone to your network"
msgstr "Priveďte niekoho do svojej siete"

msgid ""
"Create a link or QR code and send it to the person. When they join, you two "
"can reach each other's devices — no administrator needed. The link works "
"once and stays valid until it's used or you cancel it."
msgstr ""
"Vytvorte odkaz alebo QR kód a pošlite ho osobe. Keď sa pripojí, dostanete sa "
"k zariadeniam navzájom — bez správcu. Odkaz funguje raz a platí, kým sa "
"nepoužije alebo ho nezrušíte."

msgid "No invites yet"
msgstr "Zatiaľ žiadne pozvánky"

msgid "Invites unavailable"
msgstr "Pozvánky nie sú k dispozícii"

#, rust-format
msgid "{user} joined"
msgstr "{user} sa pripojil(a)"

msgid "Invite"
msgstr "Pozvať"

#, rust-format
msgid "group {group}"
msgstr "skupina {group}"

msgid "Cancel this invite: the link stops working"
msgstr "Zrušiť túto pozvánku: odkaz prestane fungovať"

msgid "The person you invite will reach your devices, and you theirs."
msgstr "Pozvaná osoba sa dostane k vašim zariadeniam a vy k jej."

msgid "Who is it for? (optional)"
msgstr "Pre koho je? (voliteľné)"

msgid "Access"
msgstr "Prístup"

msgid "Just the two of us"
msgstr "Len my dvaja"

msgid "You see each other's devices, nobody else"
msgstr "Vidíte zariadenia navzájom, nikto iný"

#, rust-format
msgid "Also the group {group}"
msgstr "Aj skupina {group}"

msgid "They join the group and see everyone in it"
msgstr "Pripojí sa ku skupine a uvidí všetkých v nej"

msgid "A network of their own"
msgstr "Vlastná sieť"

msgid ""
"No link to you: they see only their own devices and whoever they invite "
"(you're the administrator)"
msgstr ""
"Bez prepojenia s vami: uvidí len svoje zariadenia a tých, ktorých pozve (vy "
"ste správca)"

msgid "Create invite"
msgstr "Vytvoriť pozvánku"

msgid "QR code of the invite link"
msgstr "QR kód odkazu s pozvánkou"

msgid ""
"Send the link or let the person scan the code with their phone. It works "
"once and stays valid until used or cancelled."
msgstr ""
"Pošlite odkaz alebo nechajte osobu naskenovať kód telefónom. Funguje raz a "
"platí, kým sa nepoužije alebo nezruší."

msgid "Copy link"
msgstr "Kopírovať odkaz"

msgid "Done"
msgstr "Hotovo"

msgid "Copied!"
msgstr "Skopírované!"

msgid ""
"This network asks an administrator to approve each invite: the link starts "
"working once they do. Its status shows in Invites."
msgstr ""
"Táto sieť vyžaduje, aby každú pozvánku schválil správca: odkaz začne "
"fungovať po schválení. Jej stav sa zobrazuje v Pozvánkach."

msgid "Show the full sidebar"
msgstr "Zobraziť celý bočný panel"

msgid "Show only icons in the sidebar"
msgstr "Iba ikony v bočnom paneli"

msgid "Sections"
msgstr "Sekcie"

msgid ""
"Your identity on this mesh — the device name shown to other peers and the "
"network you're connected to."
msgstr ""
"Vaša identita v tejto sieti — názov zariadenia, ktorý sa zobrazuje ostatným "
"peerom, a sieť, ku ktorej ste pripojený."

msgid "Change photo…"
msgstr "Zmeniť fotku…"

msgid "Remove photo"
msgstr "Odstrániť fotku"

msgid "Change your photo"
msgstr "Zmeniť svoju fotku"

msgid "Rename this device on the network"
msgstr "Premenovať toto zariadenie v sieti"

msgid "Advanced: use a pre-auth key"
msgstr "Rozšírené: použiť predautentizačný kľúč"

msgid "Already have a key from your administrator? Paste it here."
msgstr "Už máte kľúč od svojho administrátora? Vložte ho sem."

msgid ""
"Manual setup — expand to paste a server URL and pre-auth key when you "
"already received them from your administrator. Most users should sign in "
"through the panel button above instead."
msgstr ""
"Manuálne nastavenie — rozbaľte pre vloženie URL adresy servera a predbežného "
"kľúča, ak ste ich už dostali od svojho administrátora. Väčšina používateľov "
"by sa mala prihlásiť pomocou tlačidla panela vyššie."

msgid ""
"Address of the coordination server (e.g. vpn.example.org). The https:// "
"scheme is added automatically if you omit it."
msgstr ""
"Adresa koordinačného servera (napr. vpn.example.org). Schéma https:// sa "
"pridá automaticky, ak ju vynecháte."

msgid "Pre-auth key"
msgstr "Pred-autentifikačný kľúč"

msgid ""
"One-time or reusable key created on the server (starts with 'hskey-auth-'). "
"Used to register this device automatically without opening a browser."
msgstr ""
"Jednorazový alebo opakovane použiteľný kľúč vytvorený na serveri (začína na "
"'hskey-auth-'). Používa sa na automatickú registráciu tohto zariadenia bez "
"otvárania prehliadača."

msgid ""
"The name this device shows to other peers on the VPN — this is the Tailscale "
"hostname, NOT your computer's name and NOT your user. Lowercase letters, "
"digits and hyphens. Example: 'tales-laptop', 'francois', 'office-pc'."
msgstr ""
"Názov, pod ktorým sa toto zariadenie zobrazuje ostatným peerom vo VPN — toto "
"je hostname Tailscale, NIE názov vášho počítača a NIE vaše používateľské "
"meno. Malé písmená, číslice a spojovníky. Príklad: 'tales-laptop', "
"'francois', 'office-pc'."

msgid "Apply manual setup"
msgstr "Použiť manuálne nastavenie"

msgid "Save"
msgstr "Uložiť"

msgid ""
"Persist the server, key and device name above. Won't connect — press Connect "
"afterwards."
msgstr ""
"Uložiť server, kľúč a názov zariadenia vyššie. Nespustí pripojenie — po "
"uložení stlačte Pripojiť."

msgid "Connect automatically"
msgstr "Pripojiť automaticky"

msgid "Join the network when BigLace starts"
msgstr "Pripojiť sa k sieti pri spustení BigLace"

msgid ""
"When on, BigLace runs 'tailscale up' as soon as it launches, so you join the "
"mesh without clicking Connect every time."
msgstr ""
"Keď je zapnuté, BigLace spustí 'tailscale up' hneď po svojom štarte, takže "
"sa pripojíte do siete bez toho, aby ste museli zakaždým kliknúť na Pripojiť."

msgid "Toggle auto-connect on startup"
msgstr "Prepnúť automatické pripojenie pri štarte"

msgid "Start BigLace with the session"
msgstr "Spustiť BigLace s reláciou"

msgid "Open BigLace after you sign in to the desktop"
msgstr "Otvoriť BigLace po prihlásení do pracovnej plochy"

msgid ""
"Turn this on to add BigLace to your desktop session startup. Turn it off to "
"remove it."
msgstr ""
"Zapnutím pridáte BigLace do spúšťania relácie pracovnej plochy. Vypnutím ho "
"odstránite."

msgid "Toggle start with session"
msgstr "Prepnúť spustenie s reláciou"

msgid "Reconnect on drop"
msgstr "Znovu pripojiť pri výpadku"

msgid "Retry with backoff when the connection is lost"
msgstr "Opakovať s oneskorením po strate spojenia"

msgid ""
"If the tunnel drops (network change, sleep, server hiccup), BigLace silently "
"retries with growing delays instead of leaving you offline until you notice."
msgstr ""
"Ak tunel spadne (zmena siete, režim spánku, výpadok servera), BigLace ho "
"ticho opakovane skúša s rastúcimi oneskoreniami, namiesto toho, aby vás "
"nechal offline, kým si to nevšimnete."

msgid "Toggle auto-reconnect"
msgstr "Prepnúť automatické opätovné pripojenie"

msgid "Notify on peer changes"
msgstr "Upozorniť na zmeny peerov"

msgid "Show a desktop notification when peers go online/offline"
msgstr "Zobraziť desktopové upozornenie, keď peeri prejdú online/offline"

msgid ""
"Send a desktop toast when another device on your network goes online or "
"offline. Rapid bursts are coalesced into a single notification so you don't "
"get spammed during reconnects."
msgstr ""
"Odoslať desktopové upozornenie, keď iné zariadenie vo vašej sieti prejde "
"online alebo offline. Rýchle výskyty sa zlúčia do jednej notifikácie, aby "
"ste neboli zahltení počas opätovných pripájaní."

msgid "Toggle peer-change notifications"
msgstr "Prepnúť upozornenia na zmeny peerov"

msgid ""
"Join or leave the mesh network. When connected, this device becomes "
"reachable by the other peers in your account."
msgstr ""
"Pripojte sa alebo opustite mesh sieť. Po pripojení bude toto zariadenie "
"dosiahnuteľné pre ostatných peerov vo vašom účte."

msgid "Your photo"
msgstr "Vaša fotka"

msgid "New chat"
msgstr "Nový chat"

msgid "Start a conversation with someone on the network"
msgstr "Začnite konverzáciu s niekým v sieti"

msgid "Chat theme"
msgstr "Motív chatu"

msgid "Conversations"
msgstr "Konverzácie"

msgid "No conversations yet."
msgstr "Zatiaľ žiadne konverzácie."

msgid "Search in this conversation (Ctrl+F)"
msgstr "Hľadať v tejto konverzácii (Ctrl+F)"

msgid "Pinned message"
msgstr "Pripnutá správa"

msgid "Unpin"
msgstr "Odopnúť"

msgid "Search messages"
msgstr "Hľadať správy"

msgid "Older"
msgstr "Staršie"

msgid "Newer"
msgstr "Novšie"

msgid "Emoji"
msgstr "Emoji"

msgid "Send files, pictures or videos"
msgstr "Poslať súbory, obrázky alebo videá"

msgid "Send (Enter) — Shift+Enter for a new line"
msgstr "Odoslať (Enter) — Shift+Enter pre nový riadok"

msgid "Record a voice message"
msgstr "Nahrať hlasovú správu"

msgid "Discard"
msgstr "Zahodiť"

msgid "Send voice message"
msgstr "Odoslať hlasovú správu"

msgid "Copy text"
msgstr "Kopírovať text"

msgid "Forward"
msgstr "Preposlať"

msgid "Delete"
msgstr "Odstrániť"

msgid "Talk with your network"
msgstr "Rozprávajte sa so svojou sieťou"

msgid ""
"Pick a conversation, or start one. Messages go straight between your "
"computers — the server never sees them."
msgstr ""
"Vyberte konverzáciu alebo začnite novú. Správy idú priamo medzi vašimi "
"počítačmi — server ich nikdy nevidí."

msgid "People on the network"
msgstr "Ľudia v sieti"

msgid "Group"
msgstr "Skupina"

msgid "Direct conversation"
msgstr "Priama konverzácia"

msgid "That message is too long."
msgstr "Táto správa je príliš dlhá."

#, rust-format
msgid "Could not send: {error}"
msgstr "Nepodarilo sa odoslať: {error}"

#, rust-format
