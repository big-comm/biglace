msgstr "Rozšírené: použiť predautentizačný kľúč"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/sidebar.rs:81
msgid "Already have a key from your administrator? Paste it here."
msgstr "Už máte kľúč od svojho administrátora? Vložte ho sem."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:68
msgid "Sign out of current account?"
msgstr "Odhlásiť sa z aktuálneho účtu?"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:70
msgid ""
"This will disconnect from the network, sign this device out of the current "
"control server, and forget the saved password. You'll then be able to sign "
"in with a different account."
msgstr ""
"Týmto sa odpojíte od siete, odhlásite toto zariadenie z aktuálneho "
"riadiaceho servera a zabudnete uložené heslo. Potom sa budete môcť prihlásiť"
" s iným účtom."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:76
#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/mod.rs:581
msgid "Sign out"
msgstr "Odhlásiť sa"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:134
msgid "Signed out."
msgstr "Odhlásené."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:153
msgid "Connect via panel account"
msgstr "Pripojiť sa cez účet v paneli"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:166
msgid ""
"Sign in with your BigScale panel username and password. A device identity "
"will be created on the network automatically — no manual key needed."
msgstr ""
"Prihláste sa pomocou používateľského mena a hesla z BigScale panela. "
"Identita zariadenia sa v sieti vytvorí automaticky – nie je potrebný "
"manuálny kľúč."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/peer_row.rs:446
msgid "Copy"
msgstr "Kopírovať"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/sidebar.rs:177
msgid "Reconnect on drop"
msgstr "Znovu pripojiť pri výpadku"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/sidebar.rs:178
msgid "Retry with backoff when the connection is lost"
msgstr "Opakovať s oneskorením po strate spojenia"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/sidebar.rs:197
msgid "Notify on peer changes"
msgstr "Upozorniť na zmeny peerov"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/sidebar.rs:198
msgid "Show a desktop notification when peers go online/offline"
msgstr "Zobraziť desktopové upozornenie, keď peeri prejdú online/offline"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/mod.rs:583
