#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/tailscale.rs:257
#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/tailscale.rs:320
msgid "Failed to connect — check the server URL and key."
msgstr "Nepodarilo sa pripojiť – skontrolujte URL servera a kľúč."

