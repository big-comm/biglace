#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/tailscale.rs:390
msgid "Failed to set tailscale operator."
msgstr "Nepodarilo sa nastaviť operátora tailscale."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/tailscale.rs:313
msgid ""
"The pre-auth key was rejected by the server. Generate a new key in the "
"BigScale panel and try again."
msgstr ""
"Predautorizačný kľúč bol serverom zamietnutý. Vygenerujte nový kľúč v paneli"
" BigScale a skúste to znova."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/tailscale.rs:316
#, rust-format
msgid "Login rejected by server: {detail}"
msgstr "Prihlásenie zamietnuté serverom: {detail}"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/sidebar.rs:86
msgid "Apply manual setup"
msgstr "Použiť manuálne nastavenie"

