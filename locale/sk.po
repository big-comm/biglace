#: src/window.rs
msgid "Disconnect"
msgstr "Odpojiť"

#: src/window.rs
msgid "Refresh list"
msgstr "Obnoviť zoznam"

#: src/window.rs
msgid "Main menu"
msgstr "Hlavné menu"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Prihlásiť sa pomocou účtu panelu"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "Nastaviť tohto používateľa ako operátora Tailscale"

#: src/window.rs
msgid "About BigLace"
msgstr "O aplikácii BigLace"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Operátor Tailscale"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr "Hotovo. Na pripojenie alebo odpojenie už nebudete potrebovať heslo."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Zlyhalo: {error}"

#: src/window.rs
msgid "OK"
msgstr "OK"

#: src/window.rs
msgid "Error: {error}"
msgstr "Chyba: {error}"

#: src/window.rs
msgid "Files"
msgstr "Súbory"

#: src/window.rs
msgid "Terminal"
msgstr "Terminál"

#: src/window.rs
msgid "Copied!"
msgstr "Skopírované!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "VPN klient pre mesh siete BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "Prihlasovacie údaje panela"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Použite svoje používateľské meno a heslo z BigScale panela na automatické "
"vygenerovanie kľúča."

#: src/window.rs
msgid "Panel URL"
msgstr "URL panela"

#: src/window.rs
msgid "Username"
msgstr "Používateľské meno"

#: src/window.rs
msgid "Password"
msgstr "Heslo"

#: src/window.rs
msgid "Network user identifier"
msgstr "Identifikátor sieťového používateľa"

#: src/window.rs
msgid "Cancel"
msgstr "Zrušiť"

#: src/window.rs
msgid "Sign in"
msgstr "Prihlásiť sa"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Vyplňte URL, používateľské meno a heslo."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Kľúč bol úspešne vygenerovaný."

#: src/window.rs
msgid "Service not found"
msgstr "Služba sa nenašla"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"Služba tailscaled nie je spustená.\n"
"Kliknutím nižšie ju spustíte."

#: src/window.rs
msgid "Start service"
msgstr "Spustiť službu"

#: src/window.rs
msgid "Server"
msgstr "Server"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "Adresa vášho BigScale/Headscale servera."

#: src/window.rs
msgid "Server URL"
msgstr "URL servera"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Vaša identita v sieti"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Osobný kľúč vygenerovaný pre vás v paneli BigScale (\"Nový kľúč\" v sekcii "
"Používatelia). Každá osoba používa svoj vlastný – toto nie je kľúč servera."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Pred-autentifikačný kľúč (váš)"

#: src/window.rs
msgid "This device"
msgstr "Toto zariadenie"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Názov zobrazený ostatným zariadeniam v sieti."

#: src/window.rs
msgid "Device name"
msgstr "Názov zariadenia"

#: src/window.rs
msgid "Options"
msgstr "Možnosti"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Automaticky sa pripojiť pri spustení"

#: src/window.rs
msgid "Connect"
msgstr "Pripojiť"

#: src/window.rs
msgid "Please wait..."
msgstr "Čakajte prosím..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Pripojené k sieti"

#: src/window.rs
msgid "Your IP address"
msgstr "Vaša IP adresa"

#: src/window.rs
msgid "Devices on the network"
msgstr "Zariadenia v sieti"

#: src/window.rs
msgid "No other devices found."
msgstr "Neboli nájdené žiadne iné zariadenia."

#: src/window.rs
msgid "Copy"
msgstr "Kopírovať"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Nepodarilo sa spustiť tailscale"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Nepodarilo sa pripojiť – skontrolujte URL servera a kľúč."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Nepodarilo sa spustiť pkexec tailscale"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Nepodarilo sa určiť aktuálneho používateľa."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Nepodarilo sa spustiť pkexec tailscale set"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Nepodarilo sa nastaviť operátora tailscale."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Predautorizačný kľúč bol serverom zamietnutý. Vygenerujte nový kľúč v paneli BigScale a skúste to znova."

msgid "Login rejected by server: {detail}"
msgstr "Prihlásenie zamietnuté serverom: {detail}"
