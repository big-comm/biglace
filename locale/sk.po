msgid "BigLace needs the tailscaled background service to manage the network."
msgstr "BigLace potrebuje službu tailscaled na pozadí na správu siete."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/sidebar.rs:78
msgid "Pre-auth key"
msgstr "Pred-autentifikačný kľúč"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/mod.rs:402
#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/mod.rs:423
msgid "Not signed in"
msgstr "Nie ste prihlásený"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/sidebar.rs:60
msgid "Advanced: use a pre-auth key"
msgstr "Rozšírené: použiť predautentizačný kľúč"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/sidebar.rs:61
msgid "Already have a key from your administrator? Paste it here."
msgstr "Už máte kľúč od svojho administrátora? Vložte ho sem."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:68
msgid "Sign out of current account?"
msgstr "Odhlásiť sa z aktuálneho účtu?"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:70
msgid ""
"This will disconnect from the network, sign this device out of the current "
"control server, and forget the saved password. You'll then be able to sign "
"in with a different account."
msgstr ""
"Týmto sa odpojíte od siete, odhlásite toto zariadenie z aktuálneho "
"riadiaceho servera a zabudnete uložené heslo. Potom sa budete môcť prihlásiť"
" s iným účtom."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:76
#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/mod.rs:115
msgid "Sign out"
msgstr "Odhlásiť sa"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:131
msgid "Signed out."
msgstr "Odhlásené."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:150
msgid "Connect via panel account"
msgstr "Pripojiť sa cez účet v paneli"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:163
msgid ""
"Sign in with your BigScale panel username and password. A device identity "
"will be created on the network automatically — no manual key needed."
msgstr ""
"Prihláste sa pomocou používateľského mena a hesla z BigScale panela. "
"Identita zariadenia sa v sieti vytvorí automaticky – nie je potrebný "
"manuálny kľúč."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:176
msgid "Network identifier (will be created if new)"
msgstr "Identifikátor siete (vytvorí sa, ak neexistuje)"

