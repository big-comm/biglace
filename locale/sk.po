msgstr "Vlastník"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/peer_row.rs:346
msgid "Tags"
msgstr "Značky"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/peer_row.rs:351
