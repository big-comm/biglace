#: src/window.rs
msgid "Disconnect"
msgstr "Bağlantıyı Kes"

#: src/window.rs
msgid "Refresh list"
msgstr "Listeyi Yenile"

#: src/window.rs
msgid "Main menu"
msgstr "Ana Menü"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Panel hesabıyla oturum aç"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "Bu kullanıcıyı tailscale operatörü yap"

#: src/window.rs
msgid "About BigLace"
msgstr "BigLace Hakkında"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Tailscale operatörü"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr ""
"Tamam. Artık bağlanmak veya bağlantıyı kesmek için bir parolaya ihtiyacınız "
"olmayacak."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Başarısız: {error}"

#: src/window.rs
msgid "OK"
msgstr "Tamam"

#: src/window.rs
msgid "Error: {error}"
msgstr "Hata: {error}"

#: src/window.rs
msgid "Files"
msgstr "Dosyalar"

#: src/window.rs
msgid "Terminal"
msgstr "Terminal"

#: src/window.rs
msgid "Copied!"
msgstr "Kopyalandı!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "BigScale/Headscale için Mesh VPN istemcisi."

#: src/window.rs
msgid "Panel credentials"
msgstr "Panel kimlik bilgileri"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Anahtarı otomatik oluşturmak için BigScale panel kullanıcı adınızı ve "
"şifrenizi kullanın."

#: src/window.rs
msgid "Panel URL"
msgstr "Panel URL'si"

#: src/window.rs
msgid "Username"
msgstr "Kullanıcı adı"

#: src/window.rs
msgid "Password"
msgstr "Şifre"

#: src/window.rs
msgid "Network user identifier"
msgstr "Ağ kullanıcı tanımlayıcısı"

#: src/window.rs
msgid "Cancel"
msgstr "İptal"

#: src/window.rs
msgid "Sign in"
msgstr "Oturum aç"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "URL, kullanıcı adı ve şifreyi doldurun."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Anahtar başarıyla oluşturuldu."

#: src/window.rs
msgid "Service not found"
msgstr "Hizmet bulunamadı"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"tailscaled hizmeti çalışmıyor.\n"
"Başlatmak için aşağıya tıklayın."

#: src/window.rs
msgid "Start service"
msgstr "Hizmeti başlat"

#: src/window.rs
msgid "Server"
msgstr "Sunucu"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "BigScale/Headscale sunucunuzun adresi."

#: src/window.rs
msgid "Server URL"
msgstr "Sunucu URL'si"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Ağdaki kimliğiniz"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"BigScale panelinde sizin için oluşturulan kişisel anahtar (Kullanıcılar "
"bölümünde \"Yeni anahtar\"). Herkes kendi anahtarını kullanır — bu sunucunun"
" anahtarı değildir."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Ön yetkilendirme anahtarı (size ait)"

#: src/window.rs
msgid "This device"
msgstr "Bu cihaz"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Ağdaki diğer cihazlara gösterilen ad."

#: src/window.rs
msgid "Device name"
msgstr "Cihaz adı"

#: src/window.rs
msgid "Options"
msgstr "Seçenekler"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Başlangıçta otomatik bağlan"

#: src/window.rs
msgid "Connect"
msgstr "Bağlan"

#: src/window.rs
msgid "Please wait..."
msgstr "Lütfen bekleyin..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Ağa bağlandı"

#: src/window.rs
msgid "Your IP address"
msgstr "IP adresiniz"

#: src/window.rs
msgid "Devices on the network"
msgstr "Ağdaki cihazlar"

#: src/window.rs
msgid "No other devices found."
msgstr "Başka cihaz bulunamadı."

#: src/window.rs
msgid "Copy"
msgstr "Kopyala"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Tailscale çalıştırılamadı"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Bağlantı kurulamadı — sunucu URL'sini ve anahtarı kontrol edin."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "pkexec tailscale çalıştırılamadı"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Geçerli kullanıcı belirlenemedi."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "pkexec tailscale set çalıştırılamadı"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Tailscale operatörü ayarlanamadı."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Ön kimlik doğrulama anahtarı sunucu tarafından reddedildi. BigScale panelinde yeni bir anahtar oluşturun ve yeniden deneyin."

msgid "Login rejected by server: {detail}"
msgstr "Sunucu girişi reddetti: {detail}"
