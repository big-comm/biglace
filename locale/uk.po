msgstr "Це запрошення лише для нових людей у мережі, а ви вже в ній."

msgid "This invite was already used. Ask for a new one."
msgstr "Це запрошення вже використано. Попросіть нове."

msgid "This invite expired. Ask for a new one."
msgstr "Термін дії запрошення минув. Попросіть нове."

msgid "This invite is no longer valid. Ask for a new one."
msgstr "Це запрошення більше не дійсне. Попросіть нове."

msgid "This invite is still waiting for an administrator's approval."
msgstr "Це запрошення ще очікує схвалення адміністратора."

msgid "Too many attempts. Wait a minute and try again."
msgstr "Забагато спроб. Зачекайте хвилину і спробуйте ще раз."

