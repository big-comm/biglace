#: src/window.rs
msgid "Disconnect"
msgstr "Відключитися"

#: src/window.rs
msgid "Refresh list"
msgstr "Оновити список"

#: src/window.rs
msgid "Main menu"
msgstr "Головне меню"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Увійти через обліковий запис панелі"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "Зробити цього користувача оператором Tailscale"

#: src/window.rs
msgid "About BigLace"
msgstr "Про BigLace"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Оператор Tailscale"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr "Готово. Тепер вам не потрібен пароль для підключення або відключення."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Помилка: {error}"

#: src/window.rs
msgid "OK"
msgstr "OK"

#: src/window.rs
msgid "Error: {error}"
msgstr "Помилка: {error}"

#: src/window.rs
msgid "Files"
msgstr "Файли"

#: src/window.rs
msgid "Terminal"
msgstr "Термінал"

#: src/window.rs
msgid "Copied!"
msgstr "Скопійовано!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Mesh VPN-клієнт для BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "Облікові дані панелі"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Використовуйте ім'я користувача та пароль панелі BigScale для автоматичної "
"генерації ключа."

#: src/window.rs
msgid "Panel URL"
msgstr "URL панелі"

#: src/window.rs
msgid "Username"
msgstr "Ім'я користувача"

#: src/window.rs
msgid "Password"
msgstr "Пароль"

#: src/window.rs
msgid "Network user identifier"
msgstr "Ідентифікатор користувача мережі"

#: src/window.rs
msgid "Cancel"
msgstr "Скасувати"

#: src/window.rs
msgid "Sign in"
msgstr "Увійти"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Заповніть URL, ім'я користувача та пароль."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Ключ успішно згенеровано."

#: src/window.rs
msgid "Service not found"
msgstr "Службу не знайдено"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"Служба tailscaled не запущена.\n"
"Натисніть нижче, щоб запустити її."

#: src/window.rs
msgid "Start service"
msgstr "Запустити службу"

#: src/window.rs
msgid "Server"
msgstr "Сервер"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "Адреса вашого сервера BigScale/Headscale."

#: src/window.rs
msgid "Server URL"
msgstr "URL сервера"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Ваша ідентичність у мережі"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Особистий ключ, створений для вас у панелі BigScale (\"Новий ключ\" у "
"розділі Користувачі). Кожен використовує власний ключ — це не ключ сервера."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Попередньо авторизований ключ (ваш)"

#: src/window.rs
msgid "This device"
msgstr "Цей пристрій"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Назва, яку бачать інші пристрої в мережі."

#: src/window.rs
msgid "Device name"
msgstr "Назва пристрою"

#: src/window.rs
msgid "Options"
msgstr "Параметри"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Підключатися автоматично під час запуску"

#: src/window.rs
msgid "Connect"
msgstr "Підключитися"

#: src/window.rs
msgid "Please wait..."
msgstr "Зачекайте, будь ласка..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Підключено до мережі"

#: src/window.rs
msgid "Your IP address"
msgstr "Ваша IP-адреса"

#: src/window.rs
msgid "Devices on the network"
msgstr "Пристрої в мережі"

#: src/window.rs
msgid "No other devices found."
msgstr "Інших пристроїв не знайдено."

#: src/window.rs
msgid "Copy"
msgstr "Копіювати"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Не вдалося запустити tailscale"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Не вдалося підключитися — перевірте URL сервера та ключ."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Не вдалося запустити pkexec tailscale"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Не вдалося визначити поточного користувача."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Не вдалося запустити pkexec tailscale set"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Не вдалося встановити оператора tailscale."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Сервер відхилив ключ попередньої автентифікації. Створіть новий ключ у панелі BigScale і спробуйте знову."

msgid "Login rejected by server: {detail}"
msgstr "Сервер відхилив вхід: {detail}"
