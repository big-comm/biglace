#: src/window.rs
msgid "Disconnect"
msgstr "Odpojit"

#: src/window.rs
msgid "Refresh list"
msgstr "Obnovit seznam"

#: src/window.rs
msgid "Main menu"
msgstr "Hlavní nabídka"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Přihlásit se pomocí účtu panelu"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "Nastavit tohoto uživatele jako operátora Tailscale"

#: src/window.rs
msgid "About BigLace"
msgstr "O aplikaci BigLace"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Operátor Tailscale"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr "Hotovo. Pro připojení nebo odpojení již nebudete potřebovat heslo."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Selhalo: {error}"

#: src/window.rs
msgid "OK"
msgstr "OK"

#: src/window.rs
msgid "Error: {error}"
msgstr "Chyba: {error}"

#: src/window.rs
msgid "Files"
msgstr "Soubory"

#: src/window.rs
msgid "Terminal"
msgstr "Terminál"

#: src/window.rs
msgid "Copied!"
msgstr "Zkopírováno!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "VPN klient pro síť Mesh pro BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "Přihlašovací údaje k panelu"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Použijte své uživatelské jméno a heslo z panelu BigScale k automatickému "
"vygenerování klíče."

#: src/window.rs
msgid "Panel URL"
msgstr "URL panelu"

#: src/window.rs
msgid "Username"
msgstr "Uživatelské jméno"

#: src/window.rs
msgid "Password"
msgstr "Heslo"

#: src/window.rs
msgid "Network user identifier"
msgstr "Identifikátor uživatele v síti"

#: src/window.rs
msgid "Cancel"
msgstr "Zrušit"

#: src/window.rs
msgid "Sign in"
msgstr "Přihlásit se"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Vyplňte URL, uživatelské jméno a heslo."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Klíč byl úspěšně vygenerován."

#: src/window.rs
msgid "Service not found"
msgstr "Služba nenalezena"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"Služba tailscaled není spuštěna.\n"
"Kliknutím níže ji spustíte."

#: src/window.rs
msgid "Start service"
msgstr "Spustit službu"

#: src/window.rs
msgid "Server"
msgstr "Server"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "Adresa vašeho serveru BigScale/Headscale."

#: src/window.rs
msgid "Server URL"
msgstr "URL serveru"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Vaše identita v síti"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Osobní klíč vygenerovaný pro vás v panelu BigScale (\"Nový klíč\" v "
"Uživatelích). Každý používá svůj vlastní – nejedná se o klíč serveru."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Před-autentizační klíč (váš)"

#: src/window.rs
msgid "This device"
msgstr "Toto zařízení"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Název zobrazený ostatním zařízením v síti."

#: src/window.rs
msgid "Device name"
msgstr "Název zařízení"

#: src/window.rs
msgid "Options"
msgstr "Možnosti"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Připojit automaticky při spuštění"

#: src/window.rs
msgid "Connect"
msgstr "Připojit"

#: src/window.rs
msgid "Please wait..."
msgstr "Prosím čekejte..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Připojeno k síti"

#: src/window.rs
msgid "Your IP address"
msgstr "Vaše IP adresa"

#: src/window.rs
msgid "Devices on the network"
msgstr "Zařízení v síti"

#: src/window.rs
msgid "No other devices found."
msgstr "Nebyla nalezena žádná další zařízení."

#: src/window.rs
msgid "Copy"
msgstr "Kopírovat"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Nepodařilo se spustit tailscale"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Nepodařilo se připojit – zkontrolujte adresu serveru a klíč."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Nepodařilo se spustit pkexec tailscale"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Nepodařilo se určit aktuálního uživatele."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Nepodařilo se spustit pkexec tailscale set"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Nepodařilo se nastavit operátora tailscale."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Předautorizační klíč byl serverem zamítnut. Vygenerujte nový klíč v panelu BigScale a zkuste to znovu."

msgid "Login rejected by server: {detail}"
msgstr "Přihlášení zamítnuto serverem: {detail}"
