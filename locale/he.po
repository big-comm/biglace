#: src/window.rs
msgid "Disconnect"
msgstr "ניתוק"

#: src/window.rs
msgid "Refresh list"
msgstr "רענן רשימה"

#: src/window.rs
msgid "Main menu"
msgstr "תפריט ראשי"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "התחבר עם חשבון פאנל"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "הפוך משתמש זה למפעיל tailscale"

#: src/window.rs
msgid "About BigLace"
msgstr "אודות BigLace"

#: src/window.rs
msgid "Tailscale operator"
msgstr "מפעיל Tailscale"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr "בוצע. לא תזדקק עוד לסיסמה כדי להתחבר או להתנתק."

#: src/window.rs
msgid "Failed: {error}"
msgstr "נכשל: {error}"

#: src/window.rs
msgid "OK"
msgstr "אישור"

#: src/window.rs
msgid "Error: {error}"
msgstr "שגיאה: {error}"

#: src/window.rs
msgid "Files"
msgstr "קבצים"

#: src/window.rs
msgid "Terminal"
msgstr "מסוף"

#: src/window.rs
msgid "Copied!"
msgstr "הועתק!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "לקוח רשת VPN מבוזרת עבור BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "פרטי כניסה לפאנל"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"השתמש בשם המשתמש והסיסמה שלך בפאנל BigScale כדי ליצור מפתח באופן אוטומטי."

#: src/window.rs
msgid "Panel URL"
msgstr "כתובת הפאנל"

#: src/window.rs
msgid "Username"
msgstr "שם משתמש"

#: src/window.rs
msgid "Password"
msgstr "סיסמה"

#: src/window.rs
msgid "Network user identifier"
msgstr "מזהה משתמש ברשת"

#: src/window.rs
msgid "Cancel"
msgstr "ביטול"

#: src/window.rs
msgid "Sign in"
msgstr "כניסה"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "מלא כתובת URL, שם משתמש וסיסמה."

#: src/window.rs
msgid "Key generated successfully."
msgstr "המפתח נוצר בהצלחה."

#: src/window.rs
msgid "Service not found"
msgstr "השירות לא נמצא"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"שירות tailscaled אינו פועל.\n"
"לחץ למטה כדי להפעיל אותו."

#: src/window.rs
msgid "Start service"
msgstr "הפעל שירות"

#: src/window.rs
msgid "Server"
msgstr "שרת"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "כתובת שרת BigScale/Headscale שלך."

#: src/window.rs
msgid "Server URL"
msgstr "כתובת השרת"

#: src/window.rs
msgid "Your identity on the network"
msgstr "הזהות שלך ברשת"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"מפתח אישי שנוצר עבורך בלוח הבקרה של BigScale (\"מפתח חדש\" במשתמשים). כל אדם"
" משתמש במפתח משלו – זהו לא מפתח השרת."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "מפתח הרשאה מראש (שלך)"

#: src/window.rs
msgid "This device"
msgstr "מכשיר זה"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "השם שיוצג למכשירים אחרים ברשת."

#: src/window.rs
msgid "Device name"
msgstr "שם המכשיר"

#: src/window.rs
msgid "Options"
msgstr "אפשרויות"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "התחבר אוטומטית בעת ההפעלה"

#: src/window.rs
msgid "Connect"
msgstr "התחבר"

#: src/window.rs
msgid "Please wait..."
msgstr "אנא המתן..."

#: src/window.rs
msgid "Connected to the network"
msgstr "מחובר לרשת"

#: src/window.rs
msgid "Your IP address"
msgstr "כתובת ה-IP שלך"

#: src/window.rs
msgid "Devices on the network"
msgstr "מכשירים ברשת"

#: src/window.rs
msgid "No other devices found."
msgstr "לא נמצאו מכשירים אחרים."

#: src/window.rs
msgid "Copy"
msgstr "העתק"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "הפעלת tailscale נכשלה"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "ההתחברות נכשלה — בדוק את כתובת השרת והמפתח."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "הפעלת pkexec tailscale נכשלה"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "לא ניתן לקבוע את המשתמש הנוכחי."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "הפעלת pkexec tailscale set נכשלה"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "הגדרת מפעיל tailscale נכשלה."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "מפתח האימות המקדים נדחה על ידי השרת. צור מפתח חדש בלוח BigScale ונסה שוב."

msgid "Login rejected by server: {detail}"
msgstr "ההתחברות נדחתה על ידי השרת: {detail}"
