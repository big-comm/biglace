msgstr "Kopiert!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Mesh-VPN-Client für BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "Panel-Anmeldedaten"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Verwenden Sie Ihren BigScale-Panel-Benutzernamen und Ihr Passwort, um "
"automatisch einen Schlüssel zu generieren."

#: src/window.rs
msgid "Panel URL"
msgstr "Panel-URL"

#: src/window.rs
msgid "Username"
msgstr "Benutzername"

#: src/window.rs
msgid "Password"
msgstr "Passwort"

#: src/window.rs
msgid "Network user identifier"
msgstr "Netzwerk-Benutzerkennung"

#: src/window.rs
msgid "Cancel"
msgstr "Abbrechen"

