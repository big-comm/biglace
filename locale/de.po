msgid "About BigLace"
msgstr "Über BigLace"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Tailscale-Operator"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr ""
"Erledigt. Sie benötigen kein Passwort mehr zum Verbinden oder Trennen."

#: src/window.rs
