#: src/window.rs
msgid "Device name"
msgstr "Gerätename"

#: src/window.rs
msgid "Options"
msgstr "Optionen"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Automatisch beim Start verbinden"

#: src/window.rs
msgid "Connect"
msgstr "Verbinden"

#: src/window.rs
msgid "Please wait..."
msgstr "Bitte warten..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Mit dem Netzwerk verbunden"

#: src/window.rs
msgid "Your IP address"
msgstr "Ihre IP-Adresse"

#: src/window.rs
msgid "Devices on the network"
msgstr "Geräte im Netzwerk"

#: src/window.rs
msgid "No other devices found."
msgstr "Keine anderen Geräte gefunden."

#: src/window.rs
msgid "Copy"
msgstr "Kopieren"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Fehler beim Ausführen von Tailscale"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Verbindung fehlgeschlagen – Server-URL und Schlüssel überprüfen."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Fehler beim Ausführen von pkexec tailscale"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Der aktuelle Benutzer konnte nicht ermittelt werden."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Fehler beim Ausführen von pkexec tailscale set"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Fehler beim Festlegen des Tailscale-Operators."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Der Pre-Auth-Schlüssel wurde vom Server abgelehnt. Erzeugen Sie einen neuen Schlüssel im BigScale-Panel und versuchen Sie es erneut."

msgid "Login rejected by server: {detail}"
msgstr "Anmeldung vom Server abgelehnt: {detail}"
