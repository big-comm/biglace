msgid "Terminal"
msgstr "Terminal"

#: src/window.rs
msgid "Copied!"
msgstr "Gekopieerd!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Mesh VPN-client voor BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "Panelgegevens"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Gebruik uw BigScale-panelgebruikersnaam en wachtwoord om automatisch een "
"sleutel te genereren."

#: src/window.rs
msgid "Panel URL"
msgstr "Panel-URL"

#: src/window.rs
msgid "Username"
msgstr "Gebruikersnaam"

#: src/window.rs
msgid "Password"
msgstr "Wachtwoord"

#: src/window.rs
msgid "Network user identifier"
msgstr "Netwerkgebruikers-ID"

#: src/window.rs
msgid "Cancel"
msgstr "Annuleren"

#: src/window.rs
msgid "Sign in"
msgstr "Inloggen"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Vul URL, gebruikersnaam en wachtwoord in."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Sleutel succesvol gegenereerd."

#: src/window.rs
msgid "Service not found"
msgstr "Service niet gevonden"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"De tailscaled-service wordt niet uitgevoerd.\n"
"Klik hieronder om deze te starten."

#: src/window.rs
msgid "Start service"
msgstr "Service starten"

#: src/window.rs
msgid "Server"
msgstr "Server"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "Adres van uw BigScale/Headscale-server."

#: src/window.rs
msgid "Server URL"
msgstr "Server-URL"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Uw identiteit in het netwerk"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Persoonlijke sleutel voor u gegenereerd in het BigScale-paneel (\"Nieuwe "
"sleutel\" bij Gebruikers). Iedereen gebruikt zijn eigen sleutel — dit is "
"niet de serversleutel."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Pre-authenticatiesleutel (uw eigen)"

#: src/window.rs
msgid "This device"
msgstr "Dit apparaat"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Naam die aan andere apparaten in het netwerk wordt getoond."

#: src/window.rs
msgid "Device name"
msgstr "Apparaatnaam"

#: src/window.rs
msgid "Options"
msgstr "Opties"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Automatisch verbinden bij opstarten"

#: src/window.rs
msgid "Connect"
msgstr "Verbinden"

#: src/window.rs
msgid "Please wait..."
msgstr "Even geduld..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Verbonden met het netwerk"

#: src/window.rs
msgid "Your IP address"
msgstr "Uw IP-adres"

#: src/window.rs
msgid "Devices on the network"
msgstr "Apparaten in het netwerk"

#: src/window.rs
msgid "No other devices found."
msgstr "Geen andere apparaten gevonden."

#: src/window.rs
msgid "Copy"
msgstr "Kopiëren"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Uitvoeren van tailscale mislukt"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Verbinding mislukt — controleer de server-URL en sleutel."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Uitvoeren van pkexec tailscale mislukt"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Kan de huidige gebruiker niet bepalen."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Uitvoeren van pkexec tailscale set mislukt"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Instellen van tailscale-operator mislukt."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "De pre-auth-sleutel is afgewezen door de server. Genereer een nieuwe sleutel in het BigScale-paneel en probeer het opnieuw."

msgid "Login rejected by server: {detail}"
msgstr "Aanmelding afgewezen door server: {detail}"
