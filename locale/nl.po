msgid "Make this user the tailscale operator"
msgstr "Maak deze gebruiker de tailscale-operator"

#: src/window.rs
msgid "About BigLace"
msgstr "Over BigLace"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Tailscale-operator"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr ""
"Klaar. U heeft geen wachtwoord meer nodig om verbinding te maken of te "
"verbreken."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Mislukt: {error}"

#: src/window.rs
msgid "OK"
msgstr "OK"

#: src/window.rs
msgid "Error: {error}"
msgstr "Fout: {error}"

#: src/window.rs
msgid "Files"
