#: src/window.rs
msgid "Disconnect"
msgstr "연결 해제"

#: src/window.rs
msgid "Refresh list"
msgstr "목록 새로고침"

#: src/window.rs
msgid "Main menu"
msgstr "메인 메뉴"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "패널 계정으로 로그인"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "이 사용자를 Tailscale 운영자로 설정"

#: src/window.rs
msgid "About BigLace"
msgstr "BigLace 정보"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Tailscale 운영자"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr "완료되었습니다. 이제 연결 또는 해제 시 비밀번호가 필요하지 않습니다."

#: src/window.rs
msgid "Failed: {error}"
msgstr "실패: {error}"

#: src/window.rs
msgid "OK"
msgstr "확인"

#: src/window.rs
msgid "Error: {error}"
msgstr "오류: {error}"

#: src/window.rs
msgid "Files"
msgstr "파일"

#: src/window.rs
msgid "Terminal"
msgstr "터미널"

#: src/window.rs
msgid "Copied!"
msgstr "복사됨!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "BigScale/Headscale용 메시 VPN 클라이언트"

#: src/window.rs
msgid "Panel credentials"
msgstr "패널 자격 증명"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr "BigScale 패널 사용자 이름과 비밀번호를 사용하여 자동으로 키를 생성합니다."

#: src/window.rs
msgid "Panel URL"
msgstr "패널 URL"

#: src/window.rs
msgid "Username"
msgstr "사용자 이름"

#: src/window.rs
msgid "Password"
msgstr "비밀번호"

#: src/window.rs
msgid "Network user identifier"
msgstr "네트워크 사용자 식별자"

#: src/window.rs
msgid "Cancel"
msgstr "취소"

#: src/window.rs
msgid "Sign in"
msgstr "로그인"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "URL, 사용자 이름, 비밀번호를 입력하세요."

#: src/window.rs
msgid "Key generated successfully."
msgstr "키가 성공적으로 생성되었습니다."

#: src/window.rs
msgid "Service not found"
msgstr "서비스를 찾을 수 없음"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"tailscaled 서비스가 실행 중이 아닙니다.\n"
"아래를 클릭하여 시작하세요."

#: src/window.rs
msgid "Start service"
msgstr "서비스 시작"

#: src/window.rs
msgid "Server"
msgstr "서버"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "BigScale/Headscale 서버의 주소입니다."

#: src/window.rs
msgid "Server URL"
msgstr "서버 URL"

#: src/window.rs
msgid "Your identity on the network"
msgstr "네트워크 상의 내 ID"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"BigScale 패널에서 생성된 개인 키 (사용자 메뉴의 \"새 키\"). 각 사용자는 자신의 키를 사용하며, 서버 키와는 다릅니다."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "사전 인증 키 (내 키)"

#: src/window.rs
msgid "This device"
msgstr "이 기기"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "네트워크 상의 다른 기기에 표시되는 이름입니다."

#: src/window.rs
msgid "Device name"
msgstr "기기 이름"

#: src/window.rs
msgid "Options"
msgstr "옵션"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "시작 시 자동 연결"

#: src/window.rs
msgid "Connect"
msgstr "연결"

#: src/window.rs
msgid "Please wait..."
msgstr "잠시만 기다려 주세요..."

#: src/window.rs
msgid "Connected to the network"
msgstr "네트워크에 연결됨"

#: src/window.rs
msgid "Your IP address"
msgstr "내 IP 주소"

#: src/window.rs
msgid "Devices on the network"
msgstr "네트워크 상의 기기"

#: src/window.rs
msgid "No other devices found."
msgstr "다른 기기를 찾을 수 없습니다."

#: src/window.rs
msgid "Copy"
msgstr "복사"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "tailscale 실행 실패"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "연결 실패 — 서버 URL과 키를 확인하세요."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "pkexec tailscale 실행 실패"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "현재 사용자를 확인할 수 없습니다."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "pkexec tailscale set 실행 실패"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "tailscale 운영자 설정 실패"

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "서버가 사전 인증 키를 거부했습니다. BigScale 패널에서 새 키를 생성한 후 다시 시도하세요."

msgid "Login rejected by server: {detail}"
msgstr "서버가 로그인을 거부했습니다: {detail}"
