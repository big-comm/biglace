msgstr "안녕하세요! 이거 어때요? 😊"

msgid "Looks great!"
msgstr "멋져요!"

msgid "Appearance"
msgstr "모양"

msgid "Light"
msgstr "밝게"

msgid "Dark"
msgstr "어둡게"

