msgstr ""
"멤버들은 이 그룹을 통해 더 이상 서로 연결할 수 없게 됩니다. 사람들은 네트워크"
"에 그대로 남습니다."

msgid "Group deleted."
msgstr "그룹을 삭제했습니다."

#, rust-format
msgid "Join {group}?"
msgstr "{group}에 참여할까요?"

#, rust-format
msgid ""
"{user} invited you. You and the group's members will reach each other's "
