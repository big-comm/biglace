#: src/window.rs
msgid "Disconnect"
msgstr "Deconectare"

#: src/window.rs
msgid "Refresh list"
msgstr "Reîmprospătează lista"

#: src/window.rs
msgid "Main menu"
msgstr "Meniu principal"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Autentificare cu contul panel"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "Fă din acest utilizator operatorul tailscale"

#: src/window.rs
msgid "About BigLace"
msgstr "Despre BigLace"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Operator Tailscale"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr ""
"Gata. Nu veți mai avea nevoie de o parolă pentru a vă conecta sau deconecta."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Eșuat: {error}"

#: src/window.rs
msgid "OK"
msgstr "OK"

#: src/window.rs
msgid "Error: {error}"
msgstr "Eroare: {error}"

#: src/window.rs
msgid "Files"
msgstr "Fișiere"

#: src/window.rs
msgid "Terminal"
msgstr "Terminal"

#: src/window.rs
msgid "Copied!"
msgstr "Copiat!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Client VPN Mesh pentru BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "Credențiale panou"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Folosește numele de utilizator și parola contului tău BigScale pentru a "
"genera automat o cheie."

#: src/window.rs
msgid "Panel URL"
msgstr "URL panou"

#: src/window.rs
msgid "Username"
msgstr "Nume utilizator"

#: src/window.rs
msgid "Password"
msgstr "Parolă"

#: src/window.rs
msgid "Network user identifier"
msgstr "Identificator utilizator rețea"

#: src/window.rs
msgid "Cancel"
msgstr "Anulare"

#: src/window.rs
msgid "Sign in"
msgstr "Autentificare"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Completează URL-ul, numele de utilizator și parola."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Cheie generată cu succes."

#: src/window.rs
msgid "Service not found"
msgstr "Serviciu negăsit"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"Serviciul tailscaled nu rulează.\n"
"Faceți clic mai jos pentru a-l porni."

#: src/window.rs
msgid "Start service"
msgstr "Pornește serviciul"

#: src/window.rs
msgid "Server"
msgstr "Server"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "Adresa serverului tău BigScale/Headscale."

#: src/window.rs
msgid "Server URL"
msgstr "URL-ul serverului"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Identitatea ta în rețea"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Cheie personală generată pentru tine în panoul BigScale (\"Cheie nouă\" în "
"Utilizatori). Fiecare persoană o folosește pe a sa — aceasta nu este cheia "
"serverului."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Cheie de pre-autentificare (a ta)"

#: src/window.rs
msgid "This device"
msgstr "Acest dispozitiv"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Numele afișat celorlalte dispozitive din rețea."

#: src/window.rs
msgid "Device name"
msgstr "Numele dispozitivului"

#: src/window.rs
msgid "Options"
msgstr "Opțiuni"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Conectare automată la pornire"

#: src/window.rs
msgid "Connect"
msgstr "Conectare"

#: src/window.rs
msgid "Please wait..."
msgstr "Vă rugăm să așteptați..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Conectat la rețea"

#: src/window.rs
msgid "Your IP address"
msgstr "Adresa ta IP"

#: src/window.rs
msgid "Devices on the network"
msgstr "Dispozitive din rețea"

#: src/window.rs
msgid "No other devices found."
msgstr "Nu s-au găsit alte dispozitive."

#: src/window.rs
msgid "Copy"
msgstr "Copiază"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Nu s-a putut rula tailscale"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Conexiunea a eșuat — verifică URL-ul serverului și cheia."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Nu s-a putut rula pkexec tailscale"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Nu s-a putut determina utilizatorul curent."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Nu s-a putut rula pkexec tailscale set"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Nu s-a putut seta operatorul tailscale."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Cheia de pre-autentificare a fost respinsă de server. Generați o cheie nouă în panoul BigScale și încercați din nou."

msgid "Login rejected by server: {detail}"
msgstr "Autentificare respinsă de server: {detail}"
