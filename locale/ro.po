msgstr "Deconectați-vă"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:134
msgid "Signed out."
msgstr "Deconectat."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:153
msgid "Connect via panel account"
msgstr "Conectați-vă prin contul din panou"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/dialogs.rs:166
msgid ""
"Sign in with your BigScale panel username and password. A device identity "
"will be created on the network automatically — no manual key needed."
msgstr ""
"Conectați-vă cu numele de utilizator și parola din panoul BigScale. O "
"identitate de dispozitiv va fi creată automat în rețea — nu este necesară "
"nicio cheie manuală."

