msgid "Invalid device address."
msgstr "Érvénytelen eszközcím."

msgid ""
"No file manager could open the SFTP location. Install one (Dolphin, "
"Nautilus, Nemo, Thunar…) and try again."
msgstr ""
"Egyik fájlkezelő sem tudta megnyitni az SFTP-helyet. Telepíts egyet "
"(Dolphin, Nautilus, Nemo, Thunar…), és próbáld újra."

msgid ""
"No file manager could open the SFTP location. Install WinSCP and try again."
msgstr ""
"Egyik fájlkezelő sem tudta megnyitni az SFTP-helyet. Telepítsd a WinSCP-t, "
"és próbáld újra."

msgid ""
"No terminal emulator found. Install one (Konsole, GNOME Terminal, xterm…) "
"and try again."
msgstr ""
"Nem található terminálemulátor. Telepíts egyet (Konsole, GNOME Terminal, "
"xterm…), és próbáld újra."

msgid "Failed to run tailscale"
msgstr "Nem sikerült futtatni a tailscale-t"

msgid "Failed to connect — check the server URL and key."
msgstr "Nem sikerült csatlakozni – ellenőrizze a szerver URL-jét és a kulcsot."

msgid "Failed to run pkexec tailscale"
msgstr "Nem sikerült futtatni a pkexec tailscale-t"

msgid "Enter the server URL before connecting."
msgstr "Adja meg a szerver URL-t a csatlakozás előtt."

msgid ""
"The pre-auth key was rejected by the server. Generate a new key in the "
"BigScale panel and try again."
msgstr ""
"A szerver elutasította az előhitelesítési kulcsot. Hozzon létre új kulcsot a "
"BigScale panelen, és próbálja újra."

msgid "Sign in or paste a pre-auth key first."
msgstr ""
"Először jelentkezzen be, vagy illesszen be egy előre hitelesített kulcsot."

#, rust-format
msgid "Login rejected by server: {detail}"
msgstr "A szerver elutasította a bejelentkezést: {detail}"

msgid "Could not determine the current user."
msgstr "Nem sikerült meghatározni az aktuális felhasználót."

msgid "Failed to run pkexec tailscale set"
msgstr "Nem sikerült futtatni a pkexec tailscale set parancsot"

msgid "Failed to set tailscale operator."
msgstr "Nem sikerült beállítani a tailscale operátort."

msgid "Invite someone"
msgstr "Valaki meghívása"

msgid "Open admin panel"
msgstr "Adminisztrációs panel megnyitása"

msgid "Devices"
msgstr "Eszközök"

msgid "Chat"
msgstr "Csevegés"

msgid "Invites"
msgstr "Meghívók"

msgid "Groups"
msgstr "Csoportok"

msgid "Rooms"
msgstr "Szobák"

msgid "Pictures"
msgstr "Képek"

msgid "Choose your photo"
msgstr "Válaszd ki a fényképed"

msgid "Photo updated. Everyone you're connected to will see it."
msgstr "Fénykép frissítve. Mindenki, akihez csatlakozol, látni fogja."

#, rust-format
msgid "Could not change the photo: {error}"
msgstr "Nem sikerült módosítani a fényképet: {error}"

msgid "Sign in with an access key"
msgstr "Bejelentkezés hozzáférési kulccsal"

msgid ""
"Paste the key the administrator gave you. It's used once, to register this "
"device."
msgstr ""
"Illeszd be a rendszergazdától kapott kulcsot. Egyszer használatos, az eszköz "
"regisztrálásához."

msgid "Server URL"
msgstr "Szerver URL"

msgid "Access key"
msgstr "Hozzáférési kulcs"

msgid "Device name on the network"
msgstr "Eszköznév a hálózaton"

msgid "Cancel"
msgstr "Mégse"

msgid "Connect"
msgstr "Csatlakozás"

msgid ""
"The key to this account is no longer on this computer. Join with a new "
"invite."
msgstr "A fiók kulcsa már nincs ezen a számítógépen. Csatlakozz új meghívóval."

#, rust-format
msgid "Welcome back, {name}! Connecting…"
msgstr "Üdv újra, {name}! Kapcsolódás…"

#, rust-format
msgid "Error: {error}"
msgstr "Hiba: {error}"

#, rust-format
msgid ""
"The account {user} no longer exists on this network. Join with a new invite."
msgstr ""
"A(z) {user} fiók már nem létezik ezen a hálózaton. Csatlakozz új meghívóval."

msgid "Preferences"
msgstr "Beállítások"

msgid "General"
msgstr "Általános"

msgid "Behaviour"
msgstr "Viselkedés"

msgid "System"
msgstr "Rendszer"

msgid "Make this user the tailscale operator"
msgstr "A felhasználó beállítása tailscale operátorként"

msgid ""
"Lets BigLace manage the connection without asking for a password each time"
msgstr ""
"Lehetővé teszi, hogy a BigLace jelszókérés nélkül kezelje a kapcsolatot"

msgid "Account"
msgstr "Fiók"

msgid ""
"Signing out removes this device's identity from BigLace. You will need a new "
"invite or key to join again."
msgstr ""
"A kijelentkezés eltávolítja az eszköz identitását a BigLace-ből. Az újbóli "
"csatlakozáshoz új meghívó vagy kulcs kell."

msgid "Sign out"
msgstr "Kijelentkezés"

msgid "Connect a phone"
msgstr "Telefon csatlakoztatása"

msgid "Invites you sent"
msgstr "Elküldött meghívók"

msgid "Change profile photo…"
msgstr "Profilkép módosítása…"

msgid "Join with an invite"
msgstr "Csatlakozás meghívóval"

msgid "Sign in with panel account"
msgstr "Bejelentkezés panel fiókkal"

msgid "Leave the network…"
msgstr "Kilépés a hálózatból…"

msgid "View tailscaled logs"
msgstr "Tailscaled naplók megtekintése"

msgid "About BigLace"
msgstr "A BigLace névjegye"

msgid "Connect to the network first, then open the invite link again."
msgstr ""
"Előbb csatlakozz a hálózathoz, majd nyisd meg újra a meghívóhivatkozást."

#, rust-format
msgid "This invite is for another network ({host}). Sign out first to join it."
msgstr ""
"Ez a meghívó egy másik hálózathoz szól ({host}). A csatlakozáshoz előbb "
"jelentkezz ki."

msgid ""
"This device is already signed in. Sign out first to join with an invite."
msgstr ""
"Ez az eszköz már be van jelentkezve. A meghívóval való csatlakozáshoz előbb "
"jelentkezz ki."

msgid "Photo removed."
msgstr "Fénykép eltávolítva."

#, rust-format
msgid "Could not remove the photo: {error}"
msgstr "Nem sikerült eltávolítani a fényképet: {error}"

#, rust-format
msgid "Could not open the browser: {error}"
msgstr "Nem sikerült megnyitni a böngészőt: {error}"

msgid ""
"You can't open the admin panel: you're not an administrator of this network, "
"or the panel can't be reached."
msgstr ""
"Nem nyithatod meg az adminisztrációs panelt: nem vagy a hálózat "
"rendszergazdája, vagy a panel nem érhető el."

msgid "Enter the server URL before saving."
msgstr "Adja meg a szerver URL-t a mentés előtt."

msgid "Enter the pre-auth key before saving."
msgstr "Adja meg az előhitelesítési kulcsot a mentés előtt."

msgid "Setup saved"
msgstr "Beállítás elmentve"

msgid "Could not start the Tailscale service."
msgstr "Nem sikerült elindítani a Tailscale szolgáltatást."

msgid "IP address copied"
msgstr "IP-cím másolva"

#, rust-format
msgid ""
"Saved, but the pre-auth key could not be stored in the system keyring "
"({error}). This device can still reconnect; the key is only needed again to "
"register it anew."
msgstr ""
"Mentve, de az előhitelesítési kulcsot nem sikerült a rendszer "
"kulcstartójában tárolni ({error}). Az eszköz így is újracsatlakozhat; a "
"kulcsra csak az újbóli regisztrációhoz van szükség."

msgid "Connected"
msgstr "Csatlakoztatva"

msgid "Service stopped"
msgstr "Szolgáltatás leállítva"

msgid "Not signed in"
msgstr "Nincs bejelentkezve"

msgid "Disconnected"
msgstr "Kapcsolat bontva"

msgid "Connecting…"
msgstr "Csatlakozás…"

msgid "Server unreachable"
msgstr "Szerver nem elérhető"

msgid "Tailscale can't set DNS"
msgstr "A Tailscale nem tudja beállítani a DNS-t"

#, rust-format
msgid "Update available: v{version}"
msgstr "Frissítés elérhető: v{version}"

#, rust-format
msgid "Sign in again as {user}"
msgstr "Jelentkezz be újra mint {user}"

msgid "(no device name)"
msgstr "(nincs eszköznév)"

msgid "Sign in or paste a pre-auth key"
msgstr "Jelentkezzen be, vagy illesszen be egy előre hitelesített kulcsot"

msgid "Server not set"
msgstr "Szerver nincs beállítva"

msgid "Disconnect"
msgstr "Kapcsolat bontása"

msgid "no other devices"
msgstr "nincs más eszköz"

#, rust-format
msgid "{online} online"
msgstr "{online} online"

#, rust-format
msgid "{online} online · {offline} offline"
msgstr "{online} online · {offline} offline"

msgid "is online"
msgstr "online"

msgid "went offline"
msgstr "offline lett"

#, rust-format
msgid "{count} devices are online"
msgstr "{count} eszköz online"

#, rust-format
msgid "{count} devices went offline"
msgstr "{count} eszköz offline lett"

#, rust-format
msgid "{on_count} online · {off_count} offline"
msgstr "{on_count} online · {off_count} offline"

msgid ""
"On the phone, open BigLace and tap “Scan QR code”, then point it at this "
"code. The phone joins as one of your devices."
msgstr ""
"A telefonon nyisd meg a BigLace-t, koppints a „QR-kód beolvasása” gombra, "
"majd irányítsd erre a kódra. A telefon az egyik eszközödként csatlakozik."

msgid "Asking the panel for a code…"
msgstr "Kód kérése a paneltől…"

msgid "New code"
msgstr "Új kód"

msgid "This code is no longer valid."
msgstr "Ez a kód már nem érvényes."

#, rust-format
msgid "Valid for {time} · works once"
msgstr "Érvényes: {time} · egyszer használható"

msgid ""
"This network's server doesn't pair phones yet. Ask your administrator to "
"update the panel, or invite the phone instead."
msgstr ""
"A hálózat szervere még nem tud telefonokat párosítani. Kérd meg a "
"rendszergazdát, hogy frissítse a panelt, vagy inkább hívd meg a telefont."

msgid ""
"Invites from BigLace need a BigScale server that supports them. Ask your "
"administrator to update the server, or to create the invite in the panel."
msgstr ""
"A BigLace meghívóihoz ezt támogató BigScale szerver kell. Kérd meg a "
"rendszergazdát, hogy frissítse a szervert, vagy hozza létre a meghívót a "
"panelen."

msgid "This device can't send invites (it isn't linked to a person's account)."
msgstr ""
"Ez az eszköz nem küldhet meghívókat (nincs személyes fiókhoz kapcsolva)."

msgid ""
"The panel knows this device by a different key (BigLace was reinstalled?). "
"Leave the network and join again to fix it."
msgstr ""
"A panel más kulccsal ismeri ezt az eszközt (újratelepítetted a BigLace-t?). "
"A javításhoz lépj ki a hálózatból, és csatlakozz újra."

msgid ""
"The panel couldn't confirm this device. Make sure BigLace is up to date and "
"stays open while connected, then try again."
msgstr ""
"A panel nem tudta megerősíteni ezt az eszközt. Győződj meg róla, hogy a "
"BigLace naprakész, és csatlakozás közben nyitva marad, majd próbáld újra."

msgid "You are no longer in that group."
msgstr "Már nem vagy tagja annak a csoportnak."

msgid ""
"On this network everyone can reach everyone, so only the administrator can "
"invite people."
msgstr ""
"Ezen a hálózaton mindenki mindenkit elér, így csak a rendszergazda hívhat "
"meg embereket."

msgid "You have too many pending invites. Cancel some or try again tomorrow."
msgstr ""
"Túl sok függő meghívód van. Vonj vissza néhányat, vagy próbáld újra holnap."

msgid ""
"On this network only administrators invite new people. You can still invite "
"people already on the network into your groups."
msgstr ""
"Ezen a hálózaton csak a rendszergazdák hívnak meg új embereket. A hálózaton "
"már lévőket továbbra is meghívhatod a csoportjaidba."

#, rust-format
msgid "Could not reach the panel: {error}"
msgstr "Nem sikerült elérni a panelt: {error}"

msgid "Waiting to be used"
msgstr "Felhasználásra vár"

msgid "Used"
msgstr "Felhasználva"

msgid "Expired"
msgstr "Lejárt"

msgid "Cancelled"
msgstr "Visszavonva"

msgid "Waiting for an administrator's approval"
msgstr "Rendszergazdai jóváhagyásra vár"

msgid "Refresh"
msgstr "Frissítés"

msgid "Main menu"
msgstr "Főmenü"

msgid "Bring someone to your network"
msgstr "Hozz valakit a hálózatodba"

msgid ""
"Create a link or QR code and send it to the person. When they join, you two "
"can reach each other's devices — no administrator needed. The link works "
"once and stays valid until it's used or you cancel it."
msgstr ""
"Hozz létre egy hivatkozást vagy QR-kódot, és küldd el a személynek. Amikor "
"csatlakozik, elérhetitek egymás eszközeit — rendszergazda nélkül. A "
"hivatkozás egyszer működik, és addig érvényes, amíg fel nem használják vagy "
"vissza nem vonod."

msgid "No invites yet"
msgstr "Még nincsenek meghívók"

msgid "Invites unavailable"
msgstr "A meghívók nem érhetők el"

#, rust-format
msgid "{user} joined"
msgstr "{user} csatlakozott"

msgid "Invite"
msgstr "Meghívás"

#, rust-format
msgid "group {group}"
msgstr "{group} csoport"

msgid "Cancel this invite: the link stops working"
msgstr "Meghívó visszavonása: a hivatkozás nem fog működni"

msgid "The person you invite will reach your devices, and you theirs."
msgstr "Akit meghívsz, eléri az eszközeidet, te pedig az övéit."

msgid "Who is it for? (optional)"
msgstr "Kinek szól? (nem kötelező)"

msgid "Access"
msgstr "Hozzáférés"

msgid "Just the two of us"
msgstr "Csak mi ketten"

msgid "You see each other's devices, nobody else"
msgstr "Látjátok egymás eszközeit, más senkit"

#, rust-format
msgid "Also the group {group}"
msgstr "A(z) {group} csoport is"

msgid "They join the group and see everyone in it"
msgstr "Csatlakozik a csoporthoz, és mindenkit lát benne"

msgid "A network of their own"
msgstr "Saját hálózat"

msgid ""
"No link to you: they see only their own devices and whoever they invite "
"(you're the administrator)"
msgstr ""
"Nincs kapcsolat veled: csak a saját eszközeit és az általa meghívottakat "
"látja (te vagy a rendszergazda)"

msgid "Create invite"
msgstr "Meghívó létrehozása"

msgid "QR code of the invite link"
msgstr "A meghívóhivatkozás QR-kódja"

msgid ""
"Send the link or let the person scan the code with their phone. It works "
"once and stays valid until used or cancelled."
msgstr ""
"Küldd el a hivatkozást, vagy hagyd, hogy a személy beolvassa a kódot a "
"telefonjával. Egyszer működik, és felhasználásig vagy visszavonásig érvényes."

msgid "Copy link"
msgstr "Hivatkozás másolása"

msgid "Done"
msgstr "Kész"

msgid "Copied!"
msgstr "Másolva!"

msgid ""
"This network asks an administrator to approve each invite: the link starts "
"working once they do. Its status shows in Invites."
msgstr ""
"Ez a hálózat minden meghívóhoz rendszergazdai jóváhagyást kér: a hivatkozás "
"a jóváhagyás után kezd működni. Az állapota a Meghívók részben látható."

msgid "Show the full sidebar"
msgstr "Teljes oldalsáv megjelenítése"

msgid "Show only icons in the sidebar"
msgstr "Csak ikonok az oldalsávban"

msgid "Sections"
msgstr "Szakaszok"

msgid ""
"Your identity on this mesh — the device name shown to other peers and the "
"network you're connected to."
msgstr ""
"Az Ön identitása ezen a hálózaton — az eszköznév, amelyet a többi társ lát, "
"valamint a hálózat, amelyhez csatlakozott."

msgid "Change photo…"
msgstr "Fénykép módosítása…"

msgid "Remove photo"
msgstr "Fénykép eltávolítása"

msgid "Change your photo"
msgstr "Fénykép módosítása"

msgid "Rename this device on the network"
msgstr "Eszköz átnevezése a hálózaton"

msgid "Advanced: use a pre-auth key"
msgstr "Speciális: előre hitelesítő kulcs használata"

msgid "Already have a key from your administrator? Paste it here."
msgstr "Már van egy kulcsa a rendszergazdától? Illessze be ide."

msgid ""
"Manual setup — expand to paste a server URL and pre-auth key when you "
"already received them from your administrator. Most users should sign in "
"through the panel button above instead."
msgstr ""
"Kézi beállítás — bontsa ki, hogy beillessze a szerver URL-jét és az előre "
"hitelesítő kulcsot, ha már megkapta azokat a rendszergazdától. A legtöbb "
"felhasználónak inkább a fenti panel gombján keresztül kell bejelentkeznie."

msgid ""
"Address of the coordination server (e.g. vpn.example.org). The https:// "
"scheme is added automatically if you omit it."
msgstr ""
"A koordinációs szerver címe (pl. vpn.example.org). A https:// séma "
"automatikusan hozzáadódik, ha elhagyja."

msgid "Pre-auth key"
msgstr "Előhitelesítési kulcs"

msgid ""
"One-time or reusable key created on the server (starts with 'hskey-auth-'). "
"Used to register this device automatically without opening a browser."
msgstr ""
"Egyszer használatos vagy újrafelhasználható kulcs, amely a szerveren lett "
"létrehozva ('hskey-auth-' kezdettel). Az eszköz automatikus regisztrálására "
"szolgál anélkül, hogy böngészőt kellene megnyitni."

msgid ""
"The name this device shows to other peers on the VPN — this is the Tailscale "
"hostname, NOT your computer's name and NOT your user. Lowercase letters, "
"digits and hyphens. Example: 'tales-laptop', 'francois', 'office-pc'."
msgstr ""
"A név, amelyet ez az eszköz mutat a többi társnak a VPN-en — ez a Tailscale "
"hosztnév, NEM a számítógép neve és NEM a felhasználó neve. Kisbetűk, "
"számjegyek és kötőjelek. Példa: 'tales-laptop', 'francois', 'office-pc'."

msgid "Apply manual setup"
msgstr "Kézi beállítás alkalmazása"

msgid "Save"
msgstr "Mentés"

msgid ""
"Persist the server, key and device name above. Won't connect — press Connect "
"afterwards."
msgstr ""
"A fenti szerver, kulcs és eszköznév megőrzése. Nem csatlakozik — nyomja meg "
"a Csatlakozás gombot utána."

msgid "Connect automatically"
msgstr "Automatikus csatlakozás"

msgid "Join the network when BigLace starts"
msgstr "Csatlakozzon a hálózathoz a BigLace indulásakor"

msgid ""
"When on, BigLace runs 'tailscale up' as soon as it launches, so you join the "
"mesh without clicking Connect every time."
msgstr ""
"Ha be van kapcsolva, a BigLace a 'tailscale up' parancsot futtatja, amint "
"elindul, így csatlakozik a hálózathoz anélkül, hogy minden alkalommal a "
"Csatlakozás gombra kellene kattintania."

msgid "Toggle auto-connect on startup"
msgstr "Automatikus csatlakozás be-/kikapcsolása indításkor"

msgid "Start BigLace with the session"
msgstr "BigLace indítása a munkamenettel"

msgid "Open BigLace after you sign in to the desktop"
msgstr "BigLace megnyitása az asztali bejelentkezés után"

msgid ""
"Turn this on to add BigLace to your desktop session startup. Turn it off to "
"remove it."
msgstr ""
"Kapcsolja be ezt, hogy BigLace-t hozzáadja az asztali munkamenet "
"indításához. Kapcsolja ki az eltávolításhoz."

msgid "Toggle start with session"
msgstr "Indítás a munkamenettel be-/kikapcsolása"

msgid "Reconnect on drop"
msgstr "Újracsatlakozás megszakadáskor"

msgid "Retry with backoff when the connection is lost"
msgstr "Újrapróbálkozás késleltetéssel, ha megszakad a kapcsolat"

msgid ""
"If the tunnel drops (network change, sleep, server hiccup), BigLace silently "
"retries with growing delays instead of leaving you offline until you notice."
msgstr ""
"Ha az alagút megszakad (hálózatváltás, alvó üzemmód, szerverhiba), a BigLace "
"csendben újrapróbálkozik növekvő késleltetésekkel, ahelyett, hogy offline "
"állapotban hagyná, amíg észre nem veszi."

msgid "Toggle auto-reconnect"
msgstr "Automatikus újracsatlakozás be-/kikapcsolása"

msgid "Notify on peer changes"
msgstr "Értesítés társak változásairól"

msgid "Show a desktop notification when peers go online/offline"
msgstr ""
"Asztali értesítés megjelenítése, ha társak online/offline állapotba kerülnek"

msgid ""
"Send a desktop toast when another device on your network goes online or "
"offline. Rapid bursts are coalesced into a single notification so you don't "
"get spammed during reconnects."
msgstr ""
"Asztali értesítés küldése, amikor egy másik eszköz a hálózaton elérhetővé "
"vagy elérhetetlenné válik. A gyors egymásutánban érkező események egyetlen "
"értesítésbe tömörülnek, hogy ne kapjon spamet az újracsatlakozások során."

msgid "Toggle peer-change notifications"
msgstr "Társváltozás-értesítések be-/kikapcsolása"

msgid ""
"Join or leave the mesh network. When connected, this device becomes "
"reachable by the other peers in your account."
msgstr ""
"Csatlakozás vagy kilépés a mesh hálózatból. Csatlakoztatott állapotban ez az "
"eszköz elérhetővé válik a fiókjában lévő többi partner számára."

msgid "Your photo"
msgstr "Fényképed"

msgid "New chat"
msgstr "Új csevegés"

msgid "Start a conversation with someone on the network"
msgstr "Beszélgetés indítása valakivel a hálózaton"

msgid "Chat theme"
msgstr "Csevegési téma"

msgid "Conversations"
msgstr "Beszélgetések"

msgid "No conversations yet."
msgstr "Még nincsenek beszélgetések."

msgid "Search in this conversation (Ctrl+F)"
msgstr "Keresés ebben a beszélgetésben (Ctrl+F)"

msgid "Pinned message"
msgstr "Kitűzött üzenet"

msgid "Unpin"
msgstr "Kitűzés megszüntetése"

msgid "Search messages"
msgstr "Üzenetek keresése"

msgid "Older"
msgstr "Régebbi"

msgid "Newer"
msgstr "Újabb"

