#: src/window.rs
msgid "Disconnect"
msgstr "Kapcsolat bontása"

#: src/window.rs
msgid "Refresh list"
msgstr "Lista frissítése"

#: src/window.rs
msgid "Main menu"
msgstr "Főmenü"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Bejelentkezés panel fiókkal"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "A felhasználó beállítása tailscale operátorként"

#: src/window.rs
msgid "About BigLace"
msgstr "A BigLace névjegye"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Tailscale operátor"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr ""
"Kész. A továbbiakban nem lesz szüksége jelszóra a csatlakozáshoz vagy a "
"kapcsolat bontásához."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Sikertelen: {error}"

#: src/window.rs
msgid "OK"
msgstr "OK"

#: src/window.rs
msgid "Error: {error}"
msgstr "Hiba: {error}"

#: src/window.rs
msgid "Files"
msgstr "Fájlok"

#: src/window.rs
msgid "Terminal"
msgstr "Terminál"

#: src/window.rs
msgid "Copied!"
msgstr "Másolva!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Mesh VPN kliens a BigScale/Headscale számára."

#: src/window.rs
msgid "Panel credentials"
msgstr "Panel hitelesítő adatok"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Használja BigScale panel felhasználónevét és jelszavát a kulcs automatikus "
"létrehozásához."

#: src/window.rs
msgid "Panel URL"
msgstr "Panel URL"

#: src/window.rs
msgid "Username"
msgstr "Felhasználónév"

#: src/window.rs
msgid "Password"
msgstr "Jelszó"

#: src/window.rs
msgid "Network user identifier"
msgstr "Hálózati felhasználóazonosító"

#: src/window.rs
msgid "Cancel"
msgstr "Mégse"

#: src/window.rs
msgid "Sign in"
msgstr "Bejelentkezés"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Adja meg az URL-t, felhasználónevet és jelszót."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Kulcs sikeresen létrehozva."

#: src/window.rs
msgid "Service not found"
msgstr "Szolgáltatás nem található"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"A tailscaled szolgáltatás nem fut.\n"
"Kattintson alább az elindításához."

#: src/window.rs
msgid "Start service"
msgstr "Szolgáltatás indítása"

#: src/window.rs
msgid "Server"
msgstr "Szerver"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "A BigScale/Headscale szerver címe."

#: src/window.rs
msgid "Server URL"
msgstr "Szerver URL"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Az Ön identitása a hálózaton"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Személyes kulcs generálva az Ön számára a BigScale panelen (\"Új kulcs\" a "
"Felhasználók menüben). Mindenki a sajátját használja – ez nem a szerver "
"kulcsa."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Előhitelesítő kulcs (az Öné)"

#: src/window.rs
msgid "This device"
msgstr "Ez az eszköz"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "A hálózat többi eszköze felé mutatott név."

#: src/window.rs
msgid "Device name"
msgstr "Eszköznév"

#: src/window.rs
msgid "Options"
msgstr "Beállítások"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Automatikus csatlakozás indításkor"

#: src/window.rs
msgid "Connect"
msgstr "Csatlakozás"

#: src/window.rs
msgid "Please wait..."
msgstr "Kérem, várjon..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Csatlakozva a hálózathoz"

#: src/window.rs
msgid "Your IP address"
msgstr "Az Ön IP-címe"

#: src/window.rs
msgid "Devices on the network"
msgstr "Eszközök a hálózaton"

#: src/window.rs
msgid "No other devices found."
msgstr "Nem található más eszköz."

#: src/window.rs
msgid "Copy"
msgstr "Másolás"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Nem sikerült futtatni a tailscale-t"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr ""
"Nem sikerült csatlakozni – ellenőrizze a szerver URL-jét és a kulcsot."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Nem sikerült futtatni a pkexec tailscale-t"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Nem sikerült meghatározni az aktuális felhasználót."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Nem sikerült futtatni a pkexec tailscale set parancsot"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Nem sikerült beállítani a tailscale operátort."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "A szerver elutasította az előhitelesítési kulcsot. Hozzon létre új kulcsot a BigScale panelen, és próbálja újra."

msgid "Login rejected by server: {detail}"
msgstr "A szerver elutasította a bejelentkezést: {detail}"
