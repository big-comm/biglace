#: src/window.rs
msgid "Disconnect"
msgstr "Katkaise yhteys"

#: src/window.rs
msgid "Refresh list"
msgstr "Päivitä lista"

#: src/window.rs
msgid "Main menu"
msgstr "Päävalikko"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Kirjaudu sisään paneelitilillä"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "Tee tästä käyttäjästä tailscale-operaattori"

#: src/window.rs
msgid "About BigLace"
msgstr "Tietoja BigLacesta"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Tailscale-operaattori"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr ""
"Valmis. Et enää tarvitse salasanaa yhdistämiseen tai yhteyden "
"katkaisemiseen."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Epäonnistui: {error}"

#: src/window.rs
msgid "OK"
msgstr "OK"

#: src/window.rs
msgid "Error: {error}"
msgstr "Virhe: {error}"

#: src/window.rs
msgid "Files"
msgstr "Tiedostot"

#: src/window.rs
msgid "Terminal"
msgstr "Pääte"

#: src/window.rs
msgid "Copied!"
msgstr "Kopioitu!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Mesh VPN -asiakasohjelma BigScale/Headscale-palvelulle."

#: src/window.rs
msgid "Panel credentials"
msgstr "Paneelin tunnistetiedot"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Käytä BigScale-paneelin käyttäjätunnustasi ja salasanaasi avaimen "
"automaattiseen luomiseen."

#: src/window.rs
msgid "Panel URL"
msgstr "Paneelin URL-osoite"

#: src/window.rs
msgid "Username"
msgstr "Käyttäjätunnus"

#: src/window.rs
msgid "Password"
msgstr "Salasana"

#: src/window.rs
msgid "Network user identifier"
msgstr "Verkon käyttäjätunniste"

#: src/window.rs
msgid "Cancel"
msgstr "Peruuta"

#: src/window.rs
msgid "Sign in"
msgstr "Kirjaudu sisään"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Täytä URL-osoite, käyttäjätunnus ja salasana."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Avain luotu onnistuneesti."

#: src/window.rs
msgid "Service not found"
msgstr "Palvelua ei löydy"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"Tailscaled-palvelu ei ole käynnissä.\n"
"Napsauta alla käynnistääksesi se."

#: src/window.rs
msgid "Start service"
msgstr "Käynnistä palvelu"

#: src/window.rs
msgid "Server"
msgstr "Palvelin"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "BigScale/Headscale-palvelimesi osoite."

#: src/window.rs
msgid "Server URL"
msgstr "Palvelimen URL-osoite"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Henkilöllisyytesi verkossa"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"BigScale-paneelissa sinulle luotu henkilökohtainen avain (\"Uusi avain\" "
"kohdassa Käyttäjät). Jokainen käyttää omaansa – tämä ei ole palvelimen "
"avain."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Esivaltuutusavain (sinun)"

#: src/window.rs
msgid "This device"
msgstr "Tämä laite"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Nimi, joka näkyy muille verkon laitteille."

#: src/window.rs
msgid "Device name"
msgstr "Laitteen nimi"

#: src/window.rs
msgid "Options"
msgstr "Asetukset"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Yhdistä automaattisesti käynnistyksen yhteydessä"

#: src/window.rs
msgid "Connect"
msgstr "Yhdistä"

#: src/window.rs
msgid "Please wait..."
msgstr "Odota hetki..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Yhdistetty verkkoon"

#: src/window.rs
msgid "Your IP address"
msgstr "IP-osoitteesi"

#: src/window.rs
msgid "Devices on the network"
msgstr "Verkon laitteet"

#: src/window.rs
msgid "No other devices found."
msgstr "Muita laitteita ei löytynyt."

#: src/window.rs
msgid "Copy"
msgstr "Kopioi"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Tailscalen suoritus epäonnistui"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr ""
"Yhteyden muodostaminen epäonnistui — tarkista palvelimen URL-osoite ja "
"avain."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "pkexec tailscalen suoritus epäonnistui"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Nykyistä käyttäjää ei voitu määrittää."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "pkexec tailscale set -komennon suoritus epäonnistui"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Tailscale-operaattorin asettaminen epäonnistui."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Palvelin hylkäsi esitodennusavaimen. Luo uusi avain BigScale-paneelissa ja yritä uudelleen."

msgid "Login rejected by server: {detail}"
msgstr "Palvelin hylkäsi sisäänkirjautumisen: {detail}"
