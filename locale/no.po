msgid "Save"
msgstr "Lagre"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/sidebar.rs:91
msgid "Save the server and key above"
msgstr "Lagre serveren og nøkkelen over"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/sidebar.rs:112
msgid "Connect automatically"
msgstr "Koble til automatisk"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/sidebar.rs:113
msgid "Join the network when BigLace starts"
msgstr "Bli med i nettverket når BigLace starter"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/mod.rs:424
msgid "Sign in or paste a pre-auth key"
msgstr "Logg inn eller lim inn en forhåndsgodkjent nøkkel"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/mod.rs:429
msgid "Server not set"
msgstr "Server ikke angitt"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/mod.rs:186
msgid "Setup saved"
msgstr "Oppsett lagret"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/mod.rs:242
msgid "Sign in or paste a pre-auth key first."
msgstr "Logg inn eller lim inn en forhåndsgodkjent nøkkel først."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/content.rs:62
msgid "Sign in to connect"
msgstr "Logg inn for å koble til"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/content.rs:63
msgid "Use the panel on the left to sign in or paste a pre-auth key."
msgstr ""
"Bruk panelet til venstre for å logge inn eller lim inn en forhåndsgodkjent "
"nøkkel."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/content.rs:71
msgid "Not connected"
msgstr "Ikke tilkoblet"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/content.rs:72
msgid "Press Connect on the left to join the network."
msgstr "Trykk Koble til til venstre for å bli med i nettverket."

