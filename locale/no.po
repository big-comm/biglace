#: src/window.rs
msgid "Disconnect"
msgstr "Koble fra"

#: src/window.rs
msgid "Refresh list"
msgstr "Oppdater liste"

#: src/window.rs
msgid "Main menu"
msgstr "Hovedmeny"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Logg inn med panelkonto"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "Gjør denne brukeren til tailscale-operatør"

#: src/window.rs
msgid "About BigLace"
msgstr "Om BigLace"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Tailscale-operatør"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr ""
"Fullført. Du vil ikke lenger trenge et passord for å koble til eller fra."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Mislyktes: {error}"

#: src/window.rs
msgid "OK"
msgstr "OK"

#: src/window.rs
msgid "Error: {error}"
msgstr "Feil: {error}"

#: src/window.rs
msgid "Files"
msgstr "Filer"

#: src/window.rs
msgid "Terminal"
msgstr "Terminal"

#: src/window.rs
msgid "Copied!"
msgstr "Kopiert!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Mesh VPN-klient for BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "Panel-legitimasjon"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Bruk brukernavn og passord fra BigScale-panelet for å generere en nøkkel "
"automatisk."

#: src/window.rs
msgid "Panel URL"
msgstr "Panel-URL"

#: src/window.rs
msgid "Username"
msgstr "Brukernavn"

#: src/window.rs
msgid "Password"
msgstr "Passord"

#: src/window.rs
msgid "Network user identifier"
msgstr "Nettverksbrukeridentifikator"

#: src/window.rs
msgid "Cancel"
msgstr "Avbryt"

#: src/window.rs
msgid "Sign in"
msgstr "Logg inn"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Fyll inn URL, brukernavn og passord."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Nøkkel generert vellykket."

#: src/window.rs
msgid "Service not found"
msgstr "Tjenesten ble ikke funnet"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"tailscaled-tjenesten kjører ikke.\n"
"Klikk nedenfor for å starte den."

#: src/window.rs
msgid "Start service"
msgstr "Start tjeneste"

#: src/window.rs
msgid "Server"
msgstr "Tjener"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "Adressen til din BigScale/Headscale-tjener."

#: src/window.rs
msgid "Server URL"
msgstr "Server-URL"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Din identitet på nettverket"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Personlig nøkkel generert for deg i BigScale-panelet (\"Ny nøkkel\" under "
"Brukere). Hver person bruker sin egen – dette er ikke serverens nøkkel."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Forhåndsgodkjent nøkkel (din)"

#: src/window.rs
msgid "This device"
msgstr "Denne enheten"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Navn som vises for andre enheter på nettverket."

#: src/window.rs
msgid "Device name"
msgstr "Enhetsnavn"

#: src/window.rs
msgid "Options"
msgstr "Alternativer"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Koble til automatisk ved oppstart"

#: src/window.rs
msgid "Connect"
msgstr "Koble til"

#: src/window.rs
msgid "Please wait..."
msgstr "Vennligst vent..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Tilkoblet nettverket"

#: src/window.rs
msgid "Your IP address"
msgstr "Din IP-adresse"

#: src/window.rs
msgid "Devices on the network"
msgstr "Enheter på nettverket"

#: src/window.rs
msgid "No other devices found."
msgstr "Ingen andre enheter funnet."

#: src/window.rs
msgid "Copy"
msgstr "Kopier"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Kunne ikke kjøre tailscale"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Kunne ikke koble til – kontroller server-URL og nøkkel."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Kunne ikke kjøre pkexec tailscale"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Kunne ikke fastslå gjeldende bruker."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Kunne ikke kjøre pkexec tailscale set"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Kunne ikke angi tailscale-operator."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Forhåndsautentiseringsnøkkelen ble avvist av serveren. Generer en ny nøkkel i BigScale-panelet og prøv igjen."

msgid "Login rejected by server: {detail}"
msgstr "Pålogging avvist av serveren: {detail}"
