#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/tailscale.rs:320
msgid "Failed to connect — check the server URL and key."
msgstr "Kunne ikke koble til – kontroller server-URL og nøkkel."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/tailscale.rs:245
msgid "Failed to run pkexec tailscale"
msgstr "Kunne ikke kjøre pkexec tailscale"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/tailscale.rs:382
msgid "Could not determine the current user."
msgstr "Kunne ikke fastslå gjeldende bruker."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/tailscale.rs:388
