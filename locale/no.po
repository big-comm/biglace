msgid "Invalid device address."
msgstr "Ugyldig enhetsadresse."

msgid ""
"No file manager could open the SFTP location. Install one (Dolphin, "
"Nautilus, Nemo, Thunar…) and try again."
msgstr ""
"Ingen filbehandler kunne åpne SFTP-plasseringen. Installer en (Dolphin, "
"Nautilus, Nemo, Thunar…) og prøv igjen."

msgid ""
"No file manager could open the SFTP location. Install WinSCP and try again."
msgstr ""
"Ingen filbehandler kunne åpne SFTP-plasseringen. Installer WinSCP og prøv "
"igjen."

msgid ""
"No terminal emulator found. Install one (Konsole, GNOME Terminal, xterm…) "
"and try again."
msgstr ""
"Fant ingen terminalemulator. Installer en (Konsole, GNOME Terminal, xterm…) "
"og prøv igjen."

msgid "Failed to run tailscale"
msgstr "Kunne ikke kjøre tailscale"

msgid "Failed to connect — check the server URL and key."
msgstr "Kunne ikke koble til – kontroller server-URL og nøkkel."

msgid "Failed to run pkexec tailscale"
msgstr "Kunne ikke kjøre pkexec tailscale"

msgid "Enter the server URL before connecting."
msgstr "Skriv inn server-URL-en før du kobler til."

msgid ""
"The pre-auth key was rejected by the server. Generate a new key in the "
"BigScale panel and try again."
msgstr ""
"Forhåndsautentiseringsnøkkelen ble avvist av serveren. Generer en ny nøkkel "
"i BigScale-panelet og prøv igjen."

msgid "Sign in or paste a pre-auth key first."
msgstr "Logg inn eller lim inn en forhåndsgodkjent nøkkel først."

#, rust-format
msgid "Login rejected by server: {detail}"
msgstr "Pålogging avvist av serveren: {detail}"

msgid "Could not determine the current user."
msgstr "Kunne ikke fastslå gjeldende bruker."

msgid "Failed to run pkexec tailscale set"
msgstr "Kunne ikke kjøre pkexec tailscale set"

msgid "Failed to set tailscale operator."
msgstr "Kunne ikke angi tailscale-operator."

msgid "Invite someone"
msgstr "Inviter noen"

msgid "Open admin panel"
msgstr "Åpne administrasjonspanelet"

msgid "Devices"
msgstr "Enheter"

msgid "Chat"
msgstr "Chat"

msgid "Invites"
msgstr "Invitasjoner"

msgid "Groups"
msgstr "Grupper"

msgid "Rooms"
msgstr "Rom"

msgid "Pictures"
msgstr "Bilder"

msgid "Choose your photo"
msgstr "Velg bildet ditt"

msgid "Photo updated. Everyone you're connected to will see it."
msgstr "Bildet er oppdatert. Alle du er tilkoblet, vil se det."

#, rust-format
msgid "Could not change the photo: {error}"
msgstr "Kunne ikke endre bildet: {error}"

msgid "Sign in with an access key"
msgstr "Logg inn med en tilgangsnøkkel"

msgid ""
"Paste the key the administrator gave you. It's used once, to register this "
"device."
msgstr ""
"Lim inn nøkkelen administratoren ga deg. Den brukes én gang, for å "
"registrere denne enheten."

msgid "Server URL"
msgstr "Server-URL"

msgid "Access key"
msgstr "Tilgangsnøkkel"

msgid "Device name on the network"
msgstr "Enhetsnavn i nettverket"

msgid "Cancel"
msgstr "Avbryt"

msgid "Connect"
msgstr "Koble til"

msgid ""
"The key to this account is no longer on this computer. Join with a new "
"invite."
msgstr ""
"Nøkkelen til denne kontoen finnes ikke lenger på denne datamaskinen. Bli med "
"via en ny invitasjon."

#, rust-format
msgid "Welcome back, {name}! Connecting…"
msgstr "Velkommen tilbake, {name}! Kobler til…"

#, rust-format
msgid "Error: {error}"
msgstr "Feil: {error}"

#, rust-format
msgid ""
"The account {user} no longer exists on this network. Join with a new invite."
msgstr ""
"Kontoen {user} finnes ikke lenger på dette nettverket. Bli med via en ny "
"invitasjon."

msgid "Preferences"
msgstr "Innstillinger"

msgid "General"
msgstr "Generelt"

msgid "Behaviour"
msgstr "Oppførsel"

msgid "System"
msgstr "System"

msgid "Make this user the tailscale operator"
msgstr "Gjør denne brukeren til tailscale-operatør"

msgid ""
"Lets BigLace manage the connection without asking for a password each time"
msgstr "Lar BigLace styre tilkoblingen uten å spørre om passord hver gang"

msgid "Account"
msgstr "Konto"

msgid ""
"Signing out removes this device's identity from BigLace. You will need a new "
"invite or key to join again."
msgstr ""
"Når du logger ut, fjernes denne enhetens identitet fra BigLace. Du trenger "
"en ny invitasjon eller nøkkel for å bli med igjen."

msgid "Sign out"
msgstr "Logg ut"

msgid "Connect a phone"
msgstr "Koble til en telefon"

msgid "Invites you sent"
msgstr "Invitasjoner du har sendt"

msgid "Change profile photo…"
msgstr "Endre profilbilde…"

msgid "Join with an invite"
msgstr "Bli med via invitasjon"

msgid "Sign in with panel account"
msgstr "Logg inn med panelkonto"

msgid "Leave the network…"
msgstr "Forlat nettverket…"

msgid "View tailscaled logs"
msgstr "Vis tailscaled-logger"

msgid "About BigLace"
msgstr "Om BigLace"

msgid "Connect to the network first, then open the invite link again."
msgstr "Koble til nettverket først, og åpne deretter invitasjonslenken igjen."

#, rust-format
msgid "This invite is for another network ({host}). Sign out first to join it."
msgstr ""
"Denne invitasjonen gjelder et annet nettverk ({host}). Logg ut først for å "
"bli med i det."

msgid ""
"This device is already signed in. Sign out first to join with an invite."
msgstr ""
"Denne enheten er allerede logget inn. Logg ut først for å bli med via en "
"invitasjon."

msgid "Photo removed."
msgstr "Bildet er fjernet."

#, rust-format
msgid "Could not remove the photo: {error}"
msgstr "Kunne ikke fjerne bildet: {error}"

#, rust-format
msgid "Could not open the browser: {error}"
msgstr "Kunne ikke åpne nettleseren: {error}"

msgid ""
"You can't open the admin panel: you're not an administrator of this network, "
"or the panel can't be reached."
msgstr ""
"Du kan ikke åpne administrasjonspanelet: du er ikke administrator for dette "
"nettverket, eller panelet kan ikke nås."

msgid "Enter the server URL before saving."
msgstr "Skriv inn server-URL-en før du lagrer."

msgid "Enter the pre-auth key before saving."
msgstr "Skriv inn forhåndsgodkjenningsnøkkelen før du lagrer."

msgid "Setup saved"
msgstr "Oppsett lagret"

msgid "Could not start the Tailscale service."
msgstr "Kunne ikke starte Tailscale-tjenesten."

msgid "IP address copied"
msgstr "IP-adresse kopiert"

#, rust-format
msgid ""
"Saved, but the pre-auth key could not be stored in the system keyring "
"({error}). This device can still reconnect; the key is only needed again to "
"register it anew."
msgstr ""
"Lagret, men forhåndsautentiseringsnøkkelen kunne ikke lagres i systemets "
"nøkkelring ({error}). Denne enheten kan fortsatt koble til igjen; nøkkelen "
"trengs bare på nytt for å registrere den på nytt."

msgid "Connected"
msgstr "Tilkoblet"

msgid "Service stopped"
msgstr "Tjeneste stoppet"

msgid "Not signed in"
msgstr "Ikke pålogget"

msgid "Disconnected"
msgstr "Frakoblet"

msgid "Connecting…"
msgstr "Kobler til…"

msgid "Server unreachable"
msgstr "Server utilgjengelig"

msgid "Tailscale can't set DNS"
msgstr "Tailscale kan ikke sette DNS"

#, rust-format
msgid "Update available: v{version}"
msgstr "Oppdatering tilgjengelig: v{version}"

#, rust-format
msgid "Sign in again as {user}"
msgstr "Logg inn igjen som {user}"

msgid "(no device name)"
msgstr "(ingen enhetsnavn)"

msgid "Sign in or paste a pre-auth key"
msgstr "Logg inn eller lim inn en forhåndsgodkjent nøkkel"

msgid "Server not set"
msgstr "Server ikke angitt"

msgid "Disconnect"
msgstr "Koble fra"

msgid "no other devices"
msgstr "ingen andre enheter"

#, rust-format
msgid "{online} online"
msgstr "{online} online"

#, rust-format
msgid "{online} online · {offline} offline"
msgstr "{online} online · {offline} frakoblet"

msgid "is online"
msgstr "er online"

msgid "went offline"
msgstr "gikk offline"

#, rust-format
msgid "{count} devices are online"
msgstr "{count} enheter er online"

#, rust-format
msgid "{count} devices went offline"
msgstr "{count} enheter ble offline"

#, rust-format
msgid "{on_count} online · {off_count} offline"
msgstr "{on_count} online · {off_count} offline"

msgid ""
"On the phone, open BigLace and tap “Scan QR code”, then point it at this "
"code. The phone joins as one of your devices."
msgstr ""
"Åpne BigLace på telefonen, trykk på «Skann QR-kode», og rett den mot denne "
"koden. Telefonen blir med som en av enhetene dine."

msgid "Asking the panel for a code…"
msgstr "Ber panelet om en kode…"

msgid "New code"
msgstr "Ny kode"

msgid "This code is no longer valid."
msgstr "Denne koden er ikke lenger gyldig."

#, rust-format
msgid "Valid for {time} · works once"
msgstr "Gyldig i {time} · virker én gang"

msgid ""
"This network's server doesn't pair phones yet. Ask your administrator to "
"update the panel, or invite the phone instead."
msgstr ""
"Serveren til dette nettverket kan ikke pare telefoner ennå. Be "
"administratoren din om å oppdatere panelet, eller inviter telefonen i stedet."

msgid ""
"Invites from BigLace need a BigScale server that supports them. Ask your "
"administrator to update the server, or to create the invite in the panel."
msgstr ""
"Invitasjoner fra BigLace krever en BigScale-server som støtter dem. Be "
"administratoren om å oppdatere serveren, eller om å lage invitasjonen i "
"panelet."

msgid "This device can't send invites (it isn't linked to a person's account)."
msgstr ""
"Denne enheten kan ikke sende invitasjoner (den er ikke knyttet til en "
"persons konto)."

msgid ""
"The panel knows this device by a different key (BigLace was reinstalled?). "
"Leave the network and join again to fix it."
msgstr ""
"Panelet kjenner denne enheten under en annen nøkkel (ble BigLace installert "
"på nytt?). Forlat nettverket og bli med igjen for å rette det."

msgid ""
"The panel couldn't confirm this device. Make sure BigLace is up to date and "
"stays open while connected, then try again."
msgstr ""
"Panelet kunne ikke bekrefte denne enheten. Sørg for at BigLace er oppdatert "
"og holdes åpent mens du er tilkoblet, og prøv igjen."

msgid "You are no longer in that group."
msgstr "Du er ikke lenger med i den gruppen."

msgid ""
"On this network everyone can reach everyone, so only the administrator can "
"invite people."
msgstr ""
"På dette nettverket kan alle nå alle, så bare administratoren kan invitere "
"folk."

msgid "You have too many pending invites. Cancel some or try again tomorrow."
msgstr ""
"Du har for mange ventende invitasjoner. Avbryt noen eller prøv igjen i "
"morgen."

msgid ""
"On this network only administrators invite new people. You can still invite "
"people already on the network into your groups."
msgstr ""
"På dette nettverket er det bare administratorer som inviterer nye personer. "
"Du kan fortsatt invitere personer som allerede er på nettverket, inn i "
"gruppene dine."

#, rust-format
msgid "Could not reach the panel: {error}"
msgstr "Kunne ikke nå panelet: {error}"

msgid "Waiting to be used"
msgstr "Venter på å bli brukt"

msgid "Used"
msgstr "Brukt"

msgid "Expired"
msgstr "Utløpt"

msgid "Cancelled"
msgstr "Avbrutt"

msgid "Waiting for an administrator's approval"
msgstr "Venter på godkjenning fra en administrator"

msgid "Refresh"
msgstr "Oppdater"

msgid "Main menu"
msgstr "Hovedmeny"

msgid "Bring someone to your network"
msgstr "Ta med noen inn i nettverket ditt"

msgid ""
"Create a link or QR code and send it to the person. When they join, you two "
"can reach each other's devices — no administrator needed. The link works "
"once and stays valid until it's used or you cancel it."
msgstr ""
"Lag en lenke eller QR-kode og send den til personen. Når de blir med, kan "
"dere nå hverandres enheter — uten behov for administrator. Lenken virker én "
"gang og er gyldig til den brukes eller du avbryter den."

msgid "No invites yet"
msgstr "Ingen invitasjoner ennå"

msgid "Invites unavailable"
msgstr "Invitasjoner er ikke tilgjengelige"

#, rust-format
msgid "{user} joined"
msgstr "{user} ble med"

msgid "Invite"
msgstr "Inviter"

#, rust-format
msgid "group {group}"
msgstr "gruppen {group}"

msgid "Cancel this invite: the link stops working"
msgstr "Avbryt denne invitasjonen: lenken slutter å virke"

msgid "The person you invite will reach your devices, and you theirs."
msgstr "Personen du inviterer, vil nå enhetene dine, og du deres."

msgid "Who is it for? (optional)"
msgstr "Hvem er den til? (valgfritt)"

msgid "Access"
msgstr "Tilgang"

msgid "Just the two of us"
msgstr "Bare oss to"

msgid "You see each other's devices, nobody else"
msgstr "Dere ser hverandres enheter, ingen andre"

#, rust-format
msgid "Also the group {group}"
msgstr "Også gruppen {group}"

msgid "They join the group and see everyone in it"
msgstr "De blir med i gruppen og ser alle i den"

msgid "A network of their own"
msgstr "Et eget nettverk"

msgid ""
"No link to you: they see only their own devices and whoever they invite "
"(you're the administrator)"
msgstr ""
"Ingen kobling til deg: de ser bare sine egne enheter og dem de inviterer (de "
"er administratoren)"

msgid "Create invite"
msgstr "Lag invitasjon"

msgid "QR code of the invite link"
msgstr "QR-kode for invitasjonslenken"

msgid ""
"Send the link or let the person scan the code with their phone. It works "
"once and stays valid until used or cancelled."
msgstr ""
"Send lenken eller la personen skanne koden med telefonen. Den virker én gang "
"og er gyldig til den brukes eller avbrytes."

msgid "Copy link"
msgstr "Kopier lenke"

msgid "Done"
msgstr "Ferdig"

msgid "Copied!"
msgstr "Kopiert!"

msgid ""
"This network asks an administrator to approve each invite: the link starts "
"working once they do. Its status shows in Invites."
msgstr ""
"Dette nettverket krever at en administrator godkjenner hver invitasjon: "
"lenken begynner å virke når det er gjort. Statusen vises under Invitasjoner."

msgid "Show the full sidebar"
msgstr "Vis hele sidepanelet"

msgid "Show only icons in the sidebar"
msgstr "Bare ikoner i sidepanelet"

msgid "Sections"
msgstr "Seksjoner"

msgid ""
"Your identity on this mesh — the device name shown to other peers and the "
"network you're connected to."
msgstr ""
"Din identitet i dette nettet — enhetsnavnet som vises for andre noder, og "
"nettverket du er tilkoblet."

msgid "Change photo…"
msgstr "Endre bilde…"

msgid "Remove photo"
msgstr "Fjern bilde"

msgid "Change your photo"
msgstr "Endre bildet ditt"

msgid "Rename this device on the network"
msgstr "Gi nytt navn til denne enheten i nettverket"

msgid "Advanced: use a pre-auth key"
msgstr "Avansert: bruk en forhåndsgodkjent nøkkel"

msgid "Already have a key from your administrator? Paste it here."
msgstr "Har du allerede en nøkkel fra administratoren din? Lim den inn her."

msgid ""
"Manual setup — expand to paste a server URL and pre-auth key when you "
"already received them from your administrator. Most users should sign in "
"through the panel button above instead."
msgstr ""
"Manuelt oppsett — utvid for å lime inn en server-URL og "
"forhåndsgodkjenningsnøkkel når du allerede har mottatt dem fra "
"administratoren. De fleste brukere bør logge på via panelknappen ovenfor i "
"stedet."

msgid ""
"Address of the coordination server (e.g. vpn.example.org). The https:// "
"scheme is added automatically if you omit it."
msgstr ""
"Adresse til koordineringsserveren (f.eks. vpn.example.org). Skjemaet "
"https:// legges til automatisk hvis du utelater det."

msgid "Pre-auth key"
msgstr "Forhåndsgodkjenningsnøkkel"

msgid ""
"One-time or reusable key created on the server (starts with 'hskey-auth-'). "
"Used to register this device automatically without opening a browser."
msgstr ""
"Engangs- eller gjenbrukbar nøkkel opprettet på serveren (starter med 'hskey-"
"auth-'). Brukes til å registrere denne enheten automatisk uten å åpne en "
"nettleser."

msgid ""
"The name this device shows to other peers on the VPN — this is the Tailscale "
"hostname, NOT your computer's name and NOT your user. Lowercase letters, "
"digits and hyphens. Example: 'tales-laptop', 'francois', 'office-pc'."
msgstr ""
"Navnet denne enheten viser for andre noder i VPN-en — dette er Tailscale-"
"vertsnavnet, IKKE datamaskinens navn og IKKE brukeren din. Små bokstaver, "
"sifre og bindestreker. Eksempel: 'tales-laptop', 'francois', 'office-pc'."

msgid "Apply manual setup"
msgstr "Bruk manuell oppsett"

msgid "Save"
msgstr "Lagre"

msgid ""
"Persist the server, key and device name above. Won't connect — press Connect "
"afterwards."
msgstr ""
"Lagre serveren, nøkkelen og enhetsnavnet ovenfor. Vil ikke koble til — trykk "
"Koble til etterpå."

msgid "Connect automatically"
msgstr "Koble til automatisk"

msgid "Join the network when BigLace starts"
msgstr "Bli med i nettverket når BigLace starter"

msgid ""
"When on, BigLace runs 'tailscale up' as soon as it launches, so you join the "
"mesh without clicking Connect every time."
msgstr ""
"Når på, kjører BigLace 'tailscale up' så snart den starter, slik at du blir "
"med i nettet uten å klikke Koble til hver gang."

msgid "Toggle auto-connect on startup"
msgstr "Slå på/av automatisk tilkobling ved oppstart"

msgid "Start BigLace with the session"
msgstr "Start BigLace med økten"

msgid "Open BigLace after you sign in to the desktop"
msgstr "Åpne BigLace etter at du har logget på skrivebordet"

msgid ""
"Turn this on to add BigLace to your desktop session startup. Turn it off to "
"remove it."
msgstr ""
"Slå på dette for å legge til BigLace i oppstarten av skrivebordsøkten. Slå "
"det av for å fjerne det."

msgid "Toggle start with session"
msgstr "Veksle start med økt"

msgid "Reconnect on drop"
msgstr "Gjenopprett ved frakobling"

msgid "Retry with backoff when the connection is lost"
msgstr "Prøv på nytt med backoff når tilkoblingen mistes"

msgid ""
"If the tunnel drops (network change, sleep, server hiccup), BigLace silently "
"retries with growing delays instead of leaving you offline until you notice."
msgstr ""
"Hvis tunnelen faller (nettverksendring, dvale, serverfeil), prøver BigLace "
"stille på nytt med økende forsinkelser i stedet for å la deg være frakoblet "
"til du oppdager det."

msgid "Toggle auto-reconnect"
msgstr "Slå på/av automatisk gjenoppkobling"

msgid "Notify on peer changes"
msgstr "Varsle ved peer-endringer"

msgid "Show a desktop notification when peers go online/offline"
msgstr "Vis et skrivebordsvarsel når peers går online/offline"

msgid ""
"Send a desktop toast when another device on your network goes online or "
"offline. Rapid bursts are coalesced into a single notification so you don't "
"get spammed during reconnects."
msgstr ""
"Send et skrivebordsvarsel når en annen enhet i nettverket ditt blir online "
"eller offline. Raske utbrudd samles til ett enkelt varsel slik at du ikke "
"blir oversvømmet under gjenoppkoblinger."

msgid "Toggle peer-change notifications"
msgstr "Slå på/av varsler om nodeendringer"

msgid ""
"Join or leave the mesh network. When connected, this device becomes "
"reachable by the other peers in your account."
msgstr ""
"Bli med i eller forlat maskenettverket. Når du er tilkoblet, blir denne "
"enheten tilgjengelig for de andre peerene i kontoen din."

msgid "Your photo"
msgstr "Bildet ditt"

msgid "New chat"
msgstr "Ny chat"

msgid "Start a conversation with someone on the network"
msgstr "Start en samtale med noen på nettverket"

msgid "Chat theme"
msgstr "Chattema"

msgid "Conversations"
msgstr "Samtaler"

msgid "No conversations yet."
msgstr "Ingen samtaler ennå."

msgid "Search in this conversation (Ctrl+F)"
msgstr "Søk i denne samtalen (Ctrl+F)"

msgid "Pinned message"
msgstr "Festet melding"

msgid "Unpin"
msgstr "Løsne"

msgid "Search messages"
msgstr "Søk i meldinger"

msgid "Older"
msgstr "Eldre"

msgid "Newer"
msgstr "Nyere"

msgid "Emoji"
msgstr "Emoji"

msgid "Send files, pictures or videos"
msgstr "Send filer, bilder eller videoer"

msgid "Send (Enter) — Shift+Enter for a new line"
msgstr "Send (Enter) — Shift+Enter for ny linje"

msgid "Record a voice message"
msgstr "Ta opp en talemelding"

msgid "Discard"
msgstr "Forkast"

msgid "Send voice message"
msgstr "Send talemelding"

msgid "Copy text"
msgstr "Kopier tekst"

msgid "Forward"
msgstr "Videresend"

msgid "Delete"
msgstr "Slett"

msgid "Talk with your network"
msgstr "Snakk med nettverket ditt"

msgid ""
"Pick a conversation, or start one. Messages go straight between your "
"computers — the server never sees them."
msgstr ""
"Velg en samtale, eller start en. Meldinger går rett mellom datamaskinene "
"deres — serveren ser dem aldri."

msgid "People on the network"
msgstr "Personer på nettverket"

msgid "Group"
msgstr "Gruppe"

msgid "Direct conversation"
msgstr "Direkte samtale"

msgid "That message is too long."
msgstr "Meldingen er for lang."

#, rust-format
msgid "Could not send: {error}"
msgstr "Kunne ikke sende: {error}"

#, rust-format
msgid "Could not download: {error}"
msgstr "Kunne ikke laste ned: {error}"

#, rust-format
msgid "{user} in {group}"
msgstr "{user} i {group}"

msgid "Send files"
msgstr "Send filer"

msgid "Drop to send"
msgstr "Slipp for å sende"

#, rust-format
msgid "Could not record: {error}"
msgstr "Kunne ikke ta opp: {error}"

msgid "Too short — record for at least a second."
msgstr "For kort — ta opp i minst ett sekund."

msgid "Search people and groups"
msgstr "Søk etter personer og grupper"

msgid "Loading…"
msgstr "Laster…"

msgid "Nobody you can reach yet."
msgstr "Ingen du kan nå ennå."

msgid "online"
msgstr "tilkoblet"

msgid "offline"
msgstr "frakoblet"

#, rust-format
msgid "You: {text}"
msgstr "Du: {text}"

msgid "Group conversation"
msgstr "Gruppesamtale"

#, rust-format
msgid "Delivered to {people}"
msgstr "Levert til {people}"

msgid "Waiting to be delivered"
msgstr "Venter på levering"

msgid "Today"
msgstr "I dag"

msgid "Yesterday"
msgstr "I går"

msgid "🗑 Message deleted"
msgstr "🗑 Melding slettet"

#, rust-format
msgid "Forwarded from {name}"
msgstr "Videresendt fra {name}"

msgid "edited"
msgstr "redigert"

msgid "More reactions"
msgstr "Flere reaksjoner"

msgid "Reply"
msgstr "Svar"

msgid "Edit"
msgstr "Rediger"

msgid "Pin"
msgstr "Fest"

msgid "Select"
msgstr "Velg"

#, rust-format
msgid "Could not react: {error}"
msgstr "Kunne ikke reagere: {error}"

#, rust-format
msgid "Reply to {name}"
msgstr "Svar til {name}"

msgid "Editing message"
msgstr "Redigerer melding"

msgid "Copied."
msgstr "Kopiert."

msgid "Forward to…"
msgstr "Videresend til…"

msgid "Forwarded."
msgstr "Videresendt."

#, rust-format
msgid "Could not forward: {error}"
msgstr "Kunne ikke videresende: {error}"

msgid "Delete the message?"
msgstr "Slette meldingen?"

#, rust-format
msgid "Delete {count} messages?"
msgstr "Slette {count} meldinger?"

msgid "“For everyone” removes it from the other computers too."
msgstr "«For alle» fjerner den også fra de andre datamaskinene."

msgid "It's removed from this computer only."
msgstr "Den fjernes bare fra denne datamaskinen."

msgid "Delete for me"
msgstr "Slett for meg"

msgid "Delete for everyone"
msgstr "Slett for alle"

#, rust-format
msgid "Could not delete: {error}"
