msgid "Key generated successfully."
msgstr "Clave generada con éxito."

#: src/window.rs
msgid "Service not found"
msgstr "Servicio no encontrado"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"El servicio tailscaled no se está ejecutando.\n"
"Haz clic abajo para iniciarlo."

