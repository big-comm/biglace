msgstr "Tu teléfono ya está en la red con BigLace: lee un código con él."

msgid "Rename group"
msgstr "Cambiar el nombre del grupo"

msgid "Rename {group}"
msgstr "Cambiar el nombre de {group}"

msgid "Its members, conversation, room and photo keep going under the new name."
msgstr "Sus miembros, la conversación, la sala y la foto siguen con el nombre nuevo."

msgid "Rename"
msgstr "Cambiar nombre"

msgid "The group is called {group} now."
msgstr "El grupo ahora se llama {group}."

msgid "Your phone must already be on the network, with BigLace. This computer joins the same account."
msgstr "Tu teléfono ya debe estar en la red, con BigLace. Este ordenador entra en la misma cuenta."

msgid "Network address"
msgstr "Dirección de la red"

msgid "Show the code"
msgstr "Mostrar el código"

msgid "On the phone, open BigLace, tap “Scan QR code” and point it at this code. Then confirm on the phone."
msgstr "En el teléfono, abre BigLace, toca “Escanear código QR” y apunta a este código. Luego confirma en el teléfono."

msgid "Type the network address, e.g. vpn.example.org."
msgstr "Escribe la dirección de la red, por ejemplo vpn.ejemplo.org."

msgid "Waiting for the phone · {time}"
msgstr "Esperando al teléfono · {time}"

msgid "This computer joined the account {user}."
msgstr "Este ordenador entró en la cuenta {user}."

msgid "Answer"
msgstr "Contestar"

msgid "busy"
msgstr "ocupado"

msgid "Call"
msgstr "Llamar"

msgid "Calling…"
msgstr "Llamando…"

msgid "Call {user}"
msgstr "Llamar a {user}"

msgid "Call with {user}"
msgstr "Llamada con {user}"

msgid "declined"
msgstr "rechazada"

msgid "Declined video call"
msgstr "Videollamada rechazada"

msgid "Declined voice call"
msgstr "Llamada de voz rechazada"

msgid "Hang up"
msgstr "Colgar"

msgid "In a call · {time}"
msgstr "En llamada · {time}"

msgid "Incoming video call"
msgstr "Videollamada entrante"

msgid "Incoming voice call"
msgstr "Llamada de voz entrante"

msgid "Leave the room you're in first."
msgstr "Primero sal de la sala en la que estás."

msgid "Missed video call"
msgstr "Videollamada perdida"

msgid "Missed voice call"
msgstr "Llamada de voz perdida"

msgid "no answer"
msgstr "sin respuesta"

msgid "Outgoing video call"
msgstr "Videollamada saliente"

msgid "Outgoing voice call"
msgstr "Llamada de voz saliente"

msgid "The call has ended."
msgstr "La llamada ha terminado."

msgid "{user} can't take calls right now."
msgstr "{user} no puede recibir llamadas ahora."

msgid "{user} is calling you"
msgstr "{user} te está llamando"

msgid "{user} is video calling you"
msgstr "{user} te está haciendo una videollamada"

msgid "Video call"
msgstr "Videollamada"

msgid "Video calling…"
msgstr "Videollamando…"

msgid "Voice call"
msgstr "Llamada de voz"

msgid "You're already in a call."
msgstr "Ya estás en una llamada."

msgid "Preparing the files for {name}…"
msgstr "Preparando los archivos para {name}…"

msgid "Waiting for {name} to accept…"
msgstr "Esperando a que {name} acepte…"

msgid "{user} wants to send you a file"
msgstr "{user} quiere enviarte un archivo"

msgid "{user} wants to send you {count} files"
msgstr "{user} quiere enviarte {count} archivos"

msgid "Save to…"
msgstr "Guardar en…"

msgid "Receiving files from {user}"
msgstr "Recibiendo archivos de {user}"

msgid "File received from {user}"
msgstr "Archivo recibido de {user}"

msgid "{count} files received from {user}"
msgstr "{count} archivos recibidos de {user}"

msgid "Couldn't receive the files from {user}"
msgstr "No se pudieron recibir los archivos de {user}"

msgid "{user} accepted: sending…"
msgstr "{user} aceptó: enviando…"

msgid "{user} declined the files"
msgstr "{user} rechazó los archivos"

msgid "{user} received the file"
msgstr "{user} recibió el archivo"

msgid "{user} received the {count} files"
msgstr "{user} recibió los {count} archivos"

msgid "{user} couldn't receive the files"
msgstr "{user} no pudo recibir los archivos"

msgid "Pick between 1 and {count} files."
msgstr "Elige entre 1 y {count} archivos."

msgid "{name} isn't a file."
msgstr "{name} no es un archivo."

msgid "{name} is too big (4 GB at most)."
msgstr "{name} es demasiado grande (4 GB como máximo)."

msgid "{name} has a name that can't be sent."
msgstr "{name} tiene un nombre que no se puede enviar."

msgid "{name} arrived different from the original (damaged on the way)."
msgstr "{name} llegó distinto del original (dañado por el camino)."

msgid "Send files to {name}"
msgstr "Enviar archivos a {name}"

msgid "Save the files in"
msgstr "Guardar los archivos en"

msgid "Open folder"
msgstr "Abrir carpeta"
