#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Error al definir el operador de tailscale."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "La clave de pre-autenticación fue rechazada por el servidor. Genera una nueva clave en el panel BigScale e inténtalo de nuevo."

msgid "Login rejected by server: {detail}"
msgstr "Inicio de sesión rechazado por el servidor: {detail}"
