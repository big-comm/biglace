msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Usa el usuario y la contraseña del panel BigScale para generar una clave "
"automáticamente."

#: src/window.rs
msgid "Panel URL"
msgstr "URL del panel"

