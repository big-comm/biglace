msgid "Invalid device address."
msgstr "Dirección de dispositivo no válida."

msgid ""
"No file manager could open the SFTP location. Install one (Dolphin, "
"Nautilus, Nemo, Thunar…) and try again."
msgstr ""
"Ningún gestor de archivos pudo abrir la ubicación SFTP. Instala uno "
"(Dolphin, Nautilus, Nemo, Thunar…) e inténtalo de nuevo."

msgid ""
"No file manager could open the SFTP location. Install WinSCP and try again."
msgstr ""
"Ningún gestor de archivos pudo abrir la ubicación SFTP. Instala WinSCP e "
"inténtalo de nuevo."

msgid ""
"No terminal emulator found. Install one (Konsole, GNOME Terminal, xterm…) "
"and try again."
msgstr ""
"No se encontró ningún emulador de terminal. Instala uno (Konsole, GNOME "
"Terminal, xterm…) e inténtalo de nuevo."

msgid "Failed to run tailscale"
msgstr "Error al ejecutar tailscale"

msgid "Failed to connect — check the server URL and key."
msgstr "Error al conectar — revisa el servidor y la clave."

msgid "Failed to run pkexec tailscale"
msgstr "Error al ejecutar pkexec tailscale"

msgid "Enter the server URL before connecting."
msgstr "Ingresa la URL del servidor antes de conectarte."

msgid ""
"The pre-auth key was rejected by the server. Generate a new key in the "
"BigScale panel and try again."
msgstr ""
"La clave de pre-autenticación fue rechazada por el servidor. Genera una "
"nueva clave en el panel BigScale e inténtalo de nuevo."

msgid "Sign in or paste a pre-auth key first."
msgstr "Primero inicie sesión o pegue una clave de preautenticación."

#, rust-format
msgid "Login rejected by server: {detail}"
msgstr "Inicio de sesión rechazado por el servidor: {detail}"

msgid "Could not determine the current user."
msgstr "No se pudo determinar el usuario actual."

msgid "Failed to run pkexec tailscale set"
msgstr "Error al ejecutar pkexec tailscale set"

msgid "Failed to set tailscale operator."
msgstr "Error al definir el operador de tailscale."

msgid "Invite someone"
msgstr "Invitar a alguien"

msgid "Open admin panel"
msgstr "Abrir el panel de administración"

msgid "Devices"
msgstr "Dispositivos"

msgid "Chat"
msgstr "Chat"

msgid "Invites"
msgstr "Invitaciones"

msgid "Groups"
msgstr "Grupos"

msgid "Rooms"
msgstr "Salas"

msgid "Pictures"
msgstr "Imágenes"

msgid "Choose your photo"
msgstr "Elige tu foto"

msgid "Photo updated. Everyone you're connected to will see it."
msgstr "Foto actualizada. Todos con los que estás conectado la verán."

#, rust-format
msgid "Could not change the photo: {error}"
msgstr "No se pudo cambiar la foto: {error}"

msgid "Sign in with an access key"
msgstr "Iniciar sesión con una clave de acceso"

msgid ""
"Paste the key the administrator gave you. It's used once, to register this "
"device."
msgstr ""
"Pega la clave que te dio el administrador. Se usa una sola vez, para "
"registrar este dispositivo."

msgid "Server URL"
msgstr "URL del servidor"

msgid "Access key"
msgstr "Clave de acceso"

msgid "Device name on the network"
msgstr "Nombre del dispositivo en la red"

msgid "Cancel"
msgstr "Cancelar"

msgid "Connect"
msgstr "Conectar"

msgid ""
"The key to this account is no longer on this computer. Join with a new "
"invite."
msgstr ""
"La clave de esta cuenta ya no está en este equipo. Únete con una nueva "
"invitación."

#, rust-format
msgid "Welcome back, {name}! Connecting…"
msgstr "¡Bienvenido de nuevo, {name}! Conectando…"

#, rust-format
msgid "Error: {error}"
msgstr "Error: {error}"

#, rust-format
msgid ""
"The account {user} no longer exists on this network. Join with a new invite."
msgstr ""
"La cuenta {user} ya no existe en esta red. Únete con una nueva invitación."

msgid "Preferences"
msgstr "Preferencias"

msgid "General"
msgstr "General"

msgid "Behaviour"
msgstr "Comportamiento"

msgid "System"
msgstr "Sistema"

msgid "Make this user the tailscale operator"
msgstr "Hacer a este usuario operador de tailscale"

msgid ""
"Lets BigLace manage the connection without asking for a password each time"
msgstr "Permite que BigLace gestione la conexión sin pedir contraseña cada vez"

msgid "Account"
msgstr "Cuenta"

msgid ""
"Signing out removes this device's identity from BigLace. You will need a new "
"invite or key to join again."
msgstr ""
"Cerrar sesión elimina la identidad de este dispositivo de BigLace. "
"Necesitarás una nueva invitación o clave para volver a unirte."

msgid "Sign out"
msgstr "Cerrar sesión"

msgid "Connect a phone"
msgstr "Conectar un teléfono"

msgid "Invites you sent"
msgstr "Invitaciones que enviaste"

msgid "Change profile photo…"
msgstr "Cambiar foto de perfil…"

msgid "Join with an invite"
msgstr "Unirse con una invitación"

msgid "Sign in with panel account"
msgstr "Iniciar sesión con cuenta del panel"

msgid "Leave the network…"
msgstr "Salir de la red…"

msgid "View tailscaled logs"
msgstr "Ver registros de tailscaled"

msgid "About BigLace"
msgstr "Acerca de BigLace"

msgid "Connect to the network first, then open the invite link again."
msgstr ""
"Conéctate primero a la red y luego vuelve a abrir el enlace de invitación."

#, rust-format
msgid "This invite is for another network ({host}). Sign out first to join it."
msgstr ""
"Esta invitación es para otra red ({host}). Cierra sesión primero para unirte "
"a ella."

msgid ""
"This device is already signed in. Sign out first to join with an invite."
msgstr ""
"Este dispositivo ya ha iniciado sesión. Cierra sesión primero para unirte "
"con una invitación."

msgid "Photo removed."
msgstr "Foto eliminada."

#, rust-format
msgid "Could not remove the photo: {error}"
msgstr "No se pudo eliminar la foto: {error}"

#, rust-format
msgid "Could not open the browser: {error}"
msgstr "No se pudo abrir el navegador: {error}"

msgid ""
"You can't open the admin panel: you're not an administrator of this network, "
"or the panel can't be reached."
msgstr ""
"No puedes abrir el panel de administración: no eres administrador de esta "
"red o no se puede acceder al panel."

msgid "Enter the server URL before saving."
msgstr "Ingresa la URL del servidor antes de guardar."

msgid "Enter the pre-auth key before saving."
msgstr "Ingresa la clave de preautorización antes de guardar."

msgid "Setup saved"
msgstr "Configuración guardada"

msgid "Could not start the Tailscale service."
msgstr "No se pudo iniciar el servicio de Tailscale."

msgid "IP address copied"
msgstr "Dirección IP copiada"

#, rust-format
msgid ""
"Saved, but the pre-auth key could not be stored in the system keyring "
"({error}). This device can still reconnect; the key is only needed again to "
"register it anew."
msgstr ""
"Guardado, pero la clave de preautenticación no se pudo almacenar en el "
"llavero del sistema ({error}). Este dispositivo aún puede reconectarse; la "
"clave solo se necesita de nuevo para registrarlo otra vez."

msgid "Connected"
msgstr "Conectado"

msgid "Service stopped"
msgstr "Servicio detenido"

msgid "Not signed in"
msgstr "No has iniciado sesión"

msgid "Disconnected"
msgstr "Desconectado"

msgid "Connecting…"
msgstr "Conectando…"

msgid "Server unreachable"
msgstr "Servidor inalcanzable"

msgid "Tailscale can't set DNS"
msgstr "Tailscale no puede configurar el DNS"

#, rust-format
msgid "Update available: v{version}"
msgstr "Actualización disponible: v{version}"

#, rust-format
msgid "Sign in again as {user}"
msgstr "Iniciar sesión de nuevo como {user}"

msgid "(no device name)"
msgstr "(sin nombre de dispositivo)"

msgid "Sign in or paste a pre-auth key"
msgstr "Inicie sesión o pegue una clave de preautenticación"

msgid "Server not set"
msgstr "Servidor no establecido"

msgid "Disconnect"
msgstr "Salir de la red"

msgid "no other devices"
msgstr "ningún otro dispositivo"

#, rust-format
msgid "{online} online"
msgstr "{online} en línea"

#, rust-format
msgid "{online} online · {offline} offline"
msgstr "{online} en línea · {offline} sin conexión"

msgid "is online"
msgstr "está en línea"

msgid "went offline"
msgstr "se desconectó"

#, rust-format
msgid "{count} devices are online"
msgstr "{count} dispositivos están en línea"

#, rust-format
msgid "{count} devices went offline"
msgstr "{count} dispositivos se desconectaron"

#, rust-format
msgid "{on_count} online · {off_count} offline"
msgstr "{on_count} en línea · {off_count} desconectados"

msgid ""
"On the phone, open BigLace and tap “Scan QR code”, then point it at this "
"code. The phone joins as one of your devices."
msgstr ""
"En el teléfono, abre BigLace y toca «Escanear código QR», luego apúntalo a "
"este código. El teléfono se une como uno de tus dispositivos."

msgid "Asking the panel for a code…"
msgstr "Pidiendo un código al panel…"

msgid "New code"
msgstr "Nuevo código"

msgid "This code is no longer valid."
msgstr "Este código ya no es válido."

#, rust-format
msgid "Valid for {time} · works once"
msgstr "Válido durante {time} · funciona una vez"

msgid ""
"This network's server doesn't pair phones yet. Ask your administrator to "
"update the panel, or invite the phone instead."
msgstr ""
"El servidor de esta red aún no empareja teléfonos. Pide a tu administrador "
"que actualice el panel o, en su lugar, invita al teléfono."

msgid ""
"Invites from BigLace need a BigScale server that supports them. Ask your "
"administrator to update the server, or to create the invite in the panel."
msgstr ""
"Las invitaciones desde BigLace necesitan un servidor BigScale que las "
"admita. Pide a tu administrador que actualice el servidor o que cree la "
"invitación en el panel."

msgid "This device can't send invites (it isn't linked to a person's account)."
msgstr ""
"Este dispositivo no puede enviar invitaciones (no está vinculado a la cuenta "
"de una persona)."

msgid ""
"The panel knows this device by a different key (BigLace was reinstalled?). "
"Leave the network and join again to fix it."
msgstr ""
"El panel conoce este dispositivo con otra clave (¿se reinstaló BigLace?). "
"Sal de la red y vuelve a unirte para solucionarlo."

msgid ""
"The panel couldn't confirm this device. Make sure BigLace is up to date and "
"stays open while connected, then try again."
msgstr ""
"El panel no pudo confirmar este dispositivo. Asegúrate de que BigLace está "
"actualizado y permanece abierto mientras estás conectado, y vuelve a "
"intentarlo."

msgid "You are no longer in that group."
msgstr "Ya no estás en ese grupo."

msgid ""
"On this network everyone can reach everyone, so only the administrator can "
"invite people."
msgstr ""
"En esta red todos pueden alcanzar a todos, así que solo el administrador "
"puede invitar a personas."

msgid "You have too many pending invites. Cancel some or try again tomorrow."
msgstr ""
"Tienes demasiadas invitaciones pendientes. Cancela algunas o inténtalo "
"mañana."

msgid ""
"On this network only administrators invite new people. You can still invite "
"people already on the network into your groups."
msgstr ""
"En esta red solo los administradores invitan a personas nuevas. Aun así "
"puedes invitar a tus grupos a personas que ya están en la red."

#, rust-format
msgid "Could not reach the panel: {error}"
msgstr "No se pudo contactar con el panel: {error}"

msgid "Waiting to be used"
msgstr "Pendiente de uso"

msgid "Used"
msgstr "Usada"

msgid "Expired"
msgstr "Caducada"

msgid "Cancelled"
msgstr "Cancelada"

msgid "Waiting for an administrator's approval"
msgstr "Pendiente de aprobación de un administrador"

msgid "Refresh"
msgstr "Actualizar"

msgid "Main menu"
msgstr "Menú principal"

msgid "Bring someone to your network"
msgstr "Trae a alguien a tu red"

msgid ""
"Create a link or QR code and send it to the person. When they join, you two "
"can reach each other's devices — no administrator needed. The link works "
"once and stays valid until it's used or you cancel it."
msgstr ""
"Crea un enlace o código QR y envíalo a la persona. Cuando se una, podréis "
"acceder a los dispositivos del otro — sin necesidad de administrador. El "
"enlace funciona una vez y sigue siendo válido hasta que se use o lo canceles."

msgid "No invites yet"
msgstr "Aún no hay invitaciones"

msgid "Invites unavailable"
msgstr "Invitaciones no disponibles"

#, rust-format
msgid "{user} joined"
msgstr "{user} se unió"

msgid "Invite"
msgstr "Invitar"

#, rust-format
msgid "group {group}"
msgstr "grupo {group}"

msgid "Cancel this invite: the link stops working"
msgstr "Cancelar esta invitación: el enlace deja de funcionar"

msgid "The person you invite will reach your devices, and you theirs."
msgstr "La persona que invites accederá a tus dispositivos, y tú a los suyos."

msgid "Who is it for? (optional)"
msgstr "¿Para quién es? (opcional)"

msgid "Access"
msgstr "Acceso"

msgid "Just the two of us"
msgstr "Solo nosotros dos"

msgid "You see each other's devices, nobody else"
msgstr "Os veis los dispositivos mutuamente, nadie más"

#, rust-format
msgid "Also the group {group}"
msgstr "También el grupo {group}"

msgid "They join the group and see everyone in it"
msgstr "Se une al grupo y ve a todos en él"

msgid "A network of their own"
msgstr "Una red propia"

msgid ""
"No link to you: they see only their own devices and whoever they invite "
"(you're the administrator)"
msgstr ""
"Sin vínculo contigo: solo ve sus propios dispositivos y a quien invite (tú "
"eres el administrador)"

msgid "Create invite"
msgstr "Crear invitación"

msgid "QR code of the invite link"
msgstr "Código QR del enlace de invitación"

msgid ""
"Send the link or let the person scan the code with their phone. It works "
"once and stays valid until used or cancelled."
msgstr ""
"Envía el enlace o deja que la persona escanee el código con su móvil. "
"Funciona una vez y sigue siendo válido hasta que se use o se cancele."

msgid "Copy link"
msgstr "Copiar enlace"

msgid "Done"
msgstr "Listo"

msgid "Copied!"
msgstr "¡Copiado!"

msgid ""
"This network asks an administrator to approve each invite: the link starts "
"working once they do. Its status shows in Invites."
msgstr ""
"Esta red requiere que un administrador apruebe cada invitación: el enlace "
"empieza a funcionar cuando lo haga. Su estado aparece en Invitaciones."

msgid "Show the full sidebar"
msgstr "Mostrar la barra lateral completa"

msgid "Show only icons in the sidebar"
msgstr "Mostrar solo iconos en la barra lateral"

msgid "Sections"
msgstr "Secciones"

msgid ""
"Your identity on this mesh — the device name shown to other peers and the "
"network you're connected to."
msgstr ""
"Tu identidad en esta malla: el nombre del dispositivo que ven otros pares y "
"la red a la que estás conectado."

msgid "Change photo…"
msgstr "Cambiar foto…"

msgid "Remove photo"
msgstr "Eliminar foto"

msgid "Change your photo"
msgstr "Cambiar tu foto"

msgid "Rename this device on the network"
msgstr "Cambiar el nombre de este dispositivo en la red"

msgid "Advanced: use a pre-auth key"
msgstr "Avanzado: usar una clave de preautorización"

msgid "Already have a key from your administrator? Paste it here."
msgstr "¿Ya tienes una clave de tu administrador? Pégala aquí."

msgid ""
"Manual setup — expand to paste a server URL and pre-auth key when you "
"already received them from your administrator. Most users should sign in "
"through the panel button above instead."
msgstr ""
"Configuración manual: despliega para pegar la URL del servidor y la clave de "
"preautorización si ya las recibiste de tu administrador. La mayoría de "
"usuarios deberían iniciar sesión mediante el botón del panel superior."

msgid ""
"Address of the coordination server (e.g. vpn.example.org). The https:// "
"scheme is added automatically if you omit it."
msgstr ""
"Dirección del servidor de coordinación (ej. vpn.example.org). El esquema "
"https:// se añade automáticamente si lo omites."

msgid "Pre-auth key"
msgstr "Clave de preautorización"

msgid ""
"One-time or reusable key created on the server (starts with 'hskey-auth-'). "
"Used to register this device automatically without opening a browser."
msgstr ""
"Clave de un solo uso o reutilizable creada en el servidor (comienza con "
"'hskey-auth-'). Se usa para registrar este dispositivo automáticamente sin "
"abrir un navegador."

msgid ""
"The name this device shows to other peers on the VPN — this is the Tailscale "
"hostname, NOT your computer's name and NOT your user. Lowercase letters, "
"digits and hyphens. Example: 'tales-laptop', 'francois', 'office-pc'."
msgstr ""
"El nombre con el que este dispositivo se muestra a otros pares en la VPN: "
"este es el nombre de host de Tailscale, NO el nombre de tu computadora ni tu "
"usuario. Letras minúsculas, dígitos y guiones. Ejemplo: 'tales-laptop', "
"'francois', 'office-pc'."

msgid "Apply manual setup"
msgstr "Aplicar configuración manual"

msgid "Save"
msgstr "Guardar"

msgid ""
"Persist the server, key and device name above. Won't connect — press Connect "
"afterwards."
msgstr ""
"Guarda el servidor, la clave y el nombre del dispositivo de arriba. No se "
"conectará; presiona Conectar después."

msgid "Connect automatically"
msgstr "Conectar automáticamente"

msgid "Join the network when BigLace starts"
msgstr "Unirse a la red al iniciar BigLace"

msgid ""
"When on, BigLace runs 'tailscale up' as soon as it launches, so you join the "
"mesh without clicking Connect every time."
msgstr ""
"Cuando está activado, BigLace ejecuta 'tailscale up' al iniciarse, para que "
"te unas a la malla sin tener que hacer clic en Conectar cada vez."

msgid "Toggle auto-connect on startup"
msgstr "Activar/desactivar reconexión automática al inicio"

msgid "Start BigLace with the session"
msgstr "Iniciar BigLace con la sesión"

msgid "Open BigLace after you sign in to the desktop"
msgstr "Abrir BigLace después de iniciar sesión en el escritorio"

msgid ""
"Turn this on to add BigLace to your desktop session startup. Turn it off to "
"remove it."
msgstr ""
"Activa esto para agregar BigLace al inicio de tu sesión de escritorio. "
"Desactívalo para eliminarlo."

msgid "Toggle start with session"
msgstr "Alternar inicio con sesión"

msgid "Reconnect on drop"
msgstr "Reconectar al caer"

msgid "Retry with backoff when the connection is lost"
msgstr "Reintentar con espera progresiva cuando se pierda la conexión"

msgid ""
"If the tunnel drops (network change, sleep, server hiccup), BigLace silently "
"retries with growing delays instead of leaving you offline until you notice."
msgstr ""
"Si el túnel se cae (cambio de red, suspensión, fallo del servidor), BigLace "
"reintenta silenciosamente con demoras crecientes, en lugar de dejarte "
"desconectado hasta que lo notes."

msgid "Toggle auto-reconnect"
msgstr "Activar/desactivar reconexión automática"

msgid "Notify on peer changes"
msgstr "Notificar cambios entre pares"

msgid "Show a desktop notification when peers go online/offline"
msgstr ""
"Mostrar una notificación de escritorio cuando los pares se conecten/"
"desconecten"

msgid ""
"Send a desktop toast when another device on your network goes online or "
"offline. Rapid bursts are coalesced into a single notification so you don't "
"get spammed during reconnects."
msgstr ""
"Enviar una notificación de escritorio cuando otro dispositivo de tu red se "
"conecte o desconecte. Los picos rápidos se agrupan en una sola notificación "
"para que no te saturen durante las reconexiones."

msgid "Toggle peer-change notifications"
msgstr "Activar/desactivar notificaciones de cambios entre pares"

msgid ""
"Join or leave the mesh network. When connected, this device becomes "
"reachable by the other peers in your account."
msgstr ""
"Unirse o salir de la red mesh. Cuando está conectado, este dispositivo es "
"accesible para los otros pares en su cuenta."

msgid "Your photo"
msgstr "Tu foto"

msgid "New chat"
msgstr "Nuevo chat"

msgid "Start a conversation with someone on the network"
msgstr "Inicia una conversación con alguien de la red"

msgid "Chat theme"
msgstr "Tema del chat"

msgid "Conversations"
msgstr "Conversaciones"

msgid "No conversations yet."
msgstr "Aún no hay conversaciones."

msgid "Search in this conversation (Ctrl+F)"
msgstr "Buscar en esta conversación (Ctrl+F)"

msgid "Pinned message"
msgstr "Mensaje fijado"

msgid "Unpin"
msgstr "Desfijar"

msgid "Search messages"
msgstr "Buscar mensajes"

msgid "Older"
msgstr "Anterior"

msgid "Newer"
msgstr "Siguiente"

msgid "Emoji"
msgstr "Emoji"

msgid "Send files, pictures or videos"
msgstr "Enviar archivos, imágenes o vídeos"

msgid "Send (Enter) — Shift+Enter for a new line"
msgstr "Enviar (Enter) — Shift+Enter para una nueva línea"

msgid "Record a voice message"
msgstr "Grabar un mensaje de voz"

msgid "Discard"
msgstr "Descartar"

msgid "Send voice message"
msgstr "Enviar mensaje de voz"

msgid "Copy text"
msgstr "Copiar texto"

msgid "Forward"
msgstr "Reenviar"

msgid "Delete"
msgstr "Eliminar"

msgid "Talk with your network"
msgstr "Habla con tu red"

msgid ""
"Pick a conversation, or start one. Messages go straight between your "
"computers — the server never sees them."
msgstr ""
"Elige una conversación o inicia una. Los mensajes van directamente entre tus "
"equipos — el servidor nunca los ve."

msgid "People on the network"
msgstr "Personas en la red"

msgid "Group"
msgstr "Grupo"

msgid "Direct conversation"
msgstr "Conversación directa"

msgid "That message is too long."
msgstr "Ese mensaje es demasiado largo."

#, rust-format
msgid "Could not send: {error}"
msgstr "No se pudo enviar: {error}"

#, rust-format
msgid "Could not download: {error}"
msgstr "No se pudo descargar: {error}"

#, rust-format
msgid "{user} in {group}"
msgstr "{user} en {group}"

msgid "Send files"
msgstr "Enviar archivos"

msgid "Drop to send"
msgstr "Suelta para enviar"

#, rust-format
msgid "Could not record: {error}"
msgstr "No se pudo grabar: {error}"

msgid "Too short — record for at least a second."
msgstr "Demasiado corto — graba al menos un segundo."

msgid "Search people and groups"
msgstr "Buscar personas y grupos"

msgid "Loading…"
msgstr "Cargando…"

msgid "Nobody you can reach yet."
msgstr "Todavía no hay nadie a tu alcance."

msgid "online"
msgstr "en línea"

msgid "offline"
msgstr "sin conexión"

#, rust-format
msgid "You: {text}"
msgstr "Tú: {text}"

msgid "Group conversation"
msgstr "Conversación de grupo"

#, rust-format
msgid "Delivered to {people}"
msgstr "Entregado a {people}"

msgid "Waiting to be delivered"
msgstr "Pendiente de entrega"

msgid "Today"
msgstr "Hoy"

msgid "Yesterday"
msgstr "Ayer"

msgid "🗑 Message deleted"
msgstr "🗑 Mensaje eliminado"

#, rust-format
msgid "Forwarded from {name}"
msgstr "Reenviado de {name}"

msgid "edited"
msgstr "editado"

msgid "More reactions"
msgstr "Más reacciones"

msgid "Reply"
msgstr "Responder"

msgid "Edit"
msgstr "Editar"

msgid "Pin"
msgstr "Fijar"

msgid "Select"
msgstr "Seleccionar"

#, rust-format
msgid "Could not react: {error}"
msgstr "No se pudo reaccionar: {error}"

#, rust-format
msgid "Reply to {name}"
msgstr "Respuesta a {name}"

msgid "Editing message"
msgstr "Editando mensaje"

msgid "Copied."
msgstr "Copiado."

msgid "Forward to…"
msgstr "Reenviar a…"

msgid "Forwarded."
msgstr "Reenviado."

#, rust-format
msgid "Could not forward: {error}"
msgstr "No se pudo reenviar: {error}"

msgid "Delete the message?"
msgstr "¿Eliminar el mensaje?"

#, rust-format
msgid "Delete {count} messages?"
msgstr "¿Eliminar {count} mensajes?"

msgid "“For everyone” removes it from the other computers too."
msgstr "«Para todos» lo elimina también de los otros equipos."

msgid "It's removed from this computer only."
msgstr "Se elimina solo de este equipo."

msgid "Delete for me"
msgstr "Eliminar para mí"

msgid "Delete for everyone"
msgstr "Eliminar para todos"

#, rust-format
msgid "Could not delete: {error}"
msgstr "No se pudo eliminar: {error}"

msgid "1 selected"
msgstr "1 seleccionado"

#, rust-format
msgid "{count} selected"
