#: src/window.rs
msgid "Disconnect"
msgstr "Rozłącz"

#: src/window.rs
msgid "Refresh list"
msgstr "Odśwież listę"

#: src/window.rs
msgid "Main menu"
msgstr "Menu główne"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Zaloguj się przez konto panelu"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "Ustaw tego użytkownika jako operatora Tailscale"

#: src/window.rs
msgid "About BigLace"
msgstr "O aplikacji BigLace"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Operator Tailscale"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr ""
"Gotowe. Nie będziesz już potrzebować hasła do łączenia lub rozłączania."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Niepowodzenie: {error}"

#: src/window.rs
msgid "OK"
msgstr "OK"

#: src/window.rs
msgid "Error: {error}"
msgstr "Błąd: {error}"

#: src/window.rs
msgid "Files"
msgstr "Pliki"

#: src/window.rs
msgid "Terminal"
msgstr "Terminal"

#: src/window.rs
msgid "Copied!"
msgstr "Skopiowano!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Klient VPN typu mesh dla BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "Dane logowania do panelu"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Użyj nazwy użytkownika i hasła z panelu BigScale, aby automatycznie "
"wygenerować klucz."

#: src/window.rs
msgid "Panel URL"
msgstr "Adres URL panelu"

#: src/window.rs
msgid "Username"
msgstr "Nazwa użytkownika"

#: src/window.rs
msgid "Password"
msgstr "Hasło"

#: src/window.rs
msgid "Network user identifier"
msgstr "Identyfikator użytkownika sieci"

#: src/window.rs
msgid "Cancel"
msgstr "Anuluj"

#: src/window.rs
msgid "Sign in"
msgstr "Zaloguj się"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Wprowadź adres URL, nazwę użytkownika i hasło."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Klucz został pomyślnie wygenerowany."

#: src/window.rs
msgid "Service not found"
msgstr "Nie znaleziono usługi"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"Usługa tailscaled nie jest uruchomiona.\n"
"Kliknij poniżej, aby ją uruchomić."

#: src/window.rs
msgid "Start service"
msgstr "Uruchom usługę"

#: src/window.rs
msgid "Server"
msgstr "Serwer"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "Adres Twojego serwera BigScale/Headscale."

#: src/window.rs
msgid "Server URL"
msgstr "Adres serwera"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Twoja tożsamość w sieci"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Osobisty klucz wygenerowany dla Ciebie w panelu BigScale (\"Nowy klucz\" w "
"sekcji Użytkownicy). Każda osoba używa własnego – nie jest to klucz serwera."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Klucz wstępnej autoryzacji (Twój)"

#: src/window.rs
msgid "This device"
msgstr "To urządzenie"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Nazwa widoczna dla innych urządzeń w sieci."

#: src/window.rs
msgid "Device name"
msgstr "Nazwa urządzenia"

#: src/window.rs
msgid "Options"
msgstr "Opcje"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Łącz automatycznie przy starcie"

#: src/window.rs
msgid "Connect"
msgstr "Połącz"

#: src/window.rs
msgid "Please wait..."
msgstr "Proszę czekać..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Połączono z siecią"

#: src/window.rs
msgid "Your IP address"
msgstr "Twój adres IP"

#: src/window.rs
msgid "Devices on the network"
msgstr "Urządzenia w sieci"

#: src/window.rs
msgid "No other devices found."
msgstr "Nie znaleziono innych urządzeń."

#: src/window.rs
msgid "Copy"
msgstr "Kopiuj"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Nie udało się uruchomić tailscale"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Nie udało się połączyć — sprawdź adres URL serwera i klucz."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Nie udało się uruchomić pkexec tailscale"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Nie można określić bieżącego użytkownika."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Nie udało się uruchomić pkexec tailscale set"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Nie udało się ustawić operatora tailscale."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Klucz wstępnej autoryzacji został odrzucony przez serwer. Wygeneruj nowy klucz w panelu BigScale i spróbuj ponownie."

msgid "Login rejected by server: {detail}"
msgstr "Logowanie odrzucone przez serwer: {detail}"
