msgstr "Preencha URL, nome de usuário e senha."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Chave gerada com sucesso."

#: src/window.rs
msgid "Service not found"
msgstr "Serviço não encontrado"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"O serviço tailscaled não está em execução.\n"
"Clique abaixo para iniciá-lo."

#: src/window.rs
msgid "Start service"
msgstr "Iniciar serviço"

#: src/window.rs
msgid "Server"
msgstr "Servidor"

