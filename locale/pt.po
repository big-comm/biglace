msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Chave pessoal gerada para você no painel do BigScale (\"Nova chave\" em "
"Usuários). Cada pessoa usa a sua própria — esta não é a chave do servidor."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Chave de pré-autenticação (sua)"

#: src/window.rs
msgid "This device"
msgstr "Este dispositivo"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Nome exibido para outros dispositivos na rede."

