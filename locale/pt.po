msgid "Panel credentials"
msgstr "Credenciais do painel"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Use seu nome de usuário e senha do painel BigScale para gerar uma chave "
"automaticamente."

#: src/window.rs
msgid "Panel URL"
msgstr "URL do painel"

#: src/window.rs
msgid "Username"
msgstr "Nome de usuário"

#: src/window.rs
msgid "Password"
msgstr "Senha"

