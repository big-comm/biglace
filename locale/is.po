msgid "Invalid device address."
msgstr "Ógilt vistfang tækis."

msgid ""
"No file manager could open the SFTP location. Install one (Dolphin, "
"Nautilus, Nemo, Thunar…) and try again."
msgstr ""
"Enginn skráastjóri gat opnað SFTP-staðsetninguna. Settu einn upp (Dolphin, "
"Nautilus, Nemo, Thunar…) og reyndu aftur."

msgid ""
"No file manager could open the SFTP location. Install WinSCP and try again."
msgstr ""
"Enginn skráastjóri gat opnað SFTP-staðsetninguna. Settu upp WinSCP og reyndu "
"aftur."

msgid ""
"No terminal emulator found. Install one (Konsole, GNOME Terminal, xterm…) "
"and try again."
msgstr ""
"Enginn útstöðvarhermir fannst. Settu einn upp (Konsole, GNOME Terminal, "
"xterm…) og reyndu aftur."

msgid "Failed to run tailscale"
msgstr "Mistókst að keyra tailscale"

msgid "Failed to connect — check the server URL and key."
msgstr "Mistókst að tengjast — athugaðu vefslóð þjónsins og lykilinn."

msgid "Failed to run pkexec tailscale"
msgstr "Mistókst að keyra pkexec tailscale"

msgid "Enter the server URL before connecting."
msgstr "Sláðu inn vefslóð þjónsins áður en þú tengist."

msgid ""
"The pre-auth key was rejected by the server. Generate a new key in the "
"BigScale panel and try again."
msgstr ""
"Forauðkenningarlykli var hafnað af þjóninum. Búðu til nýjan lykil í BigScale-"
"stjórnborðinu og reyndu aftur."

msgid "Sign in or paste a pre-auth key first."
msgstr "Skráðu þig fyrst inn eða límdu forvottaðan lykil."

#, rust-format
msgid "Login rejected by server: {detail}"
msgstr "Innskráningu hafnað af þjóni: {detail}"

msgid "Could not determine the current user."
msgstr "Gat ekki ákvarðað núverandi notanda."

msgid "Failed to run pkexec tailscale set"
msgstr "Mistókst að keyra pkexec tailscale set"

msgid "Failed to set tailscale operator."
msgstr "Mistókst að stilla tailscale stjórnanda."

msgid "Invite someone"
msgstr "Bjóða einhverjum"

msgid "Open admin panel"
msgstr "Opna stjórnborð"

msgid "Devices"
msgstr "Tæki"

msgid "Chat"
msgstr "Spjall"

msgid "Invites"
msgstr "Boð"

msgid "Groups"
msgstr "Hópar"

msgid "Rooms"
msgstr "Herbergi"

msgid "Pictures"
msgstr "Myndir"

msgid "Choose your photo"
msgstr "Veldu myndina þína"

msgid "Photo updated. Everyone you're connected to will see it."
msgstr "Mynd uppfærð. Allir sem þú ert tengd(ur) við munu sjá hana."

#, rust-format
msgid "Could not change the photo: {error}"
msgstr "Ekki tókst að breyta myndinni: {error}"

msgid "Sign in with an access key"
msgstr "Skrá inn með aðgangslykli"

msgid ""
"Paste the key the administrator gave you. It's used once, to register this "
"device."
msgstr ""
"Límdu inn lykilinn sem kerfisstjórinn lét þig fá. Hann er notaður einu "
"sinni, til að skrá þetta tæki."

msgid "Server URL"
msgstr "Vefslóð þjóns"

msgid "Access key"
msgstr "Aðgangslykill"

msgid "Device name on the network"
msgstr "Tækjaheiti á netinu"

msgid "Cancel"
msgstr "Hætta við"

msgid "Connect"
msgstr "Tengjast"

msgid ""
"The key to this account is no longer on this computer. Join with a new "
"invite."
msgstr ""
"Lykillinn að þessum aðgangi er ekki lengur á þessari tölvu. Gakktu í netið "
"með nýju boði."

#, rust-format
msgid "Welcome back, {name}! Connecting…"
msgstr "Velkomin(n) aftur, {name}! Tengist…"

#, rust-format
msgid "Error: {error}"
msgstr "Villa: {error}"

#, rust-format
msgid ""
"The account {user} no longer exists on this network. Join with a new invite."
msgstr ""
"Aðgangurinn {user} er ekki lengur til á þessu neti. Gakktu í netið með nýju "
"boði."

msgid "Preferences"
msgstr "Kjörstillingar"

msgid "General"
msgstr "Almennt"

msgid "Behaviour"
msgstr "Hegðun"

msgid "System"
msgstr "Kerfi"

msgid "Make this user the tailscale operator"
msgstr "Gerðu þennan notanda að tailscale-stjórnanda"

msgid ""
"Lets BigLace manage the connection without asking for a password each time"
msgstr ""
"Leyfir BigLace að stjórna tengingunni án þess að biðja um lykilorð í hvert "
"sinn"

msgid "Account"
msgstr "Aðgangur"

msgid ""
"Signing out removes this device's identity from BigLace. You will need a new "
"invite or key to join again."
msgstr ""
"Útskráning fjarlægir auðkenni þessa tækis úr BigLace. Þú þarft nýtt boð eða "
"lykil til að ganga aftur í netið."

msgid "Sign out"
msgstr "Skrá út"

msgid "Connect a phone"
msgstr "Tengja síma"

msgid "Invites you sent"
msgstr "Boð sem þú sendir"

msgid "Change profile photo…"
msgstr "Breyta prófílmynd…"

msgid "Join with an invite"
msgstr "Ganga í með boði"

msgid "Sign in with panel account"
msgstr "Skráðu þig inn með panel-reikningi"

msgid "Leave the network…"
msgstr "Yfirgefa netið…"

msgid "View tailscaled logs"
msgstr "Skoða tailscaled annála"

msgid "About BigLace"
msgstr "Um BigLace"

msgid "Connect to the network first, then open the invite link again."
msgstr "Tengstu fyrst netinu og opnaðu svo boðstengilinn aftur."

#, rust-format
msgid "This invite is for another network ({host}). Sign out first to join it."
msgstr ""
"Þetta boð er fyrir annað net ({host}). Skráðu þig fyrst út til að ganga í "
"það."

msgid ""
"This device is already signed in. Sign out first to join with an invite."
msgstr ""
"Þetta tæki er þegar innskráð. Skráðu þig fyrst út til að ganga í netið með "
"boði."

msgid "Photo removed."
msgstr "Mynd fjarlægð."

#, rust-format
msgid "Could not remove the photo: {error}"
msgstr "Ekki tókst að fjarlægja myndina: {error}"

#, rust-format
msgid "Could not open the browser: {error}"
msgstr "Ekki tókst að opna vafrann: {error}"

msgid ""
"You can't open the admin panel: you're not an administrator of this network, "
"or the panel can't be reached."
msgstr ""
"Þú getur ekki opnað stjórnborðið: þú ert ekki kerfisstjóri þessa nets, eða "
"ekki næst í stjórnborðið."

msgid "Enter the server URL before saving."
msgstr "Sláðu inn vefslóð þjónsins áður en þú vistar."

msgid "Enter the pre-auth key before saving."
msgstr "Sláðu inn forvottunarlykilinn áður en þú vistar."

msgid "Setup saved"
msgstr "Uppsetning vistuð"

msgid "Could not start the Tailscale service."
msgstr "Ekki tókst að ræsa Tailscale-þjónustuna."

msgid "IP address copied"
msgstr "IP-tala afrituð"

#, rust-format
msgid ""
"Saved, but the pre-auth key could not be stored in the system keyring "
"({error}). This device can still reconnect; the key is only needed again to "
"register it anew."
msgstr ""
"Vistað, en ekki tókst að geyma forauðkenningarlykilinn í lyklakippu "
"kerfisins ({error}). Þetta tæki getur samt tengst aftur; lykillinn þarf "
"aðeins aftur til að skrá það upp á nýtt."

msgid "Connected"
msgstr "Tengt"

msgid "Service stopped"
msgstr "Þjónusta stöðvuð"

msgid "Not signed in"
msgstr "Ekki skráð/ur inn"

msgid "Disconnected"
msgstr "Aftengt"

msgid "Connecting…"
msgstr "Tengist…"

msgid "Server unreachable"
msgstr "Ekki hægt að ná í þjón"

msgid "Tailscale can't set DNS"
msgstr "Tailscale getur ekki stillt DNS"

#, rust-format
msgid "Update available: v{version}"
msgstr "Uppfærsla tiltæk: v{version}"

#, rust-format
msgid "Sign in again as {user}"
msgstr "Skrá aftur inn sem {user}"

msgid "(no device name)"
msgstr "(ekkert tækisheiti)"

msgid "Sign in or paste a pre-auth key"
msgstr "Skráðu þig inn eða límdu forvottaðan lykil"

msgid "Server not set"
msgstr "Þjónn ekki stilltur"

msgid "Disconnect"
msgstr "Aftengja"

msgid "no other devices"
msgstr "engin önnur tæki"

#, rust-format
msgid "{online} online"
msgstr "{online} á netinu"

#, rust-format
msgid "{online} online · {offline} offline"
msgstr "{online} á netinu · {offline} ótengdur"

msgid "is online"
msgstr "er á neti"

msgid "went offline"
msgstr "fór af neti"

#, rust-format
msgid "{count} devices are online"
msgstr "{count} tæki eru á netinu"

#, rust-format
msgid "{count} devices went offline"
msgstr "{count} tæki fóru af netinu"

#, rust-format
msgid "{on_count} online · {off_count} offline"
msgstr "{on_count} á netinu · {off_count} af netinu"

msgid ""
"On the phone, open BigLace and tap “Scan QR code”, then point it at this "
"code. The phone joins as one of your devices."
msgstr ""
"Opnaðu BigLace í símanum og ýttu á „Skanna QR-kóða“, beindu honum svo að "
"þessum kóða. Síminn bætist við sem eitt af tækjunum þínum."

msgid "Asking the panel for a code…"
msgstr "Bið panelinn um kóða…"

msgid "New code"
msgstr "Nýr kóði"

msgid "This code is no longer valid."
msgstr "Þessi kóði er ekki lengur gildur."

#, rust-format
msgid "Valid for {time} · works once"
msgstr "Gildir í {time} · virkar einu sinni"

msgid ""
"This network's server doesn't pair phones yet. Ask your administrator to "
"update the panel, or invite the phone instead."
msgstr ""
"Þjónn þessa nets getur ekki enn parað síma. Biddu kerfisstjórann að uppfæra "
"panelinn, eða bjóddu símanum í staðinn."

msgid ""
"Invites from BigLace need a BigScale server that supports them. Ask your "
"administrator to update the server, or to create the invite in the panel."
msgstr ""
"Boð frá BigLace þurfa BigScale-þjón sem styður þau. Biddu kerfisstjórann að "
"uppfæra þjóninn eða búa til boðið í stjórnborðinu."

msgid "This device can't send invites (it isn't linked to a person's account)."
msgstr ""
"Þetta tæki getur ekki sent boð (það er ekki tengt aðgangi einstaklings)."

msgid ""
"The panel knows this device by a different key (BigLace was reinstalled?). "
"Leave the network and join again to fix it."
msgstr ""
"Stjórnborðið þekkir þetta tæki undir öðrum lykli (var BigLace sett upp "
"aftur?). Yfirgefðu netið og gakktu aftur í það til að laga þetta."

msgid ""
"The panel couldn't confirm this device. Make sure BigLace is up to date and "
"stays open while connected, then try again."
msgstr ""
"Stjórnborðið gat ekki staðfest þetta tæki. Gakktu úr skugga um að BigLace sé "
"uppfært og sé opið á meðan tengt er, reyndu svo aftur."

msgid "You are no longer in that group."
msgstr "Þú ert ekki lengur í þessum hópi."

msgid ""
"On this network everyone can reach everyone, so only the administrator can "
"invite people."
msgstr ""
"Á þessu neti ná allir í alla, svo aðeins kerfisstjórinn getur boðið fólki."

msgid "You have too many pending invites. Cancel some or try again tomorrow."
msgstr ""
"Þú ert með of mörg boð í bið. Afturkallaðu einhver eða reyndu aftur á morgun."

msgid ""
"On this network only administrators invite new people. You can still invite "
"people already on the network into your groups."
msgstr ""
"Á þessu neti bjóða aðeins kerfisstjórar nýju fólki. Þú getur samt boðið "
"fólki sem er þegar á netinu í hópana þína."

#, rust-format
msgid "Could not reach the panel: {error}"
msgstr "Ekki náðist í stjórnborðið: {error}"

msgid "Waiting to be used"
msgstr "Bíður notkunar"

msgid "Used"
msgstr "Notað"

msgid "Expired"
msgstr "Útrunnið"

msgid "Cancelled"
msgstr "Afturkallað"

msgid "Waiting for an administrator's approval"
msgstr "Bíður samþykkis kerfisstjóra"

msgid "Refresh"
msgstr "Endurlesa"

msgid "Main menu"
msgstr "Aðalvalmynd"

msgid "Bring someone to your network"
msgstr "Fáðu einhvern á netið þitt"

msgid ""
"Create a link or QR code and send it to the person. When they join, you two "
"can reach each other's devices — no administrator needed. The link works "
"once and stays valid until it's used or you cancel it."
msgstr ""
"Búðu til tengil eða QR-kóða og sendu viðkomandi. Þegar hann gengur í netið "
"náið þið í tæki hvors annars — enginn kerfisstjóri þarf. Tengillinn virkar "
"einu sinni og gildir þar til hann er notaður eða þú afturkallar hann."

msgid "No invites yet"
msgstr "Engin boð enn"

msgid "Invites unavailable"
msgstr "Boð ekki tiltæk"

#, rust-format
msgid "{user} joined"
msgstr "{user} gekk í netið"

msgid "Invite"
msgstr "Bjóða"

#, rust-format
msgid "group {group}"
msgstr "hópur {group}"

msgid "Cancel this invite: the link stops working"
msgstr "Afturkalla þetta boð: tengillinn hættir að virka"

msgid "The person you invite will reach your devices, and you theirs."
msgstr "Sá sem þú býður nær í tækin þín og þú í hans."

msgid "Who is it for? (optional)"
msgstr "Fyrir hvern er það? (valfrjálst)"

msgid "Access"
msgstr "Aðgangur"

msgid "Just the two of us"
msgstr "Bara við tvö"

msgid "You see each other's devices, nobody else"
msgstr "Þið sjáið tæki hvors annars, enginn annar"

#, rust-format
msgid "Also the group {group}"
msgstr "Líka hópurinn {group}"

msgid "They join the group and see everyone in it"
msgstr "Viðkomandi gengur í hópinn og sér alla í honum"

msgid "A network of their own"
msgstr "Eigið net"

msgid ""
"No link to you: they see only their own devices and whoever they invite "
"(you're the administrator)"
msgstr ""
"Engin tenging við þig: viðkomandi sér aðeins eigin tæki og þá sem hann býður "
"(þú ert kerfisstjórinn)"

msgid "Create invite"
msgstr "Búa til boð"

msgid "QR code of the invite link"
msgstr "QR-kóði boðstengilsins"

msgid ""
"Send the link or let the person scan the code with their phone. It works "
"once and stays valid until used or cancelled."
msgstr ""
"Sendu tengilinn eða leyfðu viðkomandi að skanna kóðann með símanum. Hann "
"virkar einu sinni og gildir þar til hann er notaður eða afturkallaður."

msgid "Copy link"
msgstr "Afrita tengil"

msgid "Done"
msgstr "Lokið"

msgid "Copied!"
msgstr "Afritað!"

msgid ""
"This network asks an administrator to approve each invite: the link starts "
"working once they do. Its status shows in Invites."
msgstr ""
"Þetta net krefst þess að kerfisstjóri samþykki hvert boð: tengillinn virkar "
"þegar hann hefur gert það. Staðan birtist undir Boð."

msgid "Show the full sidebar"
msgstr "Sýna allt hliðarspjaldið"

msgid "Show only icons in the sidebar"
msgstr "Aðeins tákn í hliðarspjaldinu"

msgid "Sections"
msgstr "Hlutar"

msgid ""
"Your identity on this mesh — the device name shown to other peers and the "
"network you're connected to."
msgstr ""
"Auðkenni þitt í þessu möskvaneti — tækjaheitið sem birtist öðrum jafningjum "
"og netið sem þú ert tengdur við."

msgid "Change photo…"
msgstr "Breyta mynd…"

msgid "Remove photo"
msgstr "Fjarlægja mynd"

msgid "Change your photo"
msgstr "Breyta myndinni þinni"

msgid "Rename this device on the network"
msgstr "Endurnefna þetta tæki á netinu"

msgid "Advanced: use a pre-auth key"
msgstr "Ítarlegt: nota forlykilslykil"

msgid "Already have a key from your administrator? Paste it here."
msgstr "Ertu nú þegar með lykil frá kerfisstjóranum þínum? Límdu hann hér."

msgid ""
"Manual setup — expand to paste a server URL and pre-auth key when you "
"already received them from your administrator. Most users should sign in "
"through the panel button above instead."
msgstr ""
"Handvirk uppsetning — stækkaðu til að líma inn þjónslóð og forvottunarlykil "
"ef þú hefur þegar fengið þau frá kerfisstjóra. Flestir notendur ættu í "
"staðinn að skrá sig inn með hnappnum fyrir ofan."

msgid ""
"Address of the coordination server (e.g. vpn.example.org). The https:// "
"scheme is added automatically if you omit it."
msgstr ""
"Vistfang samhæfingarþjóns (t.d. vpn.example.org). https:// forskeytinu er "
"bætt við sjálfkrafa ef þú sleppir því."

msgid "Pre-auth key"
msgstr "Forvottaður lykill"

msgid ""
"One-time or reusable key created on the server (starts with 'hskey-auth-'). "
"Used to register this device automatically without opening a browser."
msgstr ""
"Einskiptis- eða endurnýtanlegur lykill búinn til á þjóninum (byrjar á 'hskey-"
"auth-'). Notaður til að skrá þetta tæki sjálfkrafa án þess að opna vafra."

msgid ""
"The name this device shows to other peers on the VPN — this is the Tailscale "
"hostname, NOT your computer's name and NOT your user. Lowercase letters, "
"digits and hyphens. Example: 'tales-laptop', 'francois', 'office-pc'."
msgstr ""
"Heitið sem þetta tæki birtir öðrum jafningjum á VPN-inu — þetta er Tailscale "
"vélarheitið, EKKI nafn tölvunnar þinnar og EKKI notandanafnið þitt. "
"Lágstafir, tölustafir og bandstrik. Dæmi: 'tales-laptop', 'francois', "
"'office-pc'."

msgid "Apply manual setup"
msgstr "Nota handvirka uppsetningu"

msgid "Save"
msgstr "Vista"

msgid ""
"Persist the server, key and device name above. Won't connect — press Connect "
"afterwards."
msgstr ""
"Vistar þjóninn, lykilinn og tækjaheitið hér að ofan. Tengist ekki — ýttu á "
"Tengjast eftir á."

msgid "Connect automatically"
msgstr "Tengjast sjálfkrafa"

msgid "Join the network when BigLace starts"
msgstr "Tengjast netinu þegar BigLace ræsist"

msgid ""
"When on, BigLace runs 'tailscale up' as soon as it launches, so you join the "
"mesh without clicking Connect every time."
msgstr ""
"Þegar kveikt er á því keyrir BigLace 'tailscale up' um leið og það ræsist, "
"svo þú tengist möskvanetinu án þess að smella á Tengjast í hvert skipti."

msgid "Toggle auto-connect on startup"
msgstr "Skipta á milli sjálfvirkrar tengingar við ræsingu"

msgid "Start BigLace with the session"
msgstr "Ræsa BigLace með setunni"

msgid "Open BigLace after you sign in to the desktop"
msgstr "Opna BigLace eftir að þú skráir þig inn á skjáborðið"

msgid ""
"Turn this on to add BigLace to your desktop session startup. Turn it off to "
"remove it."
msgstr ""
"Kveiktu á þessu til að bæta BigLace við ræsingu skjáborðssetunnar. Slökktu á "
"því til að fjarlægja það."

msgid "Toggle start with session"
msgstr "Skipta um ræsingu með setu"

msgid "Reconnect on drop"
msgstr "Endurtengja við aftengingu"

msgid "Retry with backoff when the connection is lost"
msgstr "Reyndu aftur með bið þegar tenging rofnar"

msgid ""
"If the tunnel drops (network change, sleep, server hiccup), BigLace silently "
"retries with growing delays instead of leaving you offline until you notice."
msgstr ""
"Ef genginu fellur (netbreyting, svefn, þjónshik) reynir BigLace aftur "
"hljóðlega með vaxandi bið í stað þess að skilja þig eftir ótengdan þar til "
"þú tekur eftir því."

msgid "Toggle auto-reconnect"
msgstr "Skipta á milli sjálfvirkrar endurtengingar"

msgid "Notify on peer changes"
msgstr "Tilkynna um breytingar á jafningjum"

msgid "Show a desktop notification when peers go online/offline"
msgstr "Sýna skjáborðstilkynningu þegar jafningjar fara á net/af neti"

msgid ""
"Send a desktop toast when another device on your network goes online or "
"offline. Rapid bursts are coalesced into a single notification so you don't "
"get spammed during reconnects."
msgstr ""
"Senda skjáborðstilkynningu þegar annað tæki á netinu þínu fer á netið eða af "
"því. Snöggar bylgjur eru sameinaðar í eina tilkynningu svo þú fáir ekki "
"ruslpóst við endurtengingar."

msgid "Toggle peer-change notifications"
msgstr "Skipta á milli tilkynninga um jafningjabreytingar"

msgid ""
"Join or leave the mesh network. When connected, this device becomes "
"reachable by the other peers in your account."
msgstr ""
"Tengdu eða aftengdu möskvanetið. Þegar tengt er, verður þetta tæki "
"aðgengilegt öðrum jafningjum á þínum reikningi."

msgid "Your photo"
msgstr "Myndin þín"

msgid "New chat"
msgstr "Nýtt spjall"

msgid "Start a conversation with someone on the network"
msgstr "Hefja samtal við einhvern á netinu"

msgid "Chat theme"
msgstr "Þema spjalls"

msgid "Conversations"
msgstr "Samtöl"

msgid "No conversations yet."
msgstr "Engin samtöl enn."

msgid "Search in this conversation (Ctrl+F)"
msgstr "Leita í þessu samtali (Ctrl+F)"

msgid "Pinned message"
msgstr "Fest skilaboð"

msgid "Unpin"
msgstr "Losa"

msgid "Search messages"
msgstr "Leita í skilaboðum"

msgid "Older"
msgstr "Eldri"

msgid "Newer"
msgstr "Nýrri"

msgid "Emoji"
msgstr "Tjákn"

msgid "Send files, pictures or videos"
msgstr "Senda skrár, myndir eða myndskeið"

msgid "Send (Enter) — Shift+Enter for a new line"
msgstr "Senda (Enter) — Shift+Enter fyrir nýja línu"

msgid "Record a voice message"
msgstr "Taka upp talskilaboð"

msgid "Discard"
msgstr "Henda"

msgid "Send voice message"
msgstr "Senda talskilaboð"

msgid "Copy text"
msgstr "Afrita texta"

msgid "Forward"
msgstr "Áframsenda"

msgid "Delete"
msgstr "Eyða"

msgid "Talk with your network"
