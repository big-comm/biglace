#: src/window.rs
msgid "Disconnect"
msgstr "Aftengja"

#: src/window.rs
msgid "Refresh list"
msgstr "Endurnýja lista"

#: src/window.rs
msgid "Main menu"
msgstr "Aðalvalmynd"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Skráðu þig inn með panel-reikningi"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "Gerðu þennan notanda að tailscale-stjórnanda"

#: src/window.rs
msgid "About BigLace"
msgstr "Um BigLace"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Tailscale-stjórnandi"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr "Lokið. Þú þarft ekki lengur lykilorð til að tengjast eða aftengjast."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Mistókst: {error}"

#: src/window.rs
msgid "OK"
msgstr "Í lagi"

#: src/window.rs
msgid "Error: {error}"
msgstr "Villa: {error}"

#: src/window.rs
msgid "Files"
msgstr "Skrár"

#: src/window.rs
msgid "Terminal"
msgstr "Skjáhermir"

#: src/window.rs
msgid "Copied!"
msgstr "Afritað!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Mesh VPN-biðlari fyrir BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "Innskráningarupplýsingar spjalds"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Notaðu notandanafn og lykilorð frá BigScale spjaldinu þínu til að búa til "
"lykil sjálfkrafa."

#: src/window.rs
msgid "Panel URL"
msgstr "Slóð spjalds"

#: src/window.rs
msgid "Username"
msgstr "Notandanafn"

#: src/window.rs
msgid "Password"
msgstr "Lykilorð"

#: src/window.rs
msgid "Network user identifier"
msgstr "Auðkenni netnotanda"

#: src/window.rs
msgid "Cancel"
msgstr "Hætta við"

#: src/window.rs
msgid "Sign in"
msgstr "Skrá inn"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Fylltu út slóð, notandanafn og lykilorð."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Lykill búinn til með góðum árangri."

#: src/window.rs
msgid "Service not found"
msgstr "Þjónusta fannst ekki"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"tailscaled þjónustan er ekki í gangi.\n"
"Smelltu hér fyrir neðan til að ræsa hana."

#: src/window.rs
msgid "Start service"
msgstr "Ræsa þjónustu"

#: src/window.rs
msgid "Server"
msgstr "Þjónn"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "Vistfang BigScale/Headscale þjónsins þíns."

#: src/window.rs
msgid "Server URL"
msgstr "Vefslóð þjóns"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Auðkenni þitt á netinu"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Persónulegur lykill sem var búinn til fyrir þig í BigScale spjaldinu (\"Nýr "
"lykill\" í Notendur). Hver einstaklingur notar sinn eigin — þetta er ekki "
"lykill þjónsins."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "For-auðkenningarlykill (þinn)"

#: src/window.rs
msgid "This device"
msgstr "Þetta tæki"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Nafn sem birtist öðrum tækjum á netinu."

#: src/window.rs
msgid "Device name"
msgstr "Tækisnafn"

#: src/window.rs
msgid "Options"
msgstr "Valkostir"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Tengjast sjálfkrafa við ræsingu"

#: src/window.rs
msgid "Connect"
msgstr "Tengjast"

#: src/window.rs
msgid "Please wait..."
msgstr "Vinsamlegast bíðið..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Tengt við netið"

#: src/window.rs
msgid "Your IP address"
msgstr "IP-tala þín"

#: src/window.rs
msgid "Devices on the network"
msgstr "Tæki á netinu"

#: src/window.rs
msgid "No other devices found."
msgstr "Engin önnur tæki fundust."

#: src/window.rs
msgid "Copy"
msgstr "Afrita"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Mistókst að keyra tailscale"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Mistókst að tengjast — athugaðu vefslóð þjónsins og lykilinn."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Mistókst að keyra pkexec tailscale"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Gat ekki ákvarðað núverandi notanda."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Mistókst að keyra pkexec tailscale set"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Mistókst að stilla tailscale stjórnanda."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Forauðkenningarlykli var hafnað af þjóninum. Búðu til nýjan lykil í BigScale-stjórnborðinu og reyndu aftur."

msgid "Login rejected by server: {detail}"
msgstr "Innskráningu hafnað af þjóni: {detail}"
