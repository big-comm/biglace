msgid "Make this user the tailscale operator"
msgstr "Сделать этого пользователя оператором Tailscale"

#: src/window.rs
msgid "About BigLace"
msgstr "О программе BigLace"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Оператор Tailscale"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr "Готово. Теперь для подключения или отключения пароль не понадобится."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Ошибка: {error}"

#: src/window.rs
msgid "OK"
msgstr "ОК"

#: src/window.rs
msgid "Error: {error}"
msgstr "Ошибка: {error}"

#: src/window.rs
msgid "Files"
msgstr "Файлы"

#: src/window.rs
msgid "Terminal"
msgstr "Терминал"

#: src/window.rs
msgid "Copied!"
msgstr "Скопировано!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Mesh VPN-клиент для BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "Учетные данные панели"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Используйте имя пользователя и пароль от панели BigScale для автоматической "
"генерации ключа."

#: src/window.rs
msgid "Panel URL"
msgstr "URL панели"

#: src/window.rs
msgid "Username"
msgstr "Имя пользователя"

#: src/window.rs
msgid "Password"
msgstr "Пароль"

#: src/window.rs
msgid "Network user identifier"
msgstr "Идентификатор пользователя сети"

#: src/window.rs
msgid "Cancel"
msgstr "Отмена"

#: src/window.rs
msgid "Sign in"
msgstr "Войти"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Заполните URL, имя пользователя и пароль."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Ключ успешно создан."

#: src/window.rs
msgid "Service not found"
msgstr "Служба не найдена"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"Служба tailscaled не запущена.\n"
"Нажмите ниже, чтобы запустить ее."

#: src/window.rs
msgid "Start service"
msgstr "Запустить службу"

#: src/window.rs
msgid "Server"
msgstr "Сервер"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "Адрес вашего сервера BigScale/Headscale."

#: src/window.rs
msgid "Server URL"
msgstr "URL сервера"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Ваш идентификатор в сети"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Персональный ключ, созданный для вас в панели BigScale («Новый ключ» в "
"разделе «Пользователи»). Каждый использует свой собственный — это не ключ "
"сервера."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Pre-auth ключ (ваш)"

#: src/window.rs
msgid "This device"
msgstr "Это устройство"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Имя, отображаемое для других устройств в сети."

#: src/window.rs
msgid "Device name"
msgstr "Имя устройства"

#: src/window.rs
msgid "Options"
msgstr "Параметры"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Подключаться автоматически при запуске"

#: src/window.rs
msgid "Connect"
msgstr "Подключиться"

#: src/window.rs
msgid "Please wait..."
msgstr "Пожалуйста, подождите..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Подключено к сети"

#: src/window.rs
msgid "Your IP address"
msgstr "Ваш IP-адрес"

#: src/window.rs
msgid "Devices on the network"
msgstr "Устройства в сети"

#: src/window.rs
msgid "No other devices found."
msgstr "Других устройств не найдено."

#: src/window.rs
msgid "Copy"
msgstr "Копировать"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Не удалось запустить tailscale"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Не удалось подключиться — проверьте URL сервера и ключ."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Не удалось запустить pkexec tailscale"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Не удалось определить текущего пользователя."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Не удалось запустить pkexec tailscale set"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Не удалось назначить оператора tailscale."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Ключ предварительной аутентификации отклонён сервером. Создайте новый ключ в панели BigScale и попробуйте снова."

msgid "Login rejected by server: {detail}"
msgstr "Сервер отклонил вход: {detail}"
