msgstr "У меня есть ключ доступа"

msgid "A key the administrator created for you (starts with hskey-auth-)."
msgstr "Ключ, созданный для вас администратором (начинается с hskey-auth-)."

msgid "I'm the administrator"
msgstr "Я администратор"

msgid "Sign in with the BigScale panel's admin username and password."
msgstr ""
"Войдите с именем пользователя и паролем администратора панели BigScale."

msgid "This device"
msgstr "Это устройство"

msgid "Devices on the network"
msgstr "Устройства в сети"

