msgid "Main menu"
msgstr "Menu principale"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Accedi con account pannello"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "Rendi questo utente operatore di Tailscale"

#: src/window.rs
msgid "About BigLace"
msgstr "Informazioni su BigLace"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Operatore Tailscale"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr ""
"Operazione completata. Non avrai più bisogno di una password per connetterti"
" o disconnetterti."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Operazione fallita: {error}"

#: src/window.rs
msgid "OK"
msgstr "OK"

#: src/window.rs
msgid "Error: {error}"
msgstr "Errore: {error}"

#: src/window.rs
msgid "Files"
msgstr "File"

#: src/window.rs
msgid "Terminal"
msgstr "Terminale"

#: src/window.rs
msgid "Copied!"
msgstr "Copiato!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Client VPN mesh per BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "Credenziali pannello"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Usa il nome utente e la password del pannello BigScale per generare "
"automaticamente una chiave."

#: src/window.rs
msgid "Panel URL"
msgstr "URL pannello"

#: src/window.rs
msgid "Username"
msgstr "Nome utente"

#: src/window.rs
msgid "Password"
msgstr "Password"

#: src/window.rs
msgid "Network user identifier"
msgstr "Identificativo utente di rete"

#: src/window.rs
msgid "Cancel"
msgstr "Annulla"

#: src/window.rs
msgid "Sign in"
msgstr "Accedi"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Inserisci URL, nome utente e password."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Chiave generata con successo."

#: src/window.rs
msgid "Service not found"
msgstr "Servizio non trovato"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"Il servizio tailscaled non è in esecuzione.\n"
"Clicca qui sotto per avviarlo."

#: src/window.rs
msgid "Start service"
msgstr "Avvia servizio"

#: src/window.rs
msgid "Server"
msgstr "Server"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "Indirizzo del tuo server BigScale/Headscale."

#: src/window.rs
msgid "Server URL"
msgstr "URL del server"

#: src/window.rs
msgid "Your identity on the network"
msgstr "La tua identità sulla rete"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Chiave personale generata per te nel pannello BigScale (\"Nuova chiave\" in "
"Utenti). Ogni persona usa la propria — non è la chiave del server."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Chiave di pre-autenticazione (tua)"

#: src/window.rs
msgid "This device"
msgstr "Questo dispositivo"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Nome mostrato agli altri dispositivi sulla rete."

#: src/window.rs
msgid "Device name"
msgstr "Nome del dispositivo"

#: src/window.rs
msgid "Options"
msgstr "Opzioni"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Connetti automaticamente all'avvio"

#: src/window.rs
msgid "Connect"
msgstr "Connetti"

#: src/window.rs
msgid "Please wait..."
msgstr "Attendere prego..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Connesso alla rete"

#: src/window.rs
msgid "Your IP address"
msgstr "Il tuo indirizzo IP"

#: src/window.rs
msgid "Devices on the network"
msgstr "Dispositivi sulla rete"

#: src/window.rs
msgid "No other devices found."
msgstr "Nessun altro dispositivo trovato."

#: src/window.rs
msgid "Copy"
msgstr "Copia"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Impossibile eseguire tailscale"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Connessione fallita: verifica l'URL del server e la chiave."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Impossibile eseguire pkexec tailscale"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Impossibile determinare l'utente corrente."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Impossibile eseguire pkexec tailscale set"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Impossibile impostare l'operatore tailscale."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "La chiave di pre-autenticazione è stata rifiutata dal server. Genera una nuova chiave nel pannello BigScale e riprova."

msgid "Login rejected by server: {detail}"
msgstr "Accesso rifiutato dal server: {detail}"
