msgstr "Inoltrato da {name}"

msgid "edited"
msgstr "modificato"

msgid "More reactions"
msgstr "Altre reazioni"

msgid "Reply"
msgstr "Rispondi"

msgid "Edit"
msgstr "Modifica"

msgid "Pin"
msgstr "Fissa"

msgid "Select"
msgstr "Seleziona"

