msgstr "Modifica del messaggio"

msgid "Copied."
msgstr "Copiato."

msgid "Forward to…"
msgstr "Inoltra a…"

msgid "Forwarded."
msgstr "Inoltrato."

#, rust-format
msgid "Could not forward: {error}"
msgstr "Impossibile inoltrare: {error}"

msgid "Delete the message?"
msgstr "Eliminare il messaggio?"

#, rust-format
msgid "Delete {count} messages?"
msgstr "Eliminare {count} messaggi?"

msgid "“For everyone” removes it from the other computers too."
msgstr "«Per tutti» lo rimuove anche dagli altri computer."

msgid "It's removed from this computer only."
msgstr "Viene rimosso solo da questo computer."

msgid "Delete for me"
msgstr "Elimina per me"

msgid "Delete for everyone"
msgstr "Elimina per tutti"

#, rust-format
msgid "Could not delete: {error}"
msgstr "Impossibile eliminare: {error}"

msgid "1 selected"
