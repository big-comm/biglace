msgstr "Αποστολή (Enter) — Shift+Enter για νέα γραμμή"

msgid "Record a voice message"
msgstr "Ηχογράφηση φωνητικού μηνύματος"

msgid "Discard"
msgstr "Απόρριψη"

msgid "Send voice message"
msgstr "Αποστολή φωνητικού μηνύματος"

msgid "Copy text"
msgstr "Αντιγραφή κειμένου"

msgid "Forward"
msgstr "Προώθηση"

