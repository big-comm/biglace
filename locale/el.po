msgstr "Αδυναμία διαγραφής: {error}"

msgid "1 selected"
msgstr "1 επιλεγμένο"

#, rust-format
msgid "{count} selected"
msgstr "{count} επιλεγμένα"

msgid "That message isn't here anymore."
msgstr "Αυτό το μήνυμα δεν υπάρχει πια εδώ."

msgid "No results"
msgstr "Κανένα αποτέλεσμα"

#, rust-format
