msgstr "Διαγραφή {count} μηνυμάτων;"

msgid "“For everyone” removes it from the other computers too."
msgstr "Το «Για όλους» το αφαιρεί και από τους άλλους υπολογιστές."

msgid "It's removed from this computer only."
msgstr "Αφαιρείται μόνο από αυτόν τον υπολογιστή."

msgid "Delete for me"
msgstr "Διαγραφή για μένα"

msgid "Delete for everyone"
msgstr "Διαγραφή για όλους"

