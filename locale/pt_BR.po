msgstr "Não foi possível encaminhar: {error}"

msgid "Delete the message?"
msgstr "Apagar a mensagem?"

#, rust-format
msgid "Delete {count} messages?"
msgstr "Apagar {count} mensagens?"

msgid "“For everyone” removes it from the other computers too."
msgstr "“Para todos” também apaga dos outros computadores."

msgid "It's removed from this computer only."
msgstr "Ela é apagada só deste computador."

msgid "Delete for me"
msgstr "Apagar para mim"

msgid "Delete for everyone"
msgstr "Apagar para todos"

#, rust-format
msgid "Could not delete: {error}"
msgstr "Não foi possível apagar: {error}"

