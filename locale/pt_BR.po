msgstr "Converse com a sua rede"

msgid ""
"Pick a conversation, or start one. Messages go straight between your "
"computers — the server never sees them."
msgstr ""
"Escolha uma conversa ou comece uma nova. As mensagens vão direto entre os "
"computadores — o servidor nunca as vê."

msgid "People on the network"
msgstr "Pessoas na rede"

msgid "Group"
msgstr "Grupo"

msgid "Direct conversation"
msgstr "Conversa direta"

msgid "That message is too long."
msgstr "Essa mensagem é longa demais."

#, rust-format
msgid "Could not send: {error}"
msgstr "Não foi possível enviar: {error}"

#, rust-format
msgid "Could not download: {error}"
msgstr "Não foi possível baixar: {error}"

#, rust-format
msgid "{user} in {group}"
msgstr "{user} em {group}"

msgid "Send files"
msgstr "Enviar arquivos"

msgid "Drop to send"
msgstr "Solte para enviar"

#, rust-format
msgid "Could not record: {error}"
msgstr "Não foi possível gravar: {error}"

msgid "Too short — record for at least a second."
msgstr "Muito curto — grave por pelo menos um segundo."

