msgstr "Não foi possível reagir: {error}"

#, rust-format
msgid "Reply to {name}"
msgstr "Respondendo a {name}"

msgid "Editing message"
msgstr "Editando mensagem"

msgid "Copied."
msgstr "Copiado."

msgid "Forward to…"
msgstr "Encaminhar para…"

