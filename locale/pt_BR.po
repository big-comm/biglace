msgstr "Buscar mensagens"

msgid "Older"
msgstr "Mais antiga"

msgid "Newer"
msgstr "Mais recente"

msgid "Emoji"
msgstr "Emoji"

msgid "Send files, pictures or videos"
msgstr "Enviar arquivos, fotos ou vídeos"

msgid "Send (Enter) — Shift+Enter for a new line"
msgstr "Enviar (Enter) — Shift+Enter para nova linha"

msgid "Record a voice message"
msgstr "Gravar mensagem de voz"

