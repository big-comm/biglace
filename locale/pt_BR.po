msgid "Disconnect"
msgstr "Sair da rede"

msgid "Refresh list"
msgstr "Atualizar lista"

msgid "Main menu"
msgstr "Menu principal"

msgid "Sign in with panel account"
msgstr "Entrar com conta do painel"

msgid "Make this user the tailscale operator"
msgstr "Tornar este usuário operador"

msgid "About BigLace"
msgstr "Sobre o BigLace"

msgid "Tailscale operator"
msgstr "Operador do tailscale"

msgid "Done. You will no longer need a password to connect or disconnect."
msgstr "Pronto. Você não precisará mais digitar a senha para conectar ou desconectar."

msgid "Failed: {error}"
msgstr "Falha: {error}"

msgid "OK"
msgstr "OK"

msgid "Error: {error}"
msgstr "Erro: {error}"

msgid "Files"
msgstr "Arquivos"

msgid "Terminal"
msgstr "Terminal"

msgid "Copied!"
msgstr "Copiado!"

msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Cliente VPN mesh para BigScale/Headscale."

msgid "Panel credentials"
msgstr "Credenciais do painel"

msgid "Use your BigScale panel username and password to generate a key automatically."
msgstr "Use o usuário e senha do painel BigScale para gerar uma chave automaticamente."

msgid "Panel URL"
msgstr "URL do painel"

msgid "Username"
msgstr "Usuário"

msgid "Password"
msgstr "Senha"

msgid "Network user identifier"
msgstr "Identificador do usuário na rede"

msgid "Cancel"
msgstr "Cancelar"

msgid "Sign in"
msgstr "Entrar"

msgid "Fill in URL, username and password."
msgstr "Preencha URL, usuário e senha."

msgid "Key generated successfully."
msgstr "Chave gerada com sucesso."

msgid "Service not found"
msgstr "Serviço não encontrado"

msgid "The tailscaled service is not running.\nClick below to start it."
msgstr "O serviço tailscaled não está em execução.\nClique abaixo para iniciá-lo."

msgid "Start service"
msgstr "Iniciar serviço"

msgid "Server"
msgstr "Servidor"

msgid "Address of your BigScale/Headscale server."
msgstr "Endereço do servidor BigScale/Headscale da sua rede."

msgid "Server URL"
msgstr "URL do servidor"

msgid "Your identity on the network"
msgstr "Sua identidade na rede"

msgid "Personal key generated for you in the BigScale panel (\"New key\" in Users). Each person uses their own — this is not the server's key."
msgstr "Chave pessoal gerada para você no painel BigScale (campo \"Nova chave\" em Usuários). Cada pessoa usa a sua própria — não é a chave do servidor."

msgid "Pre-auth key (yours)"
msgstr "Chave de pré-autenticação (sua)"

msgid "This device"
msgstr "Este dispositivo"

msgid "Name shown to other devices on the network."
msgstr "Nome que aparecerá para outros na rede."

msgid "Device name"
msgstr "Nome do dispositivo"

msgid "Options"
msgstr "Opções"

msgid "Connect automatically on startup"
msgstr "Conectar automaticamente ao iniciar"

msgid "Connect"
msgstr "Conectar"

msgid "Please wait..."
msgstr "Aguarde..."

msgid "Connected to the network"
msgstr "Conectado à rede"

msgid "Your IP address"
msgstr "Seu IP na rede"

msgid "Devices on the network"
msgstr "Dispositivos na rede"

msgid "No other devices found."
msgstr "Nenhum outro dispositivo encontrado."

msgid "Copy"
msgstr "Copiar"

msgid "Failed to run tailscale"
msgstr "Falha ao executar tailscale"

msgid "Failed to connect — check the server URL and key."
msgstr "Falha ao conectar — verifique o servidor e a chave."

msgid "Failed to run pkexec tailscale"
msgstr "Falha ao executar pkexec tailscale"

msgid "Could not determine the current user."
msgstr "Não foi possível determinar o usuário atual."

msgid "Failed to run pkexec tailscale set"
msgstr "Falha ao executar pkexec tailscale set"

msgid "Failed to set tailscale operator."
msgstr "Falha ao definir operador do tailscale."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "A chave de pré-autenticação foi rejeitada pelo servidor. Gere uma nova chave no painel BigScale e tente novamente."

msgid "Login rejected by server: {detail}"
msgstr "Login rejeitado pelo servidor: {detail}"
