#: src/window.rs
msgid "Disconnect"
msgstr "切断"

#: src/window.rs
msgid "Refresh list"
msgstr "リストを更新"

#: src/window.rs
msgid "Main menu"
msgstr "メインメニュー"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "パネルアカウントでサインイン"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "このユーザーをTailscaleオペレーターにする"

#: src/window.rs
msgid "About BigLace"
msgstr "BigLaceについて"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Tailscaleオペレーター"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr "完了しました。今後、接続または切断にパスワードは不要になります。"

#: src/window.rs
msgid "Failed: {error}"
msgstr "失敗: {error}"

#: src/window.rs
msgid "OK"
msgstr "OK"

#: src/window.rs
msgid "Error: {error}"
msgstr "エラー: {error}"

#: src/window.rs
msgid "Files"
msgstr "ファイル"

#: src/window.rs
msgid "Terminal"
msgstr "ターミナル"

#: src/window.rs
msgid "Copied!"
msgstr "コピーしました！"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "BigScale/Headscale用メッシュVPNクライアント"

#: src/window.rs
msgid "Panel credentials"
msgstr "パネル認証情報"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr "BigScaleパネルのユーザー名とパスワードを使用して、キーを自動生成します。"

#: src/window.rs
msgid "Panel URL"
msgstr "パネルURL"

#: src/window.rs
msgid "Username"
msgstr "ユーザー名"

#: src/window.rs
msgid "Password"
msgstr "パスワード"

#: src/window.rs
msgid "Network user identifier"
msgstr "ネットワークユーザー識別子"

#: src/window.rs
msgid "Cancel"
msgstr "キャンセル"

#: src/window.rs
msgid "Sign in"
msgstr "サインイン"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "URL、ユーザー名、パスワードを入力してください。"

#: src/window.rs
msgid "Key generated successfully."
msgstr "キーが正常に生成されました。"

#: src/window.rs
msgid "Service not found"
msgstr "サービスが見つかりません"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"tailscaledサービスが実行されていません。\n"
"以下をクリックして起動してください。"

#: src/window.rs
msgid "Start service"
msgstr "サービスを起動"

#: src/window.rs
msgid "Server"
msgstr "サーバー"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "BigScale/Headscaleサーバーのアドレス。"

#: src/window.rs
msgid "Server URL"
msgstr "サーバーURL"

#: src/window.rs
msgid "Your identity on the network"
msgstr "ネットワーク上のあなたの識別情報"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"BigScaleパネルで発行された個人用キー（ユーザー画面の「新しいキー」）。各ユーザーが個別に使用するもので、サーバーのキーではありません。"

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "事前認証キー（あなたのもの）"

#: src/window.rs
msgid "This device"
msgstr "このデバイス"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "ネットワーク上の他のデバイスに表示される名前です。"

#: src/window.rs
msgid "Device name"
msgstr "デバイス名"

#: src/window.rs
msgid "Options"
msgstr "オプション"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "起動時に自動的に接続する"

#: src/window.rs
msgid "Connect"
msgstr "接続"

#: src/window.rs
msgid "Please wait..."
msgstr "お待ちください..."

#: src/window.rs
msgid "Connected to the network"
msgstr "ネットワークに接続しました"

#: src/window.rs
msgid "Your IP address"
msgstr "あなたのIPアドレス"

#: src/window.rs
msgid "Devices on the network"
msgstr "ネットワーク上のデバイス"

#: src/window.rs
msgid "No other devices found."
msgstr "他のデバイスは見つかりませんでした。"

#: src/window.rs
msgid "Copy"
msgstr "コピー"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "tailscaleの実行に失敗しました"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "接続に失敗しました — サーバーURLとキーを確認してください。"

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "pkexec tailscaleの実行に失敗しました"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "現在のユーザーを特定できませんでした。"

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "pkexec tailscale setの実行に失敗しました"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "tailscaleオペレーターの設定に失敗しました"

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "事前認証キーがサーバーによって拒否されました。BigScaleパネルで新しいキーを生成して、もう一度お試しください。"

msgid "Login rejected by server: {detail}"
msgstr "サーバーがログインを拒否しました: {detail}"
