#: src/window.rs
msgid "Disconnect"
msgstr "Koppla från"

#: src/window.rs
msgid "Refresh list"
msgstr "Uppdatera lista"

#: src/window.rs
msgid "Main menu"
msgstr "Huvudmeny"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Logga in med panelkonto"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "Gör denna användare till tailscale-operatör"

#: src/window.rs
msgid "About BigLace"
msgstr "Om BigLace"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Tailscale-operatör"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr ""
"Klart. Du kommer inte längre att behöva ett lösenord för att ansluta eller "
"koppla från."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Misslyckades: {error}"

#: src/window.rs
msgid "OK"
msgstr "OK"

#: src/window.rs
msgid "Error: {error}"
msgstr "Fel: {error}"

#: src/window.rs
msgid "Files"
msgstr "Filer"

#: src/window.rs
msgid "Terminal"
msgstr "Terminal"

#: src/window.rs
msgid "Copied!"
msgstr "Kopierad!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Mesh VPN-klient för BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "Paneluppgifter"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Använd ditt BigScale-panelanvändarnamn och lösenord för att automatiskt "
"generera en nyckel."

#: src/window.rs
msgid "Panel URL"
msgstr "Panel-URL"

#: src/window.rs
msgid "Username"
msgstr "Användarnamn"

#: src/window.rs
msgid "Password"
msgstr "Lösenord"

#: src/window.rs
msgid "Network user identifier"
msgstr "Nätverksanvändaridentifierare"

#: src/window.rs
msgid "Cancel"
msgstr "Avbryt"

#: src/window.rs
msgid "Sign in"
msgstr "Logga in"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Fyll i URL, användarnamn och lösenord."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Nyckeln har genererats."

#: src/window.rs
msgid "Service not found"
msgstr "Tjänsten hittades inte"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"Tailscaled-tjänsten körs inte.\n"
"Klicka nedan för att starta den."

#: src/window.rs
msgid "Start service"
msgstr "Starta tjänst"

#: src/window.rs
msgid "Server"
msgstr "Server"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "Adress till din BigScale/Headscale-server."

#: src/window.rs
msgid "Server URL"
msgstr "Server-URL"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Din identitet i nätverket"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Personlig nyckel genererad åt dig i BigScale-panelen (\"Ny nyckel\" under "
"Användare). Varje person använder sin egen – detta är inte serverns nyckel."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "För-auktoriseringsnyckel (din)"

#: src/window.rs
msgid "This device"
msgstr "Denna enhet"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Namn som visas för andra enheter i nätverket."

#: src/window.rs
msgid "Device name"
msgstr "Enhetsnamn"

#: src/window.rs
msgid "Options"
msgstr "Alternativ"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Anslut automatiskt vid start"

#: src/window.rs
msgid "Connect"
msgstr "Anslut"

#: src/window.rs
msgid "Please wait..."
msgstr "Vänta..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Ansluten till nätverket"

#: src/window.rs
msgid "Your IP address"
msgstr "Din IP-adress"

#: src/window.rs
msgid "Devices on the network"
msgstr "Enheter i nätverket"

#: src/window.rs
msgid "No other devices found."
msgstr "Inga andra enheter hittades."

#: src/window.rs
msgid "Copy"
msgstr "Kopiera"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Misslyckades med att köra tailscale"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Misslyckades med att ansluta – kontrollera server-URL och nyckel."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Misslyckades med att köra pkexec tailscale"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Kunde inte fastställa den aktuella användaren."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Misslyckades med att köra pkexec tailscale set"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Misslyckades med att ställa in tailscale-operator."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Förautentiseringsnyckeln avvisades av servern. Generera en ny nyckel i BigScale-panelen och försök igen."

msgid "Login rejected by server: {detail}"
msgstr "Inloggning avvisades av servern: {detail}"
