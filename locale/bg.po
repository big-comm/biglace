msgstr "Копиране на IP адрес"

msgid "Open files (SFTP)"
msgstr "Отваряне на файлове (SFTP)"

msgid "Open terminal (SSH)"
msgstr "Отваряне на терминал (SSH)"

msgid "See and control the screen"
msgstr "Виждане и управление на екрана"

msgid "DNS name"
msgstr "DNS име"

