#: src/window.rs
msgid "Disconnect"
msgstr "Прекъсване на връзката"

#: src/window.rs
msgid "Refresh list"
msgstr "Обновяване на списъка"

#: src/window.rs
msgid "Main menu"
msgstr "Главно меню"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Вход с акаунт в панела"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "Направете този потребител оператор на tailscale"

#: src/window.rs
msgid "About BigLace"
msgstr "Относно BigLace"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Оператор на tailscale"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr ""
"Готово. Вече няма да имате нужда от парола за свързване или прекъсване на "
"връзката."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Неуспешно: {error}"

#: src/window.rs
msgid "OK"
msgstr "OK"

#: src/window.rs
msgid "Error: {error}"
msgstr "Грешка: {error}"

#: src/window.rs
msgid "Files"
msgstr "Файлове"

#: src/window.rs
msgid "Terminal"
msgstr "Терминал"

#: src/window.rs
msgid "Copied!"
msgstr "Копирано!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Mesh VPN клиент за BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "Удостоверения на панела"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Използвайте вашето потребителско име и парола от панела на BigScale, за да "
"генерирате ключ автоматично."

#: src/window.rs
msgid "Panel URL"
msgstr "URL на панела"

#: src/window.rs
msgid "Username"
msgstr "Потребителско име"

#: src/window.rs
msgid "Password"
msgstr "Парола"

#: src/window.rs
msgid "Network user identifier"
msgstr "Идентификатор на мрежовия потребител"

#: src/window.rs
msgid "Cancel"
msgstr "Отказ"

#: src/window.rs
msgid "Sign in"
msgstr "Вход"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Попълнете URL, потребителско име и парола."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Ключът е генериран успешно."

#: src/window.rs
msgid "Service not found"
msgstr "Услугата не е намерена"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"Услугата tailscaled не работи.\n"
"Щракнете по-долу, за да я стартирате."

#: src/window.rs
msgid "Start service"
msgstr "Стартиране на услугата"

#: src/window.rs
msgid "Server"
msgstr "Сървър"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "Адрес на вашия BigScale/Headscale сървър."

#: src/window.rs
msgid "Server URL"
msgstr "URL на сървъра"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Вашата идентичност в мрежата"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Личен ключ, генериран за вас в панела на BigScale (\"Нов ключ\" в "
"Потребители). Всеки използва свой собствен — това не е ключът на сървъра."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Ключ за предварително удостоверяване (ваш)"

#: src/window.rs
msgid "This device"
msgstr "Това устройство"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Име, показвано на другите устройства в мрежата."

#: src/window.rs
msgid "Device name"
msgstr "Име на устройството"

#: src/window.rs
msgid "Options"
msgstr "Опции"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Свързване автоматично при стартиране"

#: src/window.rs
msgid "Connect"
msgstr "Свързване"

#: src/window.rs
msgid "Please wait..."
msgstr "Моля, изчакайте..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Свързан към мрежата"

#: src/window.rs
msgid "Your IP address"
msgstr "Вашият IP адрес"

#: src/window.rs
msgid "Devices on the network"
msgstr "Устройства в мрежата"

#: src/window.rs
msgid "No other devices found."
msgstr "Не са открити други устройства."

#: src/window.rs
msgid "Copy"
msgstr "Копирай"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Неуспешно стартиране на tailscale"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Неуспешно свързване — проверете URL адреса на сървъра и ключа."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Неуспешно стартиране на pkexec tailscale"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Не може да се определи текущият потребител."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Неуспешно стартиране на pkexec tailscale set"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Неуспешно задаване на tailscale оператор."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Предварително-удостоверителният ключ беше отхвърлен от сървъра. Генерирайте нов ключ в панела на BigScale и опитайте отново."

msgid "Login rejected by server: {detail}"
msgstr "Входът беше отхвърлен от сървъра: {detail}"
