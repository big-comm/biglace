msgstr ""
"Сигналът е изпратен до {name} (чрез {via}). Ако е настроено да се включва по "
"мрежата, ще се появи след минута-две."

#, rust-format
msgid "Could not turn on {name}: {error}"
msgstr "Неуспешно включване на {name}: {error}"

msgid "Unpin from top"
msgstr "Откачане от началото"

msgid "Pin to top"
msgstr "Закачане отгоре"

