msgid "Join the network when BigLace starts"
msgstr "Присъединете се към мрежата, когато BigLace стартира"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/mod.rs:424
msgid "Sign in or paste a pre-auth key"
msgstr "Влезте или поставете предварителен ключ"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/mod.rs:429
msgid "Server not set"
msgstr "Сървърът не е зададен"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/mod.rs:186
msgid "Setup saved"
msgstr "Настройката е запазена"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/mod.rs:242
msgid "Sign in or paste a pre-auth key first."
msgstr "Първо влезте или поставете предварителен ключ."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/content.rs:62
msgid "Sign in to connect"
msgstr "Влезте, за да се свържете"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglace/src/window/content.rs:63
msgid "Use the panel on the left to sign in or paste a pre-auth key."
