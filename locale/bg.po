msgstr "Свързан · {n} peer-а"

#, rust-format
msgid "In the room {group} · muted"
msgstr "В стая {group} · заглушен"

#, rust-format
msgid "In the room {group}"
msgstr "В стая {group}"

msgid "Show BigLace"
msgstr "Покажи BigLace"

msgid "Unmute (Ctrl+Alt+M)"
msgstr "Включване на звука (Ctrl+Alt+M)"

msgid "Mute (Ctrl+Alt+M)"
msgstr "Заглушаване (Ctrl+Alt+M)"

