#: src/window.rs
msgid "Disconnect"
msgstr "Prekini vezu"

#: src/window.rs
msgid "Refresh list"
msgstr "Osvježi popis"

#: src/window.rs
msgid "Main menu"
msgstr "Glavni izbornik"

#: src/window.rs
msgid "Sign in with panel account"
msgstr "Prijavi se s računom panela"

#: src/window.rs
msgid "Make this user the tailscale operator"
msgstr "Postavi ovog korisnika kao tailscale operatera"

#: src/window.rs
msgid "About BigLace"
msgstr "O BigLaceu"

#: src/window.rs
msgid "Tailscale operator"
msgstr "Tailscale operater"

#: src/window.rs
msgid "Done. You will no longer need a password to connect or disconnect."
msgstr ""
"Gotovo. Više vam neće trebati lozinka za spajanje ili prekidanje veze."

#: src/window.rs
msgid "Failed: {error}"
msgstr "Neuspješno: {error}"

#: src/window.rs
msgid "OK"
msgstr "U redu"

#: src/window.rs
msgid "Error: {error}"
msgstr "Greška: {error}"

#: src/window.rs
msgid "Files"
msgstr "Datoteke"

#: src/window.rs
msgid "Terminal"
msgstr "Terminal"

#: src/window.rs
msgid "Copied!"
msgstr "Kopirano!"

#: src/window.rs
msgid "Mesh VPN client for BigScale/Headscale."
msgstr "Mesh VPN klijent za BigScale/Headscale."

#: src/window.rs
msgid "Panel credentials"
msgstr "Podaci za prijavu na panel"

#: src/window.rs
msgid ""
"Use your BigScale panel username and password to generate a key "
"automatically."
msgstr ""
"Koristite korisničko ime i lozinku s BigScale panela za automatsko "
"generiranje ključa."

#: src/window.rs
msgid "Panel URL"
msgstr "URL panela"

#: src/window.rs
msgid "Username"
msgstr "Korisničko ime"

#: src/window.rs
msgid "Password"
msgstr "Lozinka"

#: src/window.rs
msgid "Network user identifier"
msgstr "Identifikator mrežnog korisnika"

#: src/window.rs
msgid "Cancel"
msgstr "Odustani"

#: src/window.rs
msgid "Sign in"
msgstr "Prijava"

#: src/window.rs
msgid "Fill in URL, username and password."
msgstr "Ispunite URL, korisničko ime i lozinku."

#: src/window.rs
msgid "Key generated successfully."
msgstr "Ključ je uspješno generiran."

#: src/window.rs
msgid "Service not found"
msgstr "Usluga nije pronađena"

#: src/window.rs
msgid ""
"The tailscaled service is not running.\n"
"Click below to start it."
msgstr ""
"Usluga tailscaled nije pokrenuta.\n"
"Kliknite ispod za pokretanje."

#: src/window.rs
msgid "Start service"
msgstr "Pokreni uslugu"

#: src/window.rs
msgid "Server"
msgstr "Poslužitelj"

#: src/window.rs
msgid "Address of your BigScale/Headscale server."
msgstr "Adresa vašeg BigScale/Headscale poslužitelja."

#: src/window.rs
msgid "Server URL"
msgstr "URL poslužitelja"

#: src/window.rs
msgid "Your identity on the network"
msgstr "Vaš identitet na mreži"

#: src/window.rs
msgid ""
"Personal key generated for you in the BigScale panel (\"New key\" in Users)."
" Each person uses their own — this is not the server's key."
msgstr ""
"Osobni ključ generiran za vas u BigScale panelu (\"Novi ključ\" u "
"korisnicima). Svaka osoba koristi svoj vlastiti — ovo nije ključ "
"poslužitelja."

#: src/window.rs
msgid "Pre-auth key (yours)"
msgstr "Ključ za pred-autentifikaciju (vaš)"

#: src/window.rs
msgid "This device"
msgstr "Ovaj uređaj"

#: src/window.rs
msgid "Name shown to other devices on the network."
msgstr "Naziv prikazan drugim uređajima na mreži."

#: src/window.rs
msgid "Device name"
msgstr "Naziv uređaja"

#: src/window.rs
msgid "Options"
msgstr "Opcije"

#: src/window.rs
msgid "Connect automatically on startup"
msgstr "Automatski se poveži pri pokretanju"

#: src/window.rs
msgid "Connect"
msgstr "Poveži se"

#: src/window.rs
msgid "Please wait..."
msgstr "Pričekajte..."

#: src/window.rs
msgid "Connected to the network"
msgstr "Povezano s mrežom"

#: src/window.rs
msgid "Your IP address"
msgstr "Vaša IP adresa"

#: src/window.rs
msgid "Devices on the network"
msgstr "Uređaji na mreži"

#: src/window.rs
msgid "No other devices found."
msgstr "Nisu pronađeni drugi uređaji."

#: src/window.rs
msgid "Copy"
msgstr "Kopiraj"

#: src/tailscale.rs
msgid "Failed to run tailscale"
msgstr "Neuspjelo pokretanje tailscale"

#: src/tailscale.rs
msgid "Failed to connect — check the server URL and key."
msgstr "Neuspjelo povezivanje — provjerite URL poslužitelja i ključ."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale"
msgstr "Neuspjelo pokretanje pkexec tailscale"

#: src/tailscale.rs
msgid "Could not determine the current user."
msgstr "Nije moguće odrediti trenutnog korisnika."

#: src/tailscale.rs
msgid "Failed to run pkexec tailscale set"
msgstr "Neuspjelo pokretanje pkexec tailscale set"

#: src/tailscale.rs
msgid "Failed to set tailscale operator."
msgstr "Neuspjelo postavljanje tailscale operatora."

msgid "The pre-auth key was rejected by the server. Generate a new key in the BigScale panel and try again."
msgstr "Poslužitelj je odbio pred-autorizacijski ključ. Generirajte novi ključ u BigScale panelu i pokušajte ponovo."

msgid "Login rejected by server: {detail}"
msgstr "Poslužitelj je odbio prijavu: {detail}"
