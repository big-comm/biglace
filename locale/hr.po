msgid "Invalid device address."
msgstr "Nevažeća adresa uređaja."

msgid ""
"No file manager could open the SFTP location. Install one (Dolphin, "
"Nautilus, Nemo, Thunar…) and try again."
msgstr ""
"Nijedan upravitelj datoteka nije mogao otvoriti SFTP lokaciju. Instalirajte "
"jedan (Dolphin, Nautilus, Nemo, Thunar…) i pokušajte ponovno."

msgid ""
"No file manager could open the SFTP location. Install WinSCP and try again."
msgstr ""
"Nijedan upravitelj datoteka nije mogao otvoriti SFTP lokaciju. Instalirajte "
"WinSCP i pokušajte ponovno."

msgid ""
"No terminal emulator found. Install one (Konsole, GNOME Terminal, xterm…) "
"and try again."
msgstr ""
"Nije pronađen emulator terminala. Instalirajte jedan (Konsole, GNOME "
"Terminal, xterm…) i pokušajte ponovno."

msgid "Failed to run tailscale"
msgstr "Neuspjelo pokretanje tailscale"

msgid "Failed to connect — check the server URL and key."
msgstr "Neuspjelo povezivanje — provjerite URL poslužitelja i ključ."

msgid "Failed to run pkexec tailscale"
msgstr "Neuspjelo pokretanje pkexec tailscale"

msgid "Enter the server URL before connecting."
msgstr "Unesite URL poslužitelja prije povezivanja."

msgid ""
"The pre-auth key was rejected by the server. Generate a new key in the "
"BigScale panel and try again."
msgstr ""
"Poslužitelj je odbio pred-autorizacijski ključ. Generirajte novi ključ u "
"BigScale panelu i pokušajte ponovo."

msgid "Sign in or paste a pre-auth key first."
msgstr "Prvo se prijavite ili zalijepite pre-auth ključ."

#, rust-format
msgid "Login rejected by server: {detail}"
msgstr "Poslužitelj je odbio prijavu: {detail}"

msgid "Could not determine the current user."
msgstr "Nije moguće odrediti trenutnog korisnika."

msgid "Failed to run pkexec tailscale set"
msgstr "Neuspjelo pokretanje pkexec tailscale set"

msgid "Failed to set tailscale operator."
msgstr "Neuspjelo postavljanje tailscale operatora."

msgid "Invite someone"
msgstr "Pozovi nekoga"

msgid "Open admin panel"
msgstr "Otvori administratorsku ploču"

msgid "Devices"
msgstr "Uređaji"

msgid "Chat"
msgstr "Chat"

msgid "Invites"
msgstr "Pozivnice"

msgid "Groups"
msgstr "Grupe"

msgid "Rooms"
msgstr "Sobe"

msgid "Pictures"
msgstr "Slike"

msgid "Choose your photo"
msgstr "Odaberite svoju fotografiju"

msgid "Photo updated. Everyone you're connected to will see it."
msgstr "Fotografija ažurirana. Vidjet će je svi s kojima ste povezani."

#, rust-format
msgid "Could not change the photo: {error}"
msgstr "Promjena fotografije nije uspjela: {error}"

msgid "Sign in with an access key"
msgstr "Prijava pristupnim ključem"

msgid ""
"Paste the key the administrator gave you. It's used once, to register this "
"device."
msgstr ""
"Zalijepite ključ koji vam je dao administrator. Koristi se jednom, za "
"registraciju ovog uređaja."

msgid "Server URL"
msgstr "URL poslužitelja"

msgid "Access key"
msgstr "Pristupni ključ"

msgid "Device name on the network"
msgstr "Naziv uređaja na mreži"

msgid "Cancel"
msgstr "Odustani"

msgid "Connect"
msgstr "Poveži se"

msgid ""
"The key to this account is no longer on this computer. Join with a new "
"invite."
msgstr ""
"Ključ ovog računa više nije na ovom računalu. Pridružite se novom pozivnicom."

#, rust-format
msgid "Welcome back, {name}! Connecting…"
msgstr "Dobro došli natrag, {name}! Povezivanje…"

#, rust-format
msgid "Error: {error}"
msgstr "Greška: {error}"

#, rust-format
msgid ""
"The account {user} no longer exists on this network. Join with a new invite."
msgstr ""
"Račun {user} više ne postoji na ovoj mreži. Pridružite se novom pozivnicom."

msgid "Preferences"
msgstr "Postavke"

msgid "General"
msgstr "Općenito"

msgid "Behaviour"
msgstr "Ponašanje"

msgid "System"
msgstr "Sustav"

msgid "Make this user the tailscale operator"
msgstr "Postavi ovog korisnika kao tailscale operatera"

msgid ""
"Lets BigLace manage the connection without asking for a password each time"
msgstr "Omogućuje BigLaceu upravljanje vezom bez traženja lozinke svaki put"

msgid "Account"
msgstr "Račun"

msgid ""
"Signing out removes this device's identity from BigLace. You will need a new "
"invite or key to join again."
msgstr ""
"Odjava uklanja identitet ovog uređaja iz BigLacea. Za ponovno pridruživanje "
"trebat će vam nova pozivnica ili ključ."

msgid "Sign out"
msgstr "Odjavi se"

msgid "Connect a phone"
msgstr "Poveži telefon"

msgid "Invites you sent"
msgstr "Pozivnice koje ste poslali"

msgid "Change profile photo…"
msgstr "Promijeni profilnu fotografiju…"

msgid "Join with an invite"
msgstr "Pridruživanje pozivnicom"

msgid "Sign in with panel account"
msgstr "Prijavi se s računom panela"

msgid "Leave the network…"
msgstr "Napusti mrežu…"

msgid "View tailscaled logs"
msgstr "Pregledaj tailscaled zapise"

msgid "About BigLace"
msgstr "O BigLaceu"

msgid "Connect to the network first, then open the invite link again."
msgstr ""
"Najprije se povežite s mrežom, a zatim ponovno otvorite poveznicu za "
"pozivnicu."

#, rust-format
msgid "This invite is for another network ({host}). Sign out first to join it."
msgstr ""
"Ova je pozivnica za drugu mrežu ({host}). Najprije se odjavite da biste joj "
"se pridružili."

msgid ""
"This device is already signed in. Sign out first to join with an invite."
msgstr ""
"Ovaj je uređaj već prijavljen. Najprije se odjavite da biste se pridružili "
"pozivnicom."

msgid "Photo removed."
msgstr "Fotografija uklonjena."

#, rust-format
msgid "Could not remove the photo: {error}"
msgstr "Uklanjanje fotografije nije uspjelo: {error}"

#, rust-format
msgid "Could not open the browser: {error}"
msgstr "Otvaranje preglednika nije uspjelo: {error}"

msgid ""
"You can't open the admin panel: you're not an administrator of this network, "
"or the panel can't be reached."
msgstr ""
"Ne možete otvoriti administratorsku ploču: niste administrator ove mreže ili "
"ploča nije dostupna."

msgid "Enter the server URL before saving."
msgstr "Unesite URL poslužitelja prije spremanja."

msgid "Enter the pre-auth key before saving."
msgstr "Unesite ključ za prethodnu autentifikaciju prije spremanja."

msgid "Setup saved"
msgstr "Postavljanje spremljeno"

msgid "Could not start the Tailscale service."
msgstr "Pokretanje usluge Tailscale nije uspjelo."

msgid "IP address copied"
msgstr "IP adresa kopirana"

#, rust-format
msgid ""
"Saved, but the pre-auth key could not be stored in the system keyring "
"({error}). This device can still reconnect; the key is only needed again to "
"register it anew."
msgstr ""
"Spremljeno, ali ključ za predautentifikaciju nije moguće pohraniti u "
"privjesak ključeva sustava ({error}). Ovaj se uređaj i dalje može ponovno "
"povezati; ključ je potreban samo za ponovnu registraciju."

msgid "Connected"
msgstr "Povezano"

msgid "Service stopped"
msgstr "Usluga zaustavljena"

msgid "Not signed in"
msgstr "Niste prijavljeni"

msgid "Disconnected"
msgstr "Prekinuta veza"

msgid "Connecting…"
msgstr "Povezivanje…"

msgid "Server unreachable"
msgstr "Poslužitelj nedostupan"

msgid "Tailscale can't set DNS"
msgstr "Tailscale ne može postaviti DNS"

#, rust-format
msgid "Update available: v{version}"
msgstr "Dostupno ažuriranje: v{version}"

#, rust-format
msgid "Sign in again as {user}"
msgstr "Ponovno se prijavite kao {user}"

msgid "(no device name)"
msgstr "(bez naziva uređaja)"

msgid "Sign in or paste a pre-auth key"
msgstr "Prijavi se ili zalijepi pre-auth ključ"

msgid "Server not set"
msgstr "Poslužitelj nije postavljen"

msgid "Disconnect"
msgstr "Prekini vezu"

msgid "no other devices"
msgstr "nema drugih uređaja"

#, rust-format
msgid "{online} online"
msgstr "{online} na mreži"

#, rust-format
msgid "{online} online · {offline} offline"
msgstr "{online} na mreži · {offline} izvan mreže"

msgid "is online"
msgstr "je online"

msgid "went offline"
msgstr "je offline"

#, rust-format
msgid "{count} devices are online"
msgstr "{count} uređaja je online"

#, rust-format
msgid "{count} devices went offline"
msgstr "{count} uređaja je offline"

#, rust-format
msgid "{on_count} online · {off_count} offline"
msgstr "{on_count} online · {off_count} offline"

msgid ""
"On the phone, open BigLace and tap “Scan QR code”, then point it at this "
"code. The phone joins as one of your devices."
msgstr ""
"Na telefonu otvorite BigLace i dodirnite „Skeniraj QR kod”, zatim ga "
"usmjerite prema ovom kodu. Telefon se pridružuje kao jedan od vaših uređaja."

msgid "Asking the panel for a code…"
msgstr "Traženje koda od panela…"

msgid "New code"
msgstr "Novi kod"

msgid "This code is no longer valid."
msgstr "Ovaj kod više nije valjan."

#, rust-format
msgid "Valid for {time} · works once"
msgstr "Vrijedi {time} · radi jednom"

msgid ""
"This network's server doesn't pair phones yet. Ask your administrator to "
"update the panel, or invite the phone instead."
msgstr ""
"Poslužitelj ove mreže još ne može uparivati telefone. Zamolite "
"administratora da ažurira panel ili umjesto toga pozovite telefon."

msgid ""
"Invites from BigLace need a BigScale server that supports them. Ask your "
"administrator to update the server, or to create the invite in the panel."
msgstr ""
"Pozivnice iz BigLacea zahtijevaju BigScale poslužitelj koji ih podržava. "
"Zamolite administratora da ažurira poslužitelj ili da stvori pozivnicu na "
"ploči."

msgid "This device can't send invites (it isn't linked to a person's account)."
msgstr "Ovaj uređaj ne može slati pozivnice (nije povezan s računom osobe)."

msgid ""
"The panel knows this device by a different key (BigLace was reinstalled?). "
"Leave the network and join again to fix it."
msgstr ""
"Ploča poznaje ovaj uređaj po drugom ključu (je li BigLace ponovno "
"instaliran?). Napustite mrežu i ponovno se pridružite da biste to popravili."

msgid ""
"The panel couldn't confirm this device. Make sure BigLace is up to date and "
"stays open while connected, then try again."
msgstr ""
"Ploča nije mogla potvrditi ovaj uređaj. Provjerite je li BigLace ažuran i "
"ostaje li otvoren dok ste povezani, zatim pokušajte ponovno."

msgid "You are no longer in that group."
msgstr "Više niste u toj grupi."

msgid ""
"On this network everyone can reach everyone, so only the administrator can "
"invite people."
msgstr ""
"Na ovoj mreži svatko dopire do svakoga, pa samo administrator može pozivati "
"osobe."

msgid "You have too many pending invites. Cancel some or try again tomorrow."
msgstr ""
"Imate previše pozivnica na čekanju. Otkažite neke ili pokušajte ponovno "
"sutra."

msgid ""
"On this network only administrators invite new people. You can still invite "
"people already on the network into your groups."
msgstr ""
"Na ovoj mreži samo administratori pozivaju nove osobe. I dalje možete "
"pozivati osobe koje su već na mreži u svoje grupe."

#, rust-format
msgid "Could not reach the panel: {error}"
msgstr "Ploča nije dostupna: {error}"

msgid "Waiting to be used"
msgstr "Čeka na korištenje"

msgid "Used"
msgstr "Iskorišteno"

msgid "Expired"
msgstr "Isteklo"

msgid "Cancelled"
msgstr "Otkazano"

msgid "Waiting for an administrator's approval"
msgstr "Čeka odobrenje administratora"

msgid "Refresh"
msgstr "Osvježi"

msgid "Main menu"
msgstr "Glavni izbornik"

msgid "Bring someone to your network"
msgstr "Dovedite nekoga u svoju mrežu"

msgid ""
"Create a link or QR code and send it to the person. When they join, you two "
"can reach each other's devices — no administrator needed. The link works "
"once and stays valid until it's used or you cancel it."
msgstr ""
"Stvorite poveznicu ili QR kôd i pošaljite ga osobi. Kad se pridruži, vas "
"dvoje dopirete do međusobnih uređaja — administrator nije potreban. "
"Poveznica radi jednom i vrijedi dok se ne iskoristi ili je ne otkažete."

msgid "No invites yet"
msgstr "Još nema pozivnica"

msgid "Invites unavailable"
msgstr "Pozivnice nisu dostupne"

#, rust-format
msgid "{user} joined"
msgstr "{user} se pridružio/la"

msgid "Invite"
msgstr "Pozovi"

#, rust-format
msgid "group {group}"
msgstr "grupa {group}"

msgid "Cancel this invite: the link stops working"
msgstr "Otkaži ovu pozivnicu: poveznica prestaje raditi"

msgid "The person you invite will reach your devices, and you theirs."
msgstr "Osoba koju pozovete dopirat će do vaših uređaja, a vi do njezinih."

msgid "Who is it for? (optional)"
msgstr "Za koga je? (neobavezno)"

msgid "Access"
msgstr "Pristup"

msgid "Just the two of us"
msgstr "Samo nas dvoje"

msgid "You see each other's devices, nobody else"
msgstr "Vidite međusobne uređaje, nikoga drugog"

#, rust-format
msgid "Also the group {group}"
msgstr "Također grupa {group}"

msgid "They join the group and see everyone in it"
msgstr "Pridružuje se grupi i vidi sve u njoj"

msgid "A network of their own"
msgstr "Vlastita mreža"

msgid ""
"No link to you: they see only their own devices and whoever they invite "
"(you're the administrator)"
msgstr ""
"Bez veze s vama: vidi samo svoje uređaje i one koje pozove (vi ste "
"administrator)"

msgid "Create invite"
msgstr "Stvori pozivnicu"

msgid "QR code of the invite link"
msgstr "QR kôd poveznice za pozivnicu"

msgid ""
"Send the link or let the person scan the code with their phone. It works "
"once and stays valid until used or cancelled."
msgstr ""
"Pošaljite poveznicu ili neka osoba skenira kôd telefonom. Radi jednom i "
"vrijedi dok se ne iskoristi ili otkaže."

msgid "Copy link"
msgstr "Kopiraj poveznicu"

msgid "Done"
msgstr "Gotovo"

msgid "Copied!"
msgstr "Kopirano!"

msgid ""
"This network asks an administrator to approve each invite: the link starts "
"working once they do. Its status shows in Invites."
msgstr ""
"Ova mreža traži da administrator odobri svaku pozivnicu: poveznica počinje "
"raditi kad je odobri. Njezin status vidi se u Pozivnicama."

msgid "Show the full sidebar"
msgstr "Prikaži cijelu bočnu traku"

msgid "Show only icons in the sidebar"
msgstr "Samo ikone u bočnoj traci"

msgid "Sections"
msgstr "Odjeljci"

msgid ""
"Your identity on this mesh — the device name shown to other peers and the "
"network you're connected to."
msgstr ""
"Vaš identitet na ovoj mreži — naziv uređaja koji se prikazuje drugim "
"korisnicima i mreža na koju ste povezani."

msgid "Change photo…"
msgstr "Promijeni fotografiju…"

msgid "Remove photo"
msgstr "Ukloni fotografiju"

msgid "Change your photo"
msgstr "Promijenite svoju fotografiju"

msgid "Rename this device on the network"
msgstr "Preimenuj ovaj uređaj na mreži"

msgid "Advanced: use a pre-auth key"
msgstr "Napredno: upotrijebite unaprijed ovjereni ključ"

msgid "Already have a key from your administrator? Paste it here."
msgstr "Već imate ključ od administratora? Zalijepite ga ovdje."

msgid ""
"Manual setup — expand to paste a server URL and pre-auth key when you "
"already received them from your administrator. Most users should sign in "
"through the panel button above instead."
msgstr ""
"Ručno postavljanje — proširite da biste zalijepili URL poslužitelja i pred-"
"autentifikacijski ključ ako ste ih već primili od administratora. Većina "
"korisnika trebala bi se prijaviti putem gumba na ploči iznad."

msgid ""
"Address of the coordination server (e.g. vpn.example.org). The https:// "
"scheme is added automatically if you omit it."
msgstr ""
"Adresa koordinacijskog poslužitelja (npr. vpn.example.org). Shema https:// "
"dodaje se automatski ako je izostavite."

msgid "Pre-auth key"
msgstr "Pre-auth ključ"

msgid ""
"One-time or reusable key created on the server (starts with 'hskey-auth-'). "
"Used to register this device automatically without opening a browser."
msgstr ""
"Jednokratni ili višekratni ključ kreiran na poslužitelju (počinje s 'hskey-"
"auth-'). Koristi se za automatsku registraciju ovog uređaja bez otvaranja "
"preglednika."

msgid ""
"The name this device shows to other peers on the VPN — this is the Tailscale "
"hostname, NOT your computer's name and NOT your user. Lowercase letters, "
"digits and hyphens. Example: 'tales-laptop', 'francois', 'office-pc'."
msgstr ""
"Naziv pod kojim se ovaj uređaj prikazuje drugim korisnicima na VPN-u — ovo "
"je Tailscale hostname, a NE naziv vašeg računala i NE vaše korisničko ime. "
"Mala slova, znamenke i crtice. Primjer: 'tales-laptop', 'francois', 'office-"
"pc'."

msgid "Apply manual setup"
msgstr "Primijeni ručno postavljanje"

msgid "Save"
msgstr "Spremi"

msgid ""
"Persist the server, key and device name above. Won't connect — press Connect "
"afterwards."
msgstr ""
"Trajno spremi gornji poslužitelj, ključ i naziv uređaja. Neće se povezati — "
"nakon toga pritisnite Poveži se."

msgid "Connect automatically"
msgstr "Automatski se poveži"

msgid "Join the network when BigLace starts"
msgstr "Pridruži se mreži kada BigLace pokrene"

msgid ""
"When on, BigLace runs 'tailscale up' as soon as it launches, so you join the "
"mesh without clicking Connect every time."
msgstr ""
"Kada je uključeno, BigLace pokreće 'tailscale up' čim se pokrene, tako da se "
"pridružujete mreži bez klikanja na Poveži se svaki put."

msgid "Toggle auto-connect on startup"
msgstr "Uključi/isključi automatsko povezivanje pri pokretanju"

msgid "Start BigLace with the session"
msgstr "Pokreni BigLace sa sesijom"

msgid "Open BigLace after you sign in to the desktop"
msgstr "Otvori BigLace nakon prijave na radnu površinu"

msgid ""
"Turn this on to add BigLace to your desktop session startup. Turn it off to "
"remove it."
msgstr ""
"Uključite ovo da biste dodali BigLace u pokretanje sesije radne površine. "
"Isključite ga da biste ga uklonili."

msgid "Toggle start with session"
msgstr "Uključi/isključi pokretanje sa sesijom"

msgid "Reconnect on drop"
msgstr "Ponovno povezivanje pri prekidu"

msgid "Retry with backoff when the connection is lost"
msgstr "Ponovni pokušaj s odgodom kada se veza izgubi"

msgid ""
"If the tunnel drops (network change, sleep, server hiccup), BigLace silently "
"retries with growing delays instead of leaving you offline until you notice."
msgstr ""
"Ako tunel padne (promjena mreže, stanje mirovanja, problem s poslužiteljem), "
"BigLace tiho ponavlja pokušaj s rastućim odgodama umjesto da vas ostavi "
"izvan mreže dok ne primijetite."

msgid "Toggle auto-reconnect"
msgstr "Uključi/isključi automatsko ponovno povezivanje"

msgid "Notify on peer changes"
msgstr "Obavijesti o promjenama peerova"

msgid "Show a desktop notification when peers go online/offline"
msgstr ""
"Prikaži obavijest na radnoj površini kada peerovi postanu online/offline"

msgid ""
"Send a desktop toast when another device on your network goes online or "
"offline. Rapid bursts are coalesced into a single notification so you don't "
"get spammed during reconnects."
msgstr ""
"Pošalji obavijest na radnoj površini kada drugi uređaj na vašoj mreži "
"postane online ili offline. Brza ponavljanja se spajaju u jednu obavijest "
"kako ne biste bili zatrpani tijekom ponovnih povezivanja."

msgid "Toggle peer-change notifications"
msgstr "Uključi/isključi obavijesti o promjenama korisnika"

msgid ""
"Join or leave the mesh network. When connected, this device becomes "
"reachable by the other peers in your account."
msgstr ""
"Pridružite se ili napustite mesh mrežu. Kada ste povezani, ovaj uređaj "
"postaje dostupan ostalim peerovima na vašem računu."

msgid "Your photo"
msgstr "Vaša fotografija"

msgid "New chat"
msgstr "Novi chat"

msgid "Start a conversation with someone on the network"
msgstr "Započnite razgovor s nekim na mreži"

msgid "Chat theme"
msgstr "Tema chata"

msgid "Conversations"
msgstr "Razgovori"

msgid "No conversations yet."
msgstr "Još nema razgovora."

msgid "Search in this conversation (Ctrl+F)"
msgstr "Pretraži ovaj razgovor (Ctrl+F)"

msgid "Pinned message"
msgstr "Prikvačena poruka"

msgid "Unpin"
msgstr "Otkvači"

msgid "Search messages"
msgstr "Pretraži poruke"

msgid "Older"
msgstr "Starije"

msgid "Newer"
msgstr "Novije"

msgid "Emoji"
msgstr "Emoji"

msgid "Send files, pictures or videos"
msgstr "Pošalji datoteke, slike ili videozapise"

msgid "Send (Enter) — Shift+Enter for a new line"
msgstr "Pošalji (Enter) — Shift+Enter za novi redak"

msgid "Record a voice message"
msgstr "Snimi glasovnu poruku"

msgid "Discard"
msgstr "Odbaci"

msgid "Send voice message"
msgstr "Pošalji glasovnu poruku"

msgid "Copy text"
msgstr "Kopiraj tekst"

msgid "Forward"
msgstr "Proslijedi"

msgid "Delete"
msgstr "Izbriši"

msgid "Talk with your network"
msgstr "Razgovarajte sa svojom mrežom"

msgid ""
"Pick a conversation, or start one. Messages go straight between your "
"computers — the server never sees them."
msgstr ""
"Odaberite razgovor ili započnite novi. Poruke idu izravno između vaših "
"računala — poslužitelj ih nikad ne vidi."

msgid "People on the network"
msgstr "Osobe na mreži"

msgid "Group"
msgstr "Grupa"

msgid "Direct conversation"
msgstr "Izravni razgovor"

msgid "That message is too long."
msgstr "Ta je poruka predugačka."

#, rust-format
msgid "Could not send: {error}"
msgstr "Slanje nije uspjelo: {error}"

#, rust-format
msgid "Could not download: {error}"
msgstr "Preuzimanje nije uspjelo: {error}"

#, rust-format
msgid "{user} in {group}"
msgstr "{user} u {group}"

msgid "Send files"
msgstr "Pošalji datoteke"

msgid "Drop to send"
msgstr "Ispustite za slanje"

#, rust-format
msgid "Could not record: {error}"
msgstr "Snimanje nije uspjelo: {error}"

msgid "Too short — record for at least a second."
msgstr "Prekratko — snimajte barem jednu sekundu."

msgid "Search people and groups"
msgstr "Pretraži osobe i grupe"

msgid "Loading…"
msgstr "Učitavanje…"

