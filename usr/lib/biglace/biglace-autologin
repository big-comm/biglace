#!/bin/bash
# biglace-autologin — sign in automatically ONCE, so "Restart and reconnect"
# can bring a remote computer back to its desktop (BigLace then locks the
# screen right away and the remote session resumes).
#
#   pkexec biglace-autologin arm [session-hint]   (only for the calling user)
#   pkexec biglace-autologin relogin [session]    (sign out and back in)
#   biglace-autologin disarm                      (undo; also via pkexec)
#   biglace-autologin expire                      (boot: lock + undo)
#
# Never permanent: the next boot's biglace-autologin-expire.service locks the
# sessions and undoes it, whether or not BigLace starts.

set -euo pipefail
umask 077

STATE_DIR=/var/lib/biglace
STATE=$STATE_DIR/autologin.state
SDDM_CONF=/etc/sddm.conf.d/zz-biglace-autologin.conf
LIGHTDM_CONF=/etc/lightdm/lightdm.conf.d/zz-biglace-autologin.conf
GDM_CONF=/etc/gdm/custom.conf
GDM_BACKUP=$STATE_DIR/gdm-custom.conf.orig

die() {
    echo "biglace-autologin: $*" >&2
    exit 1
}

# Give up after the state was written: undo first, leave nothing behind.
fail() {
    disarm
    die "$@"
}

[[ $EUID -eq 0 ]] || die "must run as root"

display_manager() {
    basename "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)" .service
}

session_ok() {
    [[ $1 =~ ^[A-Za-z0-9._+-]{1,64}$ ]] &&
        { [[ -f /usr/share/xsessions/$1.desktop ]] || [[ -f /usr/share/wayland-sessions/$1.desktop ]]; }
}

# The session the user last chose at the login screen, else the hint.
pick_session() {
    local user=$1 hint=$2 s=""
    case $(display_manager) in
        sddm)
            s=$(sed -n 's#^Session=.*/\([^/]*\)\.desktop$#\1#p' /var/lib/sddm/state.conf 2>/dev/null | tail -n1)
            ;;
        lightdm*)
            s=$(sed -n 's/^XSession=//p' "/var/lib/AccountsService/users/$user" 2>/dev/null | head -n1)
            if [[ -z $s ]]; then
                local home
                home=$(getent passwd "$user" | cut -d: -f6)
                s=$(sed -n 's/^Session=//p' "$home/.dmrc" 2>/dev/null | head -n1)
            fi
            ;;
    esac
    session_ok "$s" || s=$hint
    session_ok "$s" || s=""
    printf '%s' "$s"
}

state_get() {
    sed -n "s/^$1=//p" "$STATE" 2>/dev/null | head -n1
}

disarm() {
    [[ -f $STATE ]] || return 0
    local user added gdm_absent
    user=$(state_get user)
    added=$(state_get added_group)
    gdm_absent=$(state_get gdm_absent)
    rm -f "$SDDM_CONF" "$LIGHTDM_CONF"
    if [[ -f $GDM_BACKUP ]]; then
        cp -p "$GDM_BACKUP" "$GDM_CONF"
        rm -f "$GDM_BACKUP"
    elif [[ $gdm_absent == yes ]]; then
        rm -f "$GDM_CONF"
    fi
    if [[ $added == yes && -n $user ]]; then
        gpasswd -d "$user" autologin >/dev/null 2>&1 || true
    fi
    rm -f "$STATE"
}

arm() {
    local uid=${PKEXEC_UID:-}
    if ! [[ $uid =~ ^[0-9]+$ ]] || ((uid < 1000)); then
        die "unknown caller"
    fi
    local user
    user=$(getent passwd "$uid" | cut -d: -f1)
    [[ -n $user ]] || die "unknown user"
    disarm
    local dm session
    dm=$(display_manager)
    session=$(pick_session "$user" "${1:-}")
    mkdir -p "$STATE_DIR"
    chmod 0700 "$STATE_DIR"
    # State first: whatever happens next, "disarm" knows what to undo.
    printf 'dm=%s\nuser=%s\narmed=%s\n' "$dm" "$user" "$(date +%s)" >"$STATE"
    case $dm in
        sddm)
            [[ -n $session ]] || fail "no desktop session found"
            mkdir -p /etc/sddm.conf.d
            printf '[Autologin]\nUser=%s\nSession=%s.desktop\nRelogin=false\n' "$user" "$session" >"$SDDM_CONF"
            chmod 0644 "$SDDM_CONF"
            ;;
        gdm | gdm3)
            if [[ -f $GDM_CONF ]]; then
                cp -p "$GDM_CONF" "$GDM_BACKUP"
            else
                echo "gdm_absent=yes" >>"$STATE"
                mkdir -p /etc/gdm
                printf '[daemon]\n' >"$GDM_CONF"
            fi
            local tmp
            tmp=$(mktemp)
            awk -v user="$user" '
                /^[[:space:]]*AutomaticLogin(Enable)?[[:space:]]*=/ { next }
                { print }
                /^\[daemon\][[:space:]]*$/ && !done { print "AutomaticLoginEnable=True"; print "AutomaticLogin=" user; done = 1 }
                END { if (!done) { print "[daemon]"; print "AutomaticLoginEnable=True"; print "AutomaticLogin=" user } }
            ' "$GDM_CONF" >"$tmp"
            install -m 0644 "$tmp" "$GDM_CONF"
            rm -f "$tmp"
            ;;
        lightdm*)
            [[ -n $session ]] || fail "no desktop session found"
            mkdir -p /etc/lightdm/lightdm.conf.d
            printf '[Seat:*]\nautologin-user=%s\nautologin-session=%s\n' "$user" "$session" >"$LIGHTDM_CONF"
            chmod 0644 "$LIGHTDM_CONF"
            # LightDM signs in without a password only for this group.
            getent group autologin >/dev/null || groupadd -r autologin
            if ! id -nG "$user" | tr ' ' '\n' | grep -qx autologin; then
                gpasswd -a "$user" autologin >/dev/null
                echo "added_group=yes" >>"$STATE"
            fi
            ;;
        *)
            fail "unsupported login screen: ${dm:-none}"
            ;;
    esac
}

# Boot: once the automatic sign-in happened (or didn't), lock what was
# opened and undo the setting.
expire() {
    [[ -f $STATE ]] || return 0
    local user _
    user=$(state_get user)
    for _ in $(seq 1 60); do
        if loginctl list-sessions --no-legend 2>/dev/null | awk '{print $3}' | grep -qx "$user"; then
            break
        fi
        sleep 2
    done
    lock_and_disarm "$user"
}

# Graphical sessions (ids) of a user.
graphical_sessions() {
    local id
    for id in $(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$1" '$3 == u {print $1}'); do
        case $(loginctl show-session "$id" -p Type --value 2>/dev/null) in
            x11 | wayland) printf '%s ' "$id" ;;
        esac
    done
}

# Sign out and back in, without restarting: arm the automatic sign-in and
# restart the login screen from a service of its own (this session, and
# whoever asked, are about to go away).
relogin() {
    local uid=${PKEXEC_UID:-} user other
    if ! [[ $uid =~ ^[0-9]+$ ]] || ((uid < 1000)); then
        die "unknown caller"
    fi
    user=$(getent passwd "$uid" | cut -d: -f1)
    # Restarting the login screen ends every graphical session: never do
    # it to someone else signed in on this computer.
    for other in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
        [[ $other == "$user" ]] && continue
        if [[ -n $(graphical_sessions "$other") ]]; then
            die "someone else is signed in on this computer"
        fi
    done
    arm "${1:-}"
    systemd-run --quiet --collect --unit="biglace-relogin-$(date +%s)" \
        /usr/lib/biglace/biglace-autologin relogin-run "$(graphical_sessions "$user")" ||
        fail "could not restart the login screen"
}

# (Run by relogin's service.) Restart the login screen, wait for the new
# session, then lock and undo like after a restart.
relogin_run() {
    [[ -z ${PKEXEC_UID:-} ]] || die "not for direct use"
    [[ -f $STATE ]] || return 0
    local user old id _ found=""
    user=$(state_get user)
    old=" $1 "
    sleep 1
    systemctl restart display-manager.service || true
    for _ in $(seq 1 60); do
        for id in $(graphical_sessions "$user"); do
            [[ $old == *" $id "* ]] || found=$id
        done
        [[ -n $found ]] && break
        sleep 2
    done
    lock_and_disarm "$user"
}

# Lock the sessions (GNOME on Wayland: leave it to BigLace, which locks when
# the returning remote session ends) and undo the automatic sign-in.
lock_and_disarm() {
    local user=$1 _
    sleep 8
    # GNOME (Wayland) refuses remote access while locked: there BigLace
    # locks when the returning remote session ends. Leave it to BigLace if
    # it started; lock now if it didn't.
    if gnome_wayland "$user"; then
        for _ in $(seq 1 30); do
            if pgrep -u "$user" -x biglace >/dev/null; then
                disarm
                return 0
            fi
            sleep 2
        done
    fi
    loginctl lock-sessions 2>/dev/null || true
    disarm
}

# The user's graphical session is GNOME on Wayland.
gnome_wayland() {
    local id
    for id in $(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$1" '$3 == u {print $1}'); do
        if [[ $(loginctl show-session "$id" -p Type --value 2>/dev/null) == wayland ]]; then
            pgrep -u "$1" -x gnome-shell >/dev/null && return 0
        fi
    done
    return 1
}

case ${1:-} in
    arm) arm "${2:-}" ;;
    relogin) relogin "${2:-}" ;;
    relogin-run) relogin_run "${2:-}" ;;
    disarm) disarm ;;
    expire)
        [[ -z ${PKEXEC_UID:-} ]] || die "not for direct use"
        expire
        ;;
    *) die "usage: biglace-autologin arm [session] | relogin [session] | disarm | expire" ;;
esac
